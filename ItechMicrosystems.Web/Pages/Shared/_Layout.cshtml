<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ITECH MICROSYSTEMS</title>
    <meta name="description" content="@(ViewData["Description"] ?? "ITECH MICROSYSTEMS (SMC-PRIVATE) LIMITED — custom software solutions and IT services for organizations.")" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-md">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <span class="brand-mark">IM</span>
                    <span class="brand-text">ITECH <strong>MICROSYSTEMS</strong></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="mainNav">
                    <ul class="navbar-nav align-items-md-center">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Services">Services</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/About">About</a></li>
                        <li class="nav-item">
                            <a class="btn btn-cta" asp-page="/Contact">Contact us</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="brand-text footer-brand">ITECH <strong>MICROSYSTEMS</strong></div>
                    <p class="footer-legal">ITECH MICROSYSTEMS (SMC-PRIVATE) LIMITED</p>
                    <p class="footer-tagline">Software solutions and IT services for organizations of every size.</p>
                </div>
                <div>
                    <h6>Company</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/Index">Home</a></li>
                        <li><a asp-page="/Services">Services</a></li>
                        <li><a asp-page="/About">About</a></li>
                        <li><a asp-page="/Contact">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h6>Get in touch</h6>
                    <ul class="footer-links">
                        <li><a href="mailto:info@itechmicrosystems.com">info@itechmicrosystems.com</a></li>
                        <li><a href="tel:+923132472099">0313 2472099</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; @DateTime.Now.Year ITECH MICROSYSTEMS (SMC-PRIVATE) LIMITED. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@page
@model ItechMicrosystems.Web.Pages.AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["Description"] = "ITECH MICROSYSTEMS (SMC-PRIVATE) LIMITED — a software solutions company building custom systems for organizations.";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">About us</span>
        <h1>ITECH MICROSYSTEMS</h1>
        <p class="lead">
            ITECH MICROSYSTEMS (SMC-PRIVATE) LIMITED is a software solutions company. We design, build,
            and support the systems organizations use to run their day-to-day operations.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-lg-6">
                <h2>Our approach</h2>
                <p>
                    Every organization works differently, so we don't start with a fixed template.
                    We take time to understand how your team actually operates, then design software
                    that fits that reality — rather than asking your team to adapt to generic software.
                </p>
                <p>
                    We stay involved after launch too. Software needs change as a business grows, and
                    we treat support and maintenance as part of the job, not a separate add-on.
                </p>
            </div>
            <div class="col-lg-6">
                <h2>What we value</h2>
                <ul class="check-list">
                    <li><strong>Clarity</strong> — clear scope, clear timelines, no surprises</li>
                    <li><strong>Reliability</strong> — systems built to keep working, not just to demo well</li>
                    <li><strong>Partnership</strong> — we work with you through the full lifecycle, not just the build</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="cta-panel cta-panel-centered">
            <h3>Want to work with us?</h3>
            <p>Get in touch and tell us what you're trying to solve.</p>
            <a class="btn btn-cta" asp-page="/Contact">Contact us</a>
        </div>
    </div>
</section>

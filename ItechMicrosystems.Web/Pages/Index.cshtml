@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "ITECH MICROSYSTEMS (SMC-PRIVATE) LIMITED builds custom software, web and mobile applications, and IT support solutions for organizations.";
}

<section class="hero">
    <div class="container">
        <div class="hero-inner">
            <span class="eyebrow">Software solutions for organizations</span>
            <h1>Practical software, built around how your business actually works.</h1>
            <p class="lead">
                ITECH MICROSYSTEMS designs, builds, and supports custom software, web and mobile
                applications, and IT systems — so your organization spends less time fighting tools
                and more time running the business.
            </p>
            <div class="hero-actions">
                <a class="btn btn-cta btn-lg" asp-page="/Contact">Talk to us</a>
                <a class="btn btn-outline btn-lg" asp-page="/Services">See our services</a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">What we do</span>
            <h2>Solutions built for the way organizations actually operate</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon">🛠️</div>
                    <h3>Custom Software Development</h3>
                    <p>Purpose-built systems for your workflows — not generic software you have to work around.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon">🌐</div>
                    <h3>Web &amp; Mobile Applications</h3>
                    <p>Customer-facing and internal apps that work reliably across desktop and mobile.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon">🧩</div>
                    <h3>Systems Integration</h3>
                    <p>Connect the tools you already use so data moves automatically instead of by hand.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-icon">🔧</div>
                    <h3>IT Support &amp; Maintenance</h3>
                    <p>Ongoing support to keep your systems secure, current, and running smoothly.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="eyebrow">Why work with us</span>
                <h2>We build software as a long-term partner, not a one-off vendor</h2>
                <ul class="check-list">
                    <li>Direct communication — no layers between you and the people building your system</li>
                    <li>Solutions scoped to your actual needs, not a fixed template</li>
                    <li>Ongoing support after launch, not a handoff-and-disappear model</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="cta-panel">
                    <h3>Have a project in mind?</h3>
                    <p>Tell us what you're trying to solve — we'll get back to you with next steps.</p>
                    <a class="btn btn-cta" asp-page="/Contact">Get in touch</a>
                </div>
            </div>
        </div>
    </div>
</section>

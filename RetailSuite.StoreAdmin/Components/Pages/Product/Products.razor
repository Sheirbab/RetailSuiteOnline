@page "/products"
@inject HttpClient Http
@inject ToastService Toast
@inject NavigationManager Nav
@inject ApiUrlService Api
@using System.Text.Json

<PermissionGuard Code="PRODUCTS" />

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:8px;">
    <div>
        <h3 style="margin:0;">Products</h3>
        <p style="margin:4px 0 0;color:#6b7280;font-size:13px;">
            Click a row to open its detail page (description, variants, categories, images).
        </p>
    </div>
    <button class="btn btn-primary" @onclick="() => showModal = true">+ Add Product</button>
</div>

<div style="display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap;">
    <input class="input" style="width:280px;" placeholder="Search by name…"
           value="@_search" @oninput="OnSearch" />
    <label style="font-size:12px;color:#6b7280;display:flex;align-items:center;gap:6px;">
        <input type="checkbox" @bind="_activeOnly" /> Active only
    </label>
</div>

@if (isLoading)
{
    <div style="margin-top:20px;"><div class="spinner"></div></div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="card" style="margin-top:20px;color:#b91c1c;">⚠️ @_error</div>
}
else if (products != null && Filtered().Any())
{
    <div class="card">
        <table class="table products-table">
            <thead>
                <tr>
                    <th style="width:60px;"></th>
                    <th>Name</th>
                    <th>Slug</th>
                    <th class="num">Variants</th>
                    <th class="num">Min price</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Filtered())
                {
                    <tr @onclick="() => Open(p.Id)" style="cursor:pointer;">
                        <td>
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@Api.Absolute(p.ImageUrl)" alt="@p.Name"
                                     style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid #e5e7eb;" />
                            }
                            else
                            {
                                <div style="width:40px;height:40px;background:#f3f4f6;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#9ca3af;">📦</div>
                            }
                        </td>
                        <td><strong>@p.Name</strong></td>
                        <td style="font-family:monospace;font-size:12px;color:#6b7280;">@p.Slug</td>
                        <td class="num">@p.Variants.Count</td>
                        <td class="num">
                            @(p.Variants.Any()
                                ? "Rs " + p.Variants.Min(v => v.Price).ToString("N0")
                                : "—")
                        </td>
                        <td>
                            <span class="status-chip @(p.IsActive ? "status-on" : "status-off")">
                                @(p.IsActive ? "Active" : "Hidden")
                            </span>
                        </td>
                        <td style="text-align:right;" @onclick:stopPropagation="true">
                            <a class="btn" style="padding:4px 10px;font-size:12px;"
                               href="@($"/products/{p.Id}")">Edit</a>
                            <a class="btn" style="padding:4px 10px;font-size:12px;"
                               href="@($"/products/{p.Id}/images")">📷</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card">
        <p style="color:#9ca3af;">No products yet. Click <strong>+ Add Product</strong> to start.</p>
    </div>
}

<!-- Add Product Modal -->
<Modal Visible="@showModal" OnClose="CloseModal">
    <h3 style="margin-bottom:15px;">Add Product</h3>
    <input class="input full" @bind="newProductName" placeholder="Product Name *" style="margin-bottom:8px;" />
    <input class="input full" @bind="newProductDesc" placeholder="Short description (optional)" style="margin-bottom:12px;" />
    <p style="font-size:12px;color:#6b7280;margin-bottom:12px;">
        After creating, the detail page will open so you can add description, variants, categories, and images.
    </p>
    <div style="display:flex;gap:8px;">
        <button class="btn btn-primary" @onclick="CreateProduct">Save</button>
        <button class="btn" @onclick="CloseModal">Cancel</button>
    </div>
</Modal>

<style>
    .products-table .num { text-align:right; }
    .products-table tr:hover { background:#f9fafb; }
    .status-chip { font-size:11px; padding:2px 8px; border-radius:999px; font-weight:600; }
    .status-on   { background:#dcfce7; color:#15803d; }
    .status-off  { background:#fef3c7; color:#a16207; }
</style>

@code {
    List<ProductDto>? products;
    bool   isLoading = true;
    string? _error;
    bool   showModal = false;
    string  _search   = "";
    bool   _activeOnly;

    string? newProductName;
    string? newProductDesc;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadProducts();
    }

    IEnumerable<ProductDto> Filtered()
    {
        if (products == null) yield break;
        foreach (var p in products)
        {
            if (_activeOnly && !p.IsActive) continue;
            if (!string.IsNullOrWhiteSpace(_search) &&
                !p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) &&
                !p.Slug.Contains(_search, StringComparison.OrdinalIgnoreCase))
                continue;
            yield return p;
        }
    }

    void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    async Task LoadProducts()
    {
        isLoading = true;
        _error    = null;
        try
        {
            var json = await Http.GetStringAsync("api/products?page=1&pageSize=200");
            using var doc = JsonDocument.Parse(json);

            var dataEl = doc.RootElement.TryGetProperty("data", out var d) ? d : doc.RootElement;
            var itemsEl = dataEl.TryGetProperty("items", out var arr) ? arr
                        : dataEl.ValueKind == JsonValueKind.Array ? dataEl
                        : default;

            products = new();
            if (itemsEl.ValueKind == JsonValueKind.Array)
            {
                foreach (var p in itemsEl.EnumerateArray())
                {
                    var dto = new ProductDto
                    {
                        Id       = p.GetProperty("id").GetGuid(),
                        Name     = p.GetProperty("name").GetString() ?? "",
                        Slug     = p.TryGetProperty("slug", out var sl) ? sl.GetString() ?? "" : "",
                        ImageUrl = p.TryGetProperty("imageUrl", out var iu) ? iu.GetString() : null,
                        IsActive = !p.TryGetProperty("isActive", out var ia) || ia.GetBoolean(),
                        Variants = new()
                    };
                    if (p.TryGetProperty("variants", out var vs) && vs.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var v in vs.EnumerateArray())
                        {
                            dto.Variants.Add(new VariantDto
                            {
                                Id    = v.GetProperty("id").GetGuid(),
                                SKU   = v.GetProperty("sku").GetString() ?? "",
                                Price = v.TryGetProperty("price", out var pr) ? pr.GetDecimal() : 0m
                            });
                        }
                    }
                    products.Add(dto);
                }
            }
        }
        catch (Exception ex) { _error = $"Failed to load: {ex.Message}"; }
        isLoading = false;
        StateHasChanged();
    }

    void Open(Guid id) => Nav.NavigateTo($"/products/{id}");

    async Task CreateProduct()
    {
        if (string.IsNullOrWhiteSpace(newProductName))
        {
            Toast.Show("Product name is required.");
            return;
        }
        var resp = await Http.PostAsJsonAsync("api/products",
            new { name = newProductName, shortDescription = newProductDesc });
        if (!resp.IsSuccessStatusCode)
        {
            Toast.Show($"Failed to create: {await resp.Content.ReadAsStringAsync()}");
            return;
        }
        var json = await resp.Content.ReadAsStringAsync();
        using var doc = JsonDocument.Parse(json);
        var newId = doc.RootElement.GetProperty("data").GetGuid();
        Toast.Show("Product created.");
        showModal = false;
        newProductName = newProductDesc = null;
        Nav.NavigateTo($"/products/{newId}");
    }

    void CloseModal() => showModal = false;

    class ProductDto
    {
        public Guid     Id       { get; set; }
        public string   Name     { get; set; } = "";
        public string   Slug     { get; set; } = "";
        public string?  ImageUrl { get; set; }
        public bool     IsActive { get; set; }
        public List<VariantDto> Variants { get; set; } = new();
    }

    class VariantDto
    {
        public Guid    Id    { get; set; }
        public string  SKU   { get; set; } = "";
        public decimal Price { get; set; }
    }
}

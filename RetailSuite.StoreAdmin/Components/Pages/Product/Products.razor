@page "/products"
@inject HttpClient Http
@inject ToastService Toast
@using System.Text.Json

<PermissionGuard Code="PRODUCTS" />

<h3 style="margin-bottom:20px;">Products</h3>

<button class="btn btn-primary" @onclick="() => showModal = true">
    + Add Product
</button>

@if (isLoading)
{
    <div style="margin-top:20px;"><div class="spinner"></div></div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="card" style="margin-top:20px;color:#b91c1c;">⚠️ @_error</div>
}
else if (products != null && products.Any())
{
    <div class="card" style="margin-top:20px;">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Variants</th>
                    <th>Add Variant</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in products)
                {
                    <tr>
                        <td><strong>@p.Name</strong></td>
                        <td>
                            @if (p.Variants != null && p.Variants.Any())
                            {
                                @foreach (var v in p.Variants)
                                {
                                    <div>@v.SKU — Rs @v.Price.ToString("N2")</div>
                                }
                            }
                            else
                            {
                                <span style="color:#9ca3af;">No variants</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                                <input class="input" style="width:100px;" placeholder="SKU"
                                       @bind="variantInputs[p.Id].Sku" />
                                <input class="input" type="number" style="width:90px;" placeholder="Price"
                                       @bind="variantInputs[p.Id].Price" />
                                <button class="btn btn-primary" style="padding:6px 12px;"
                                        @onclick="() => AddVariant(p.Id)">
                                    Add
                                </button>
                            </div>
                        </td>
                        <td style="text-align:right;">
                            <a class="btn" style="padding:4px 10px;font-size:12px;"
                               href="@($"/products/{p.Id}/images")">📷 Images</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!isLoading)
{
    <div class="card" style="margin-top:20px;">
        <p style="color:#9ca3af;">No products yet. Click <strong>+ Add Product</strong> to get started.</p>
    </div>
}

<!-- Add Product Modal -->
<Modal Visible="@showModal" OnClose="CloseModal">
    <h3 style="margin-bottom:15px;">Add Product</h3>
    <input class="input full" @bind="newProductName" placeholder="Product Name" style="margin-bottom:8px;" />
    <input class="input full" @bind="newProductDesc" placeholder="Description (optional)" style="margin-bottom:12px;" />
    <div style="display:flex;gap:8px;">
        <button class="btn btn-primary" @onclick="CreateProduct">Save</button>
        <button class="btn" @onclick="CloseModal">Cancel</button>
    </div>
</Modal>

@code {
    List<ProductDto>? products;
    bool isLoading = true;
    string? _error;
    bool showModal = false;

    string? newProductName;
    string? newProductDesc;

    Dictionary<Guid, VariantInput> variantInputs = new();

    // -----------------------------------------------------------------------
    // Use OnAfterRenderAsync so Auth.InitializeAsync() has already run
    // in MainLayout and the HttpClient has a Bearer token.
    // -----------------------------------------------------------------------
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadProducts();
    }

    async Task LoadProducts()
    {
        isLoading = true;
        _error    = null;

        try
        {
            // API returns ApiResponse<{ Total, Page, PageSize, Items: [...] }>
            var json = await Http.GetStringAsync("api/products?page=1&pageSize=200");
            using var doc = JsonDocument.Parse(json);

            // Unwrap ApiResponse envelope if present
            var root = doc.RootElement;
            var dataEl = root.TryGetProperty("data", out var d) ? d : root;

            // Get the items array (paginated envelope)
            var itemsEl = dataEl.TryGetProperty("items", out var arr) ? arr
                        : dataEl.ValueKind == JsonValueKind.Array ? dataEl
                        : default;

            products = new List<ProductDto>();

            if (itemsEl.ValueKind == JsonValueKind.Array)
            {
                foreach (var p in itemsEl.EnumerateArray())
                {
                    var dto = new ProductDto
                    {
                        Id       = p.TryGetProperty("id",   out var id)   ? id.GetGuid()    : Guid.Empty,
                        Name     = p.TryGetProperty("name", out var nm)   ? nm.GetString()! : "—",
                        Variants = new List<VariantDto>()
                    };

                    if (p.TryGetProperty("variants", out var vars) && vars.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var v in vars.EnumerateArray())
                        {
                            dto.Variants.Add(new VariantDto
                            {
                                Id    = v.TryGetProperty("id",    out var vid) ? vid.GetGuid()    : Guid.Empty,
                                SKU   = v.TryGetProperty("sku",   out var sku) ? sku.GetString()! : "—",
                                Price = v.TryGetProperty("price", out var prc) ? prc.GetDecimal() : 0
                            });
                        }
                    }

                    products.Add(dto);
                }
            }

            // Ensure a variant-input slot exists for every product
            foreach (var p in products)
                variantInputs.TryAdd(p.Id, new VariantInput());
        }
        catch (Exception ex)
        {
            _error = $"Failed to load products: {ex.Message}";
        }

        isLoading = false;
        StateHasChanged();
    }

    async Task CreateProduct()
    {
        if (string.IsNullOrWhiteSpace(newProductName))
        {
            Toast.Show("Product name is required.");
            return;
        }

        var response = await Http.PostAsJsonAsync("api/products",
            new { name = newProductName, description = newProductDesc });

        if (response.IsSuccessStatusCode)
        {
            Toast.Show("Product created successfully.");
            newProductName = newProductDesc = null;
            showModal = false;
            await LoadProducts();
        }
        else
        {
            Toast.Show("Failed to create product.");
        }
    }

    async Task AddVariant(Guid productId)
    {
        var input = variantInputs[productId];

        if (string.IsNullOrWhiteSpace(input.Sku))
        {
            Toast.Show("SKU is required.");
            return;
        }

        var response = await Http.PostAsJsonAsync(
            $"api/products/{productId}/variants",
            new { sku = input.Sku, price = input.Price });

        if (response.IsSuccessStatusCode)
        {
            Toast.Show("Variant added.");
            variantInputs[productId] = new VariantInput();
            await LoadProducts();
        }
        else
        {
            Toast.Show("Failed to add variant.");
        }
    }

    void CloseModal() => showModal = false;

    // DTOs
    class ProductDto
    {
        public Guid         Id       { get; set; }
        public string       Name     { get; set; } = string.Empty;
        public List<VariantDto> Variants { get; set; } = new();
    }

    class VariantDto
    {
        public Guid    Id    { get; set; }
        public string  SKU   { get; set; } = string.Empty;
        public decimal Price { get; set; }
    }

    class VariantInput
    {
        public string?  Sku   { get; set; }
        public decimal  Price { get; set; }
    }
}

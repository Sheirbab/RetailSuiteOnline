@page "/store/{TenantSlug}/cart"
@layout CustomerLayout
@inherits StorefrontPageBase
@inject CartService CartSvc
@inject NavigationManager Nav
@inject ApiUrlService Api
@implements IDisposable

<h2 style="margin-bottom:20px;">Your Cart</h2>

@if (!CartSvc.Items.Any())
{
    <div class="card" style="text-align:center;padding:40px 20px;">
        <div style="font-size:48px;margin-bottom:12px;">🛒</div>
        <p style="color:#9ca3af;margin-bottom:14px;">Your cart is empty.</p>
        <a class="btn btn-primary" href="@($"/store/{TenantSlug}")">Browse products →</a>
    </div>
}
else
{
    <div class="card">
        <!-- Desktop: table -->
        <table class="table cart-desktop-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Unit Price</th>
                    <th>Qty</th>
                    <th>Line Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in CartSvc.Items)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Api.Absolute(item.ImageUrl)" style="width:40px;height:40px;object-fit:cover;border-radius:4px;margin-right:8px;vertical-align:middle;" />
                            }
                            <strong>@item.ProductName</strong>
                        </td>
                        <td>@item.SKU</td>
                        <td>Rs @item.UnitPrice.ToString("N2")</td>
                        <td>
                            <div class="qty-stepper">
                                <button type="button" @onclick="() => Decrement(item)" disabled="@(item.Quantity <= 1)">−</button>
                                <span class="qty-value">@item.Quantity</span>
                                <button type="button" @onclick="() => Increment(item)">+</button>
                            </div>
                        </td>
                        <td><strong>Rs @item.LineTotal.ToString("N2")</strong></td>
                        <td>
                            <button class="btn btn-danger" style="padding:2px 8px;font-size:12px;"
                                    @onclick="() => CartSvc.RemoveItem(item.VariantId)">✕</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Mobile: card list (a table doesn't reflow usefully at narrow widths) -->
        <div class="cart-mobile-list">
            @foreach (var item in CartSvc.Items)
            {
                <div class="cart-item-card">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@Api.Absolute(item.ImageUrl)" alt="@item.ProductName" />
                    }
                    else
                    {
                        <div class="cart-item-noimg"></div>
                    }
                    <div class="cart-item-body">
                        <div class="cart-item-name">@item.ProductName</div>
                        <div class="cart-item-sku">@item.SKU · Rs @item.UnitPrice.ToString("N2")</div>
                        <div class="cart-item-row">
                            <div class="qty-stepper">
                                <button type="button" @onclick="() => Decrement(item)" disabled="@(item.Quantity <= 1)">−</button>
                                <span class="qty-value">@item.Quantity</span>
                                <button type="button" @onclick="() => Increment(item)">+</button>
                            </div>
                            <span class="cart-item-total">Rs @item.LineTotal.ToString("N2")</span>
                        </div>
                    </div>
                    <button class="btn btn-danger" style="padding:2px 8px;font-size:12px;align-self:flex-start;"
                            @onclick="() => CartSvc.RemoveItem(item.VariantId)">✕</button>
                </div>
            }
        </div>

        <div style="text-align:right;margin-top:16px;">
            <div style="font-size:20px;font-weight:700;margin-bottom:12px;">
                Total: Rs @CartSvc.TotalAmount.ToString("N2")
            </div>
            <button class="btn" @onclick="() => CartSvc.Clear()" style="margin-right:8px;">Clear Cart</button>
            <button class="btn btn-primary" @onclick="GoCheckout">
                Proceed to Checkout →
            </button>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => CartSvc.OnChange += StateHasChanged;
    public void Dispose()                   => CartSvc.OnChange -= StateHasChanged;

    void Decrement(CartItem item) => CartSvc.UpdateQuantity(item.VariantId, item.Quantity - 1);
    void Increment(CartItem item) => CartSvc.UpdateQuantity(item.VariantId, item.Quantity + 1);

    void GoCheckout() => Nav.NavigateTo($"/store/{TenantSlug}/checkout");
}

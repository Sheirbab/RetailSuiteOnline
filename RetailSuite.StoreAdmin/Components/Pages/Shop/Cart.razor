@page "/store/{TenantSlug}/cart"
@layout CustomerLayout
@inherits StorefrontPageBase
@inject CartService CartSvc
@inject NavigationManager Nav
@inject ApiUrlService Api
@implements IDisposable

<div class="cart-page-head">
    <div>
        <p class="shop-eyebrow">Review order</p>
        <h2>Your cart</h2>
    </div>
    @if (CartSvc.Items.Any())
    {
        <a class="btn" href="@($"/store/{TenantSlug}")">Continue shopping</a>
    }
</div>

@if (!CartSvc.Items.Any())
{
    <div class="card">
        <p style="color:#9ca3af;">Your cart is empty. <a href="@($"/store/{TenantSlug}")">Browse products →</a></p>
    </div>
}
else
{
    <div class="card cart-table-card">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Unit Price</th>
                    <th>Qty</th>
                    <th>Line Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in CartSvc.Items)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Api.Absolute(item.ImageUrl)" style="width:40px;height:40px;object-fit:cover;border-radius:4px;margin-right:8px;vertical-align:middle;" />
                            }
                            <strong>@item.ProductName</strong>
                        </td>
                        <td>@item.SKU</td>
                        <td>Rs @item.UnitPrice.ToString("N2")</td>
                        <td>
                            <input type="number" class="input" style="width:60px;"
                                   value="@item.Quantity"
                                   min="1"
                                   @onchange="e => UpdateQtyFromEvent(item.VariantId, e)" />
                        </td>
                        <td><strong>Rs @item.LineTotal.ToString("N2")</strong></td>
                        <td>
                            <button class="btn btn-danger" style="padding:2px 8px;font-size:12px;"
                                    @onclick="() => CartSvc.RemoveItem(item.VariantId)">✕</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="cart-mobile-list">
        @foreach (var item in CartSvc.Items)
        {
            <article class="cart-mobile-item">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@Api.Absolute(item.ImageUrl)" alt="@item.ProductName" />
                }
                else
                {
                    <div class="cart-mobile-empty">No image</div>
                }
                <div class="cart-mobile-info">
                    <h3>@item.ProductName</h3>
                    <p>@item.SKU</p>
                    <strong>Rs @item.UnitPrice.ToString("N2")</strong>
                    <div class="cart-mobile-actions">
                        <input type="number" class="input"
                               value="@item.Quantity"
                               min="1"
                               @onchange="e => UpdateQtyFromEvent(item.VariantId, e)" />
                        <button class="btn btn-danger"
                                @onclick="() => CartSvc.RemoveItem(item.VariantId)">Remove</button>
                    </div>
                </div>
                <div class="cart-line-total">Rs @item.LineTotal.ToString("N2")</div>
            </article>
        }
    </div>

    <div class="cart-summary-bar">
        <div>
            <span>Total</span>
            <strong>Rs @CartSvc.TotalAmount.ToString("N2")</strong>
        </div>
        <div class="cart-summary-actions">
            <button class="btn" @onclick="() => CartSvc.Clear()">Clear</button>
            <button class="btn btn-primary" @onclick="GoCheckout">
                Checkout
            </button>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => CartSvc.OnChange += StateHasChanged;
    public void Dispose()                   => CartSvc.OnChange -= StateHasChanged;

    void UpdateQty(Guid variantId, int qty) => CartSvc.UpdateQuantity(variantId, qty);
    void UpdateQtyFromEvent(Guid variantId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var qty) && qty >= 1)
            CartSvc.UpdateQuantity(variantId, qty);
    }
    void GoCheckout() => Nav.NavigateTo($"/store/{TenantSlug}/checkout");
}

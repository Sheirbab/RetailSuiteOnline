@page "/store/{TenantSlug}/checkout"
@layout CustomerLayout
@inherits StorefrontPageBase
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS
@using System.Text.Json
@using System.Net.Http.Headers
@implements IDisposable

@if (_confirmed)
{
    <div class="card checkout-confirmation">
        <div class="checkout-confirmation-mark">Order confirmed</div>
        <h2>Order placed!</h2>
        <p style="color:#6b7280;margin-bottom:4px;">Order number:</p>
        <p style="font-size:22px;font-family:monospace;font-weight:700;margin:0 0 16px;">@_orderNumber</p>

        @if (_creditRedeemed > 0)
        {
            <div style="background:#dcfce7;border:1px solid #86efac;border-radius:8px;padding:10px 14px;margin-bottom:14px;color:#15803d;font-size:14px;">
                Rs @_creditRedeemed.ToString("N2") store credit applied.
            </div>
        }

        @if (_paymentQrUrl != null && _paymentStatus != "Paid")
        {
            <div style="background:#fef3c7;border:1px solid #fcd34d;border-radius:8px;padding:16px;margin-bottom:18px;">
                <p style="margin:0 0 8px;font-weight:600;color:#a16207;">
                    Scan with your @_paymentProvider app to pay
                </p>
                <p style="margin:0 0 12px;font-size:22px;font-weight:700;color:#0d3b66;">
                    Rs @_paymentAmount.ToString("N2")
                </p>
                <img src="@_paymentQrUrl" alt="Payment QR" style="width:240px;height:240px;border:1px solid #e5e7eb;border-radius:8px;" />
                <p style="margin:10px 0 0;font-size:12px;color:#6b7280;">
                    Waiting for payment confirmation...
                </p>
                @if (_devSimulatePaidUrl != null)
                {
                    <button class="btn" style="margin-top:10px;font-size:11px;background:#fee2e2;color:#b91c1c;"
                            @onclick="DevSimulatePaid">
                        DEV: Simulate paid
                    </button>
                }
            </div>
        }

        @if (_paymentStatus == "Paid")
        {
            <div style="background:#dcfce7;border:1px solid #86efac;border-radius:8px;padding:12px;margin-bottom:18px;color:#15803d;font-weight:600;">
                ✓ Payment received. Your order is confirmed.
            </div>
        }

        <p style="color:#6b7280;font-size:13px;margin-bottom:4px;">
            @if (_isPickup)
            {
                <span>Visit the store to collect your order.</span>
            }
            else
            {
                <span>Estimated delivery: @(_eta ?? "as per our standard schedule")</span>
            }
        </p>
        <p style="color:#6b7280;font-size:13px;margin-bottom:24px;">
            @if (!string.IsNullOrEmpty(_email))
            {
                <span>Confirmation sent to <strong>@_email</strong>.</span>
            }
        </p>
        <div style="display:flex;gap:8px;justify-content:center;">
            <a class="btn" href="@($"/store/{TenantSlug}/track")">Track this order</a>
            <button class="btn btn-primary" @onclick="GoShop">Continue shopping</button>
        </div>
    </div>
}
else
{
    <div class="checkout-shell">
        <div class="checkout-page-head">
            <div>
                <p class="shop-eyebrow">Secure checkout</p>
                <h2>Checkout</h2>
            </div>
            <a class="btn btn-secondary" href="@($"/store/{TenantSlug}/cart")">Back to cart</a>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:6px;padding:10px;margin-bottom:12px;color:#b91c1c;font-size:14px;">
                @_error
            </div>
        }

        <!-- Cart summary -->
        <div class="card checkout-section" style="margin-bottom:16px;">
            <h4 style="margin-bottom:8px;">Your cart</h4>
            @if (!Cart.Items.Any())
            {
                <p style="color:#9ca3af;">Cart is empty. <a href="@($"/store/{TenantSlug}")">Continue shopping</a>.</p>
            }
            else
            {
                @foreach (var item in Cart.Items)
                {
                    <div style="display:flex;justify-content:space-between;font-size:14px;padding:4px 0;">
                        <span>@item.ProductName × @item.Quantity</span>
                        <span>Rs @((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                    </div>
                }
                <hr style="margin:8px 0;" />
                <div style="display:flex;justify-content:space-between;font-weight:600;">
                    <span>Subtotal</span>
                    <span>Rs @Cart.TotalAmount.ToString("N2")</span>
                </div>
            }
        </div>

        @if (Cart.Items.Any())
        {
            <!-- Contact -->
            <div class="card checkout-section" style="margin-bottom:16px;">
                <h4 style="margin-bottom:8px;">1. Your details</h4>
                <input class="input full" placeholder="Full name *" @bind="_name"  style="margin-bottom:8px;" />
                <input class="input full" placeholder="Phone *"     @bind="_phone" style="margin-bottom:8px;" />
                <input class="input full" placeholder="Email (optional, for confirmation)" @bind="_email" type="email" />
            </div>

            <!-- Shipping method -->
            <div class="card checkout-section" style="margin-bottom:16px;">
                <h4 style="margin-bottom:8px;">2. Delivery</h4>
                @if (_shippingMethods == null)
                {
                    <div class="spinner"></div>
                }
                else if (_shippingMethods.Count == 0)
                {
                    <p style="color:#9ca3af;">No delivery options configured. Please contact the store.</p>
                }
                else
                {
                    @foreach (var m in _shippingMethods)
                    {
                        <label style="display:flex;align-items:center;gap:8px;padding:8px;border:1px solid @(_selectedShippingCode == m.Code ? "#0d3b66" : "#e5e7eb");border-radius:6px;margin-bottom:6px;cursor:pointer;">
                            <input type="radio" name="ship" value="@m.Code"
                                   checked="@(_selectedShippingCode == m.Code)"
                                   @onchange="() => OnSelectShipping(m)" />
                            <div style="flex:1;">
                                <strong>@m.Name</strong>
                                @if (!string.IsNullOrEmpty(m.Eta))
                                {
                                    <span style="color:#6b7785;font-size:12px;"> · @m.Eta</span>
                                }
                                @if (!string.IsNullOrEmpty(m.Description))
                                {
                                    <div style="font-size:12px;color:#9ca3af;">@m.Description</div>
                                }
                            </div>
                            <div style="font-weight:600;">
                                @(m.Fee == 0 ? "Free" : $"Rs {m.Fee:N2}")
                            </div>
                        </label>
                    }
                }
            </div>

            <!-- Shipping address (hidden if pickup chosen) -->
            @if (_requireAddress)
            {
                <div class="card checkout-section" style="margin-bottom:16px;">
                    <h4 style="margin-bottom:8px;">3. Shipping address</h4>
                    <input class="input full" placeholder="Recipient name *"   @bind="_address.RecipientName" style="margin-bottom:8px;" />
                    <input class="input full" placeholder="Address line 1 *"    @bind="_address.Line1"         style="margin-bottom:8px;" />
                    <input class="input full" placeholder="Address line 2"      @bind="_address.Line2"         style="margin-bottom:8px;" />
                    <input class="input full" placeholder="City *"              @bind="_address.City"          style="margin-bottom:8px;" />
                    <input class="input full" placeholder="Province"            @bind="_address.Province"      style="margin-bottom:8px;" />
                    <input class="input full" placeholder="Postal code"         @bind="_address.PostalCode"    style="margin-bottom:8px;" />
                    <textarea class="input full" placeholder="Delivery instructions (gate code, landmarks...)"
                              rows="2" @bind="_address.DeliveryInstructions"></textarea>
                </div>
            }

            <!-- Payment -->
            <div class="card checkout-section" style="margin-bottom:16px;">
                <h4 style="margin-bottom:8px;">@(_requireAddress ? "4." : "3.") Payment</h4>
                <label style="display:flex;align-items:center;gap:8px;padding:8px;border:1px solid @(_paymentMethod == "COD" ? "#0d3b66" : "#e5e7eb");border-radius:6px;margin-bottom:6px;cursor:pointer;">
                    <input type="radio" name="pay" value="COD"
                           checked="@(_paymentMethod == "COD")"
                           @onchange="@(() => SelectPayment("COD"))" />
                    <div style="flex:1;">
                        <strong>Cash on Delivery</strong>
                        <div style="font-size:12px;color:#9ca3af;">Pay in cash when your order arrives.</div>
                    </div>
                </label>

                <label style="display:flex;align-items:center;gap:8px;padding:8px;border:1px solid @(_paymentMethod == "EasyPaisa" ? "#0d3b66" : "#e5e7eb");border-radius:6px;margin-bottom:6px;cursor:pointer;">
                    <input type="radio" name="pay" value="EasyPaisa"
                           checked="@(_paymentMethod == "EasyPaisa")"
                           @onchange="@(() => SelectPayment("EasyPaisa"))" />
                    <div style="flex:1;">
                        <strong>EasyPaisa</strong>
                        <div style="font-size:12px;color:#9ca3af;">Scan a QR with your EasyPaisa app to pay.</div>
                    </div>
                </label>

                <label style="display:flex;align-items:center;gap:8px;padding:8px;border:1px solid @(_paymentMethod == "JazzCash" ? "#0d3b66" : "#e5e7eb");border-radius:6px;margin-bottom:6px;cursor:pointer;">
                    <input type="radio" name="pay" value="JazzCash"
                           checked="@(_paymentMethod == "JazzCash")"
                           @onchange="@(() => SelectPayment("JazzCash"))" />
                    <div style="flex:1;">
                        <strong>JazzCash</strong>
                        <div style="font-size:12px;color:#9ca3af;">Scan a QR with your JazzCash app to pay.</div>
                    </div>
                </label>
            </div>

            <!-- Wallet credit (only shown when the customer is signed into the wallet) -->
            @if (_walletBalance > 0)
            {
                <div class="card checkout-section checkout-credit" style="margin-bottom:16px;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                        <strong>Use store credit</strong>
                        <span style="font-size:12px;color:#0f766e;">Available: Rs @_walletBalance.ToString("N2")</span>
                    </div>
                    <label style="display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:6px;">
                        <input type="checkbox" @bind="_applyCredit" />
                        Apply store credit on this order
                    </label>
                    @if (_applyCredit)
                    {
                        <div style="display:flex;gap:8px;align-items:center;">
                            <span style="font-size:12px;color:#6b7280;">Apply Rs</span>
                            <input type="number" step="1" min="0"
                                   max="@MaxApplyableCredit"
                                   @bind="_creditToApply"
                                   style="width:120px;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;" />
                            <button class="btn btn-secondary" style="padding:4px 10px;font-size:12px;"
                                    @onclick="ApplyAllCredit">
                                Apply max
                            </button>
                        </div>
                    }
                </div>
            }

            <!-- Totals + place -->
            <div class="card checkout-section checkout-totals" style="margin-bottom:16px;">
                <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:4px;">
                    <span>Subtotal</span><span>Rs @Cart.TotalAmount.ToString("N2")</span>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:4px;">
                    <span>Shipping</span>
                    <span>@(_shippingFee == 0 ? "Free" : $"Rs {_shippingFee:N2}")</span>
                </div>
                @if (_applyCredit && _creditToApply > 0)
                {
                    <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:4px;color:#15803d;">
                        <span>Store credit</span><span>− Rs @_creditToApply.ToString("N2")</span>
                    </div>
                }
                <hr style="margin:6px 0;" />
                <div style="display:flex;justify-content:space-between;font-size:18px;font-weight:700;">
                    <span>Total</span>
                    <span>Rs @((Math.Max(0, Cart.TotalAmount + _shippingFee - (_applyCredit ? _creditToApply : 0))).ToString("N2"))</span>
                </div>
                <button class="btn btn-primary full" style="margin-top:14px;"
                        disabled="@_placing"
                        @onclick="PlaceOrder">
                    @(_placing ? "Placing order..." : "Place order")
                </button>
                <p style="text-align:center;color:#9ca3af;font-size:12px;margin-top:8px;">
                    By placing this order you agree to our terms.
                </p>
            </div>
        }
    </div>
}

@code {
    // Confirmation state
    bool   _confirmed;
    string? _orderNumber;
    string? _email;
    string? _eta;
    bool   _isPickup;
    decimal _creditRedeemed;

    // Form state
    string _name = string.Empty;
    string _phone = string.Empty;
    bool _placing;
    string? _error;

    // Shipping
    List<ShippingDto>? _shippingMethods;
    string? _selectedShippingCode;
    decimal _shippingFee;
    bool _requireAddress = true;
    AddressForm _address = new();

    // Payment
    string _paymentMethod = "COD";

    // Post-checkout QR-payment state
    Guid?   _paymentIntentId;
    string? _paymentProvider;
    string? _paymentQrUrl;
    string? _devSimulatePaidUrl;
    decimal _paymentAmount;
    string  _paymentStatus = "Pending";
    System.Threading.Timer? _statusPoller;

    // Wallet state (loaded from localStorage on first render)
    const string WALLET_TOKEN_KEY = "wallet_token";
    string? _walletToken;
    decimal _walletBalance;
    string  _walletPhone = "";
    bool    _applyCredit;
    decimal _creditToApply;

    decimal MaxApplyableCredit =>
        Math.Min(_walletBalance, Cart.TotalAmount + _shippingFee);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadShippingMethods();
            await LoadWalletAsync();
        }
    }

    async Task LoadWalletAsync()
    {
        try
        {
            var t = await JS.InvokeAsync<string?>("localStorage.getItem", WALLET_TOKEN_KEY);
            if (string.IsNullOrEmpty(t)) return;

            _walletToken = t;
            // Probe /api/wallet/me for the live balance using this token.
            using var req = new HttpRequestMessage(HttpMethod.Get, "api/wallet/me");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", t);
            var resp = await Http.SendAsync(req);
            if (!resp.IsSuccessStatusCode) { _walletToken = null; return; }

            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            var d = doc.RootElement.GetProperty("data");
            _walletBalance = d.GetProperty("balances").GetProperty("storeCredit").GetDecimal();
            _walletPhone   = d.GetProperty("customer").GetProperty("phone").GetString() ?? "";

            // Prefill name + phone fields from the wallet customer so they don't retype.
            if (string.IsNullOrWhiteSpace(_name))
                _name = d.GetProperty("customer").GetProperty("fullName").GetString() ?? "";
            if (string.IsNullOrWhiteSpace(_phone))
                _phone = _walletPhone;

            StateHasChanged();
        }
        catch { /* wallet probe is best-effort */ }
    }

    void ApplyAllCredit() => _creditToApply = MaxApplyableCredit;

    async Task LoadShippingMethods()
    {
        try
        {
            var subtotal = Cart.TotalAmount;
            var json = await Http.GetStringAsync(ShopApi($"shipping-methods?subtotal={subtotal}"));
            using var doc = JsonDocument.Parse(json);
            _shippingMethods = new();
            if (doc.RootElement.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Array)
            {
                foreach (var e in d.EnumerateArray())
                {
                    _shippingMethods.Add(new ShippingDto
                    {
                        Code        = e.GetProperty("code").GetString() ?? "",
                        Name        = e.GetProperty("name").GetString() ?? "",
                        Description = e.TryGetProperty("description", out var ds) ? ds.GetString() : null,
                        Eta         = e.TryGetProperty("eta",          out var et) ? et.GetString() : null,
                        IsPickup    = e.TryGetProperty("isPickup",     out var ip) && ip.GetBoolean(),
                        Fee         = e.TryGetProperty("fee",          out var fe) ? fe.GetDecimal() : 0m
                    });
                }
            }

            if (_shippingMethods.Count > 0)
            {
                var first = _shippingMethods.First();
                OnSelectShipping(first);
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = $"Could not load shipping options: {ex.Message}";
        }
    }

    void OnSelectShipping(ShippingDto m)
    {
        _selectedShippingCode = m.Code;
        _shippingFee          = m.Fee;
        _requireAddress       = !m.IsPickup;
    }

    async Task PlaceOrder()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_phone))
        {
            _error = "Name and phone are required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_selectedShippingCode))
        {
            _error = "Pick a delivery option.";
            return;
        }
        if (_requireAddress &&
            (string.IsNullOrWhiteSpace(_address.RecipientName) ||
             string.IsNullOrWhiteSpace(_address.Line1) ||
             string.IsNullOrWhiteSpace(_address.City)))
        {
            _error = "Recipient name, line 1 and city are required for delivery.";
            return;
        }

        _placing = true;
        StateHasChanged();

        var creditApply = (_applyCredit && _creditToApply > 0) ? _creditToApply : 0m;
        // Don't redeem more than the customer actually has, or more than the order is worth.
        if (creditApply > MaxApplyableCredit) creditApply = MaxApplyableCredit;

        var body = new
        {
            guestName  = _name,
            guestPhone = _phone,
            guestEmail = _email,
            items = Cart.Items.Select(i => new
            {
                productVariantId = i.VariantId,
                quantity         = i.Quantity
            }).ToList(),
            shippingMethodCode = _selectedShippingCode,
            shippingAddress    = _requireAddress ? _address : null,
            paymentMethod      = _paymentMethod,
            walletToken        = _walletToken,
            storeCreditApply   = creditApply
        };

        try
        {
            var resp = await Http.PostAsJsonAsync(ShopApi("checkout"), body);
            if (!resp.IsSuccessStatusCode)
            {
                var msg = await resp.Content.ReadAsStringAsync();
                _error = $"Checkout failed: {msg}";
                return;
            }

            var json = await resp.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(json);
            var d = doc.RootElement.GetProperty("data");

            _orderNumber = d.GetProperty("orderNumber").GetString();
            _isPickup    = d.TryGetProperty("isPickup", out var ip) && ip.GetBoolean();
            _eta         = d.TryGetProperty("expectedDelivery", out var et) ? et.GetString() : null;
            _creditRedeemed = d.TryGetProperty("storeCreditRedeemed", out var sc) && sc.ValueKind == JsonValueKind.Number
                              ? sc.GetDecimal() : 0m;

            // QR-based payment? Stash the intent details and start polling for status.
            if (d.TryGetProperty("payment", out var pay) && pay.ValueKind == JsonValueKind.Object)
            {
                _paymentIntentId    = pay.GetProperty("intentId").GetGuid();
                _paymentProvider    = pay.GetProperty("provider").GetString();
                _paymentAmount      = pay.GetProperty("amountDue").GetDecimal();
                _paymentQrUrl       = pay.GetProperty("qrImageUrl").GetString();
                _devSimulatePaidUrl = $"api/payments/intent/{_paymentIntentId}/simulate-paid";
                StartStatusPolling();
            }

            _confirmed = true;
            Cart.Clear();
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _placing = false;
            StateHasChanged();
        }
    }

    void SelectPayment(string code) => _paymentMethod = code;

    void GoShop() => Nav.NavigateTo($"/store/{TenantSlug}");

    void StartStatusPolling()
    {
        _statusPoller?.Dispose();
        _statusPoller = new System.Threading.Timer(async _ =>
        {
            if (!_paymentIntentId.HasValue) return;
            try
            {
                var json = await Http.GetStringAsync($"api/payments/intent/{_paymentIntentId}/status");
                using var doc = JsonDocument.Parse(json);
                var status = doc.RootElement.GetProperty("data").GetProperty("status").GetString() ?? "Pending";
                if (status != _paymentStatus)
                {
                    _paymentStatus = status;
                    await InvokeAsync(StateHasChanged);
                }
                if (status is "Paid" or "Failed" or "Expired")
                {
                    _statusPoller?.Dispose();
                    _statusPoller = null;
                }
            }
            catch { /* network blip — try again next tick */ }
        }, null, dueTime: TimeSpan.FromSeconds(3), period: TimeSpan.FromSeconds(3));
    }

    async Task DevSimulatePaid()
    {
        if (!_paymentIntentId.HasValue) return;
        try
        {
            await Http.PostAsync($"api/payments/intent/{_paymentIntentId}/simulate-paid", null);
            // Status poller picks up the change within ~3s.
        }
        catch (Exception ex) { Toast.Show($"Simulate failed: {ex.Message}"); }
    }

    public void Dispose()
    {
        _statusPoller?.Dispose();
        _statusPoller = null;
    }

    class ShippingDto
    {
        public string  Code { get; set; } = "";
        public string  Name { get; set; } = "";
        public string? Description { get; set; }
        public string? Eta { get; set; }
        public bool    IsPickup { get; set; }
        public decimal Fee { get; set; }
    }

    class AddressForm
    {
        public string  RecipientName { get; set; } = "";
        public string  Line1 { get; set; } = "";
        public string? Line2 { get; set; }
        public string  City { get; set; } = "";
        public string? Province { get; set; }
        public string? PostalCode { get; set; }
        public string  Country { get; set; } = "PK";
        public string? Phone { get; set; }
        public string? DeliveryInstructions { get; set; }
    }
}

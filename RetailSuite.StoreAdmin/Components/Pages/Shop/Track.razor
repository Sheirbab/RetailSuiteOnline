@page "/shop/track"
@layout CustomerLayout
@inject HttpClient Http
@using System.Text.Json
@implements IDisposable

<style>
    .tk-shell    { max-width:620px; margin:0 auto; }
    .tk-row      { display:flex; justify-content:space-between; align-items:center; }
    .pill        { display:inline-block; font-size:11px; padding:3px 10px; border-radius:6px; font-weight:600; }
    .timeline    { display:flex; gap:0; margin:18px 0; }
    .tl-step     { flex:1; text-align:center; position:relative; }
    .tl-dot      { width:28px; height:28px; border-radius:50%; background:#e5e7eb; color:#9ca3af;
                   display:inline-flex; align-items:center; justify-content:center; font-size:13px; font-weight:700;
                   z-index:1; position:relative; }
    .tl-dot.done    { background:#16a34a; color:#fff; }
    .tl-dot.current { background:#1d4ed8; color:#fff; }
    .tl-step:not(:last-child)::after {
        content:""; position:absolute; top:14px; left:calc(50% + 14px); right:calc(-50% + 14px);
        height:2px; background:#e5e7eb; z-index:0;
    }
    .tl-step.done:not(:last-child)::after { background:#16a34a; }
    .tl-label   { font-size:11px; color:#6b7280; margin-top:6px; }

    .pay-card    { background:linear-gradient(135deg,#fef3c7 0%, #fde68a 100%);
                   border:1px solid #fcd34d; border-radius:10px; padding:16px;
                   margin-bottom:14px; text-align:center; }
    .pay-card.paid { background:linear-gradient(135deg,#dcfce7 0%, #bbf7d0 100%);
                     border-color:#86efac; }
</style>

<div class="tk-shell">
    <h2 style="margin-bottom:20px;">Track your order</h2>

    <div class="card" style="margin-bottom:16px;">
        <p style="color:#6b7785;font-size:13px;margin-top:0;">
            Enter your order number and the phone number you used at checkout.
        </p>
        <input class="input full" placeholder="Order number (e.g. WEB-...)" @bind="_orderNumber"
               style="margin-bottom:8px;" />
        <input class="input full" placeholder="Phone number"                 @bind="_phone"
               style="margin-bottom:12px;" />
        <button class="btn btn-primary" @onclick="DoTrack" disabled="@_loading">
            @(_loading ? "Looking up..." : "Track order")
        </button>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div style="margin-top:10px;color:#b91c1c;font-size:13px;">@_error</div>
        }
    </div>

    @if (_result != null)
    {
        <!-- ============================ Header ============================ -->
        <div class="card" style="margin-bottom:14px;">
            <div class="tk-row" style="margin-bottom:12px;">
                <div>
                    <strong style="font-family:monospace;font-size:15px;">@_result.OrderNumber</strong>
                    <div style="font-size:12px;color:#6b7785;">
                        Placed @_result.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </div>
                </div>
                <span class="pill" style="background:@FulfillmentBg(_result.FulfillmentStatus);color:@FulfillmentFg(_result.FulfillmentStatus);">
                    @_result.FulfillmentStatus
                </span>
            </div>

            <!-- Timeline -->
            <div class="timeline">
                @{
                    var steps = new[] { "Placed", "Confirmed", "Shipped", "Delivered" };
                    var currentIdx = StepIndex(_result.FulfillmentStatus, _result.Status);
                }
                @for (var i = 0; i < steps.Length; i++)
                {
                    var cls = i < currentIdx ? "done" : (i == currentIdx ? "current" : "");
                    var stepCls = i < currentIdx ? "done" : "";
                    <div class="tl-step @stepCls">
                        <span class="tl-dot @cls">@(i < currentIdx ? "✓" : (i + 1).ToString())</span>
                        <div class="tl-label">@steps[i]</div>
                    </div>
                }
            </div>
        </div>

        <!-- ============================ Payment status ============================ -->
        @if (_result.IsFullyPaid)
        {
            <div class="pay-card paid">
                <div style="font-size:24px;">✅</div>
                <strong style="color:#15803d;">Payment received</strong>
                <div style="font-size:12px;color:#15803d;margin-top:4px;">
                    Rs @_result.PaidAmount.ToString("N2") paid via @(_result.PaymentMethodCode ?? "—")
                </div>
            </div>
        }
        else if (_result.PendingPayment != null && _result.PaymentStatus != "Paid")
        {
            <div class="pay-card">
                <strong style="color:#a16207;">Awaiting payment via @_result.PendingPayment.Provider</strong>
                <div style="font-size:22px;font-weight:700;color:#0d3b66;margin:8px 0;">
                    Rs @_result.PendingPayment.AmountDue.ToString("N2")
                </div>
                <img src="@_result.PendingPayment.QrImageUrl"
                     alt="Payment QR"
                     style="width:220px;height:220px;border:1px solid #fcd34d;border-radius:8px;background:#fff;" />
                <p style="font-size:11px;color:#a16207;margin:8px 0 0;">
                    Scan with your @_result.PendingPayment.Provider app. Page refreshes automatically.
                </p>
                <button class="btn" style="margin-top:10px;font-size:11px;background:#fee2e2;color:#b91c1c;"
                        @onclick="DevSimulatePaid">
                    🛠 DEV: Simulate paid
                </button>
            </div>
        }
        else if (_result.PaymentMethodCode == "COD")
        {
            <div class="pay-card">
                <strong style="color:#a16207;">💵 Cash on Delivery</strong>
                <div style="font-size:12px;color:#a16207;margin-top:4px;">
                    Pay Rs @_result.Outstanding.ToString("N2") to the courier when your order arrives.
                </div>
            </div>
        }

        <!-- ============================ Recipient / shipping ============================ -->
        <div class="card" style="margin-bottom:14px;">
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;font-size:13px;">
                <div><span style="color:#6b7785;">Recipient</span><br/><strong>@_result.GuestName</strong></div>
                <div><span style="color:#6b7785;">Payment method</span><br/><strong>@_result.PaymentMethodCode</strong></div>
                <div><span style="color:#6b7785;">Shipping</span><br/><strong>@_result.ShippingMethodCode</strong></div>
                <div><span style="color:#6b7785;">Order status</span><br/><strong>@_result.Status</strong></div>
            </div>
        </div>

        <!-- ============================ Items + totals ============================ -->
        <div class="card">
            <h4 style="margin:0 0 8px;">Items</h4>
            @foreach (var item in _result.Items)
            {
                <div class="tk-row" style="font-size:13px;padding:3px 0;">
                    <span>@item.SKU × @item.Quantity</span>
                    <span>Rs @item.LineTotal.ToString("N2")</span>
                </div>
            }
            <hr style="margin:8px 0;" />
            <div class="tk-row" style="font-size:13px;">
                <span>Shipping</span>
                <span>@(_result.ShippingAmount == 0 ? "Free" : $"Rs {_result.ShippingAmount:N2}")</span>
            </div>
            <div class="tk-row" style="font-weight:700;font-size:16px;">
                <span>Total</span>
                <span>Rs @_result.TotalAmount.ToString("N2")</span>
            </div>
            @if (!string.IsNullOrEmpty(_result.InvoiceNumber))
            {
                <hr style="margin:10px 0;" />
                <div class="tk-row">
                    <span style="font-size:13px;color:#6b7785;">Invoice</span>
                    <a href="@($"/invoice/{_result.OrderId}")" target="_blank" style="font-size:13px;font-weight:600;">
                        📄 @_result.InvoiceNumber
                    </a>
                </div>
            }
        </div>
    }
</div>

@code {
    string _orderNumber = string.Empty;
    string _phone = string.Empty;
    bool _loading;
    string? _error;
    TrackResult? _result;

    // Polling for pending payment status
    System.Threading.Timer? _poller;

    async Task DoTrack()
    {
        _error  = null;
        _result = null;
        DisposePoller();
        if (string.IsNullOrWhiteSpace(_orderNumber) || string.IsNullOrWhiteSpace(_phone))
        {
            _error = "Order number and phone are required.";
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            await FetchOrderAsync();

            // If there's a pending payment intent, start polling its status so the
            // "Awaiting payment" card flips to ✅ when the gateway webhook lands.
            if (_result?.PendingPayment != null)
                StartPolling(_result.PendingPayment.IntentId);
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    async Task FetchOrderAsync()
    {
        var url = $"api/shop/orders/{Uri.EscapeDataString(_orderNumber.Trim())}?phone={Uri.EscapeDataString(_phone.Trim())}";
        var resp = await Http.GetAsync(url);
        if (resp.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _error = "We couldn't find an order matching that combination.";
            return;
        }
        if (!resp.IsSuccessStatusCode)
        {
            _error = "Lookup failed. Please try again.";
            return;
        }

        var json = await resp.Content.ReadAsStringAsync();
        using var doc = JsonDocument.Parse(json);
        var d = doc.RootElement.GetProperty("data");

        var result = new TrackResult
        {
            OrderNumber       = d.GetProperty("orderNumber").GetString() ?? "",
            InvoiceNumber     = d.TryGetProperty("invoiceNumber", out var inv) && inv.ValueKind == JsonValueKind.String ? inv.GetString() : null,
            Status            = d.GetProperty("status").GetString() ?? "",
            FulfillmentStatus = d.GetProperty("fulfillmentStatus").GetString() ?? "",
            TotalAmount       = d.GetProperty("totalAmount").GetDecimal(),
            PaidAmount        = d.GetProperty("paidAmount").GetDecimal(),
            Outstanding       = d.GetProperty("outstanding").GetDecimal(),
            IsFullyPaid       = d.GetProperty("isFullyPaid").GetBoolean(),
            ShippingAmount    = d.GetProperty("shippingAmount").GetDecimal(),
            ShippingMethodCode = d.TryGetProperty("shippingMethodCode", out var sm) ? sm.GetString() : null,
            PaymentMethodCode  = d.TryGetProperty("paymentMethodCode",  out var pm) ? pm.GetString() : null,
            GuestName          = d.TryGetProperty("guestName", out var gn) ? gn.GetString() : null,
            CreatedAt          = d.GetProperty("createdAt").GetDateTime(),
            Items = d.GetProperty("items").EnumerateArray().Select(it => new TrackItem
            {
                SKU       = it.GetProperty("sKU").GetString() ?? "",
                Quantity  = it.GetProperty("quantity").GetInt32(),
                UnitPrice = it.GetProperty("unitPrice").GetDecimal(),
                LineTotal = it.GetProperty("lineTotal").GetDecimal()
            }).ToList()
        };

        if (d.TryGetProperty("pendingPayment", out var pp) && pp.ValueKind == JsonValueKind.Object)
        {
            result.PendingPayment = new PendingPaymentDto
            {
                IntentId    = pp.GetProperty("intentId").GetGuid(),
                Provider    = pp.GetProperty("provider").GetString() ?? "",
                AmountDue   = pp.GetProperty("amountDue").GetDecimal(),
                QrImageUrl  = pp.GetProperty("qrImageUrl").GetString() ?? "",
                ExpiresAt   = pp.GetProperty("expiresAt").GetDateTime()
            };
        }

        // We need the OrderId to link to /invoice/{id} — pull it from the response.
        // The track endpoint doesn't expose Id directly; load it via the intent id alternative,
        // or extend the endpoint. For now: hide the invoice link if we don't have it.
        if (d.TryGetProperty("id", out var idEl)) result.OrderId = idEl.GetGuid();

        _result = result;
    }

    void StartPolling(Guid intentId)
    {
        DisposePoller();
        _poller = new System.Threading.Timer(async _ =>
        {
            try
            {
                var json = await Http.GetStringAsync($"api/payments/intent/{intentId}/status");
                using var doc = JsonDocument.Parse(json);
                var status = doc.RootElement.GetProperty("data").GetProperty("status").GetString() ?? "Pending";
                if (_result != null) _result.PaymentStatus = status;
                if (status is "Paid" or "Failed" or "Expired")
                {
                    DisposePoller();
                    // Reload the order to pick up the new IsFullyPaid / status.
                    await InvokeAsync(FetchOrderAsync);
                }
                await InvokeAsync(StateHasChanged);
            }
            catch { /* keep trying */ }
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    async Task DevSimulatePaid()
    {
        if (_result?.PendingPayment == null) return;
        try
        {
            await Http.PostAsync($"api/payments/intent/{_result.PendingPayment.IntentId}/simulate-paid", null);
            // Poller picks up the change within ~3s.
        }
        catch { }
    }

    void DisposePoller() { _poller?.Dispose(); _poller = null; }
    public void Dispose() => DisposePoller();

    // ----- styling helpers ----------------------------------------------

    static int StepIndex(string fulfilment, string status)
    {
        if (status == "Cancelled" || fulfilment == "Cancelled") return -1;
        if (fulfilment == "Delivered") return 4;
        if (fulfilment == "Shipped")   return 3;
        if (status == "Confirmed" || status == "Completed") return 2;
        return 1; // Placed
    }

    static string FulfillmentBg(string status) => status switch
    {
        "Shipped"   => "#dbeafe",
        "Delivered" => "#dcfce7",
        "Cancelled" => "#fee2e2",
        _           => "#fef3c7"
    };
    static string FulfillmentFg(string status) => status switch
    {
        "Shipped"   => "#1d4ed8",
        "Delivered" => "#15803d",
        "Cancelled" => "#b91c1c",
        _           => "#a16207"
    };

    class TrackResult
    {
        public Guid     OrderId { get; set; }
        public string   OrderNumber { get; set; } = "";
        public string?  InvoiceNumber { get; set; }
        public string   Status { get; set; } = "";
        public string   FulfillmentStatus { get; set; } = "";
        public decimal  TotalAmount { get; set; }
        public decimal  PaidAmount { get; set; }
        public decimal  Outstanding { get; set; }
        public bool     IsFullyPaid { get; set; }
        public decimal  ShippingAmount { get; set; }
        public string?  ShippingMethodCode { get; set; }
        public string?  PaymentMethodCode { get; set; }
        public string?  GuestName { get; set; }
        public DateTime CreatedAt { get; set; }
        public List<TrackItem> Items { get; set; } = new();
        public PendingPaymentDto? PendingPayment { get; set; }
        public string? PaymentStatus { get; set; }
    }

    class TrackItem
    {
        public string  SKU { get; set; } = "";
        public int     Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal LineTotal { get; set; }
    }

    class PendingPaymentDto
    {
        public Guid     IntentId { get; set; }
        public string   Provider { get; set; } = "";
        public decimal  AmountDue { get; set; }
        public string   QrImageUrl { get; set; } = "";
        public DateTime ExpiresAt { get; set; }
    }
}

@page "/login"
@using RetailSuite.StoreAdmin.Shared
@inject AuthService Auth
@inject NavigationManager Nav
@layout LoginLayout

<div class="login-container">
    <div class="login-card">

        <h2>RetailSuite</h2>
        <p class="subtitle">Sign in to your store</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:6px;padding:10px 14px;margin-bottom:12px;color:#b91c1c;font-size:14px;">
                @_error
            </div>
        }

        <input class="input full"
               type="email"
               placeholder="Email address"
               @bind="_email"
               @onkeydown="HandleKeyDown" />

        <input class="input full"
               type="password"
               placeholder="Password"
               @bind="_password"
               @onkeydown="HandleKeyDown" />

        <button class="btn btn-primary full"
                @onclick="LogIn"
                disabled="@_loading">
            @(_loading ? "Signing in..." : "Sign In")
        </button>

        <p style="text-align:center;margin-top:18px;font-size:13px;color:#6b7280;">
            New to RetailSuite?
            <a href="/signup" style="color:#1d4ed8;font-weight:600;">Create an account</a>
        </p>

    </div>
</div>

@code {
    string? _email;
    string? _password;
    string? _error;
    bool    _loading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Restore any persisted token before deciding whether to redirect.
        // This prevents the login page from flashing when the user is already
        // authenticated (token is in localStorage but not yet in memory).
        await Auth.InitializeAsync();

        if (Auth.IsAuthenticated)
            Nav.NavigateTo("/", replace: true);
    }

    async Task LogIn()
    {
        _error   = null;
        _loading = true;

        var (success, error) = await Auth.LoginAsync(_email, _password);

        _loading = false;

        if (success)
        {
            // First-login users must change their temp password before reaching the dashboard.
            Nav.NavigateTo(Auth.MustChangePassword ? "/change-password" : "/", replace: true);
        }
        else
            _error = error;
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LogIn();
    }
}

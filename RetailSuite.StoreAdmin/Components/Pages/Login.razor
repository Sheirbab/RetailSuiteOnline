@page "/login"
@using RetailSuite.StoreAdmin.Shared
@inject AuthService Auth
@inject NavigationManager Nav
@layout LoginLayout

<div class="login-container">
    <div class="login-card">

        <h2>RetailSuite</h2>
        <p class="subtitle">Sign in to your store</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:6px;padding:10px 14px;margin-bottom:12px;color:#b91c1c;font-size:14px;">
                @_error
            </div>
        }

        <input class="input full"
               type="email"
               placeholder="Email address"
               @bind="_email"
               @onkeydown="HandleKeyDown" />

        <input class="input full"
               type="password"
               placeholder="Password"
               @bind="_password"
               @onkeydown="HandleKeyDown" />

        <button class="btn btn-primary full"
                @onclick="LogIn"
                disabled="@_loading">
            @(_loading ? "Signing in..." : "Sign In")
        </button>

    </div>
</div>

@code {
    string? _email;
    string? _password;
    string? _error;
    bool    _loading;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
            Nav.NavigateTo("/", replace: true);
    }

    async Task LogIn()
    {
        _error   = null;
        _loading = true;

        var (success, error) = await Auth.LoginAsync(_email, _password);

        _loading = false;

        if (success)
            Nav.NavigateTo("/", replace: true);
        else
            _error = error;
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LogIn();
    }
}

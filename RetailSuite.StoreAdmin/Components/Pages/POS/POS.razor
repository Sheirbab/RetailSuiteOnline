@page "/pos"
@layout PosLayout
@inject HttpClient Http
@inject ToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthService Auth
@inject ApiUrlService Api
@using System.Text.Json
@implements IDisposable

<PermissionGuard Code="POS" />

<style>
    /* ============================== POS Layout ============================== */
    .pos-shell { display:flex; flex-direction:column; gap:14px; min-height:calc(100vh - 120px); }

    .pos-topbar {
        display:flex; align-items:center; gap:10px; flex-wrap:wrap;
        background:linear-gradient(135deg, #0d3b66 0%, #1d4ed8 100%);
        color:#fff; padding:14px 18px; border-radius:12px;
        box-shadow:0 4px 12px rgba(13,59,102,.18);
    }
    .pos-topbar h3 { margin:0; flex:1; font-weight:700; letter-spacing:.3px; }
    .pos-topbar .icon-btn {
        background:rgba(255,255,255,.12); color:#fff; border:1px solid rgba(255,255,255,.25);
        padding:7px 14px; border-radius:8px; font-size:13px; font-weight:500;
        display:inline-flex; align-items:center; gap:6px; cursor:pointer; transition:.15s;
    }
    .pos-topbar .icon-btn:hover:not(:disabled) { background:rgba(255,255,255,.22); }
    .pos-topbar .icon-btn:disabled { opacity:.45; cursor:not-allowed; }
    .pos-topbar .icon-btn .badge {
        background:#f59e0b; color:#fff; border-radius:10px; padding:0 7px;
        font-size:11px; font-weight:700; margin-left:4px;
    }
    .pos-customer-pill {
        background:#ecfdf5; color:#065f46; padding:7px 14px; border-radius:20px;
        font-size:13px; display:inline-flex; align-items:center; gap:8px;
        border:1px solid #6ee7b7;
    }
    .pos-customer-pill .perks { color:#0d3b66; font-size:11px; }
    .pos-customer-pill .x-btn {
        background:transparent; border:none; color:#065f46;
        cursor:pointer; padding:0 4px; font-size:14px;
    }

    .pos-main { display:flex; gap:16px; align-items:flex-start; flex:1; }
    .pos-left  { flex:1; display:flex; flex-direction:column; gap:12px; min-width:0; }
    .pos-right { width:440px; flex-shrink:0; }

    /* Tablet — narrower cart pane */
    @@media (max-width: 1100px) {
        .pos-right { width:380px; }
    }

    /* Mobile — stack cart below products, full-width */
    @@media (max-width: 820px) {
        .pos-main  { flex-direction:column; }
        .pos-right { width:100%; }
        .pos-topbar { padding:10px 12px; }
        .pos-topbar h3 { font-size:18px; }
        .pos-tile-grid { grid-template-columns:repeat(auto-fill, minmax(130px, 1fr)); max-height:none; }
    }

    /* ============================== Search + filters ============================== */
    .pos-search-row {
        background:#fff; padding:12px; border-radius:10px;
        box-shadow:0 1px 3px rgba(0,0,0,.06); display:flex; gap:10px; align-items:center;
    }
    .pos-search-row .search-icon { color:#9ca3af; font-size:18px; padding:0 6px; }
    .pos-search-row input {
        flex:1; border:none; outline:none; font-size:15px; padding:6px 4px;
        background:transparent;
    }
    .pos-search-row .scan-hint {
        color:#6b7280; font-size:11px; padding:4px 10px; background:#f3f4f6;
        border-radius:6px; white-space:nowrap;
    }

    .pos-cat-chips {
        display:flex; gap:8px; overflow-x:auto; padding:4px 2px 8px;
        scrollbar-width:thin;
    }
    .pos-cat-chips::-webkit-scrollbar { height:6px; }
    .pos-cat-chips::-webkit-scrollbar-thumb { background:#d1d5db; border-radius:3px; }
    .pos-chip {
        background:#fff; border:1px solid #e5e7eb; color:#374151;
        padding:7px 14px; border-radius:20px; font-size:13px; font-weight:500;
        cursor:pointer; white-space:nowrap; transition:.15s;
        display:inline-flex; align-items:center; gap:6px;
    }
    .pos-chip:hover { border-color:#1d4ed8; color:#1d4ed8; }
    .pos-chip.active { background:#1d4ed8; border-color:#1d4ed8; color:#fff; }
    .pos-chip .count {
        background:rgba(0,0,0,.08); padding:0 6px; border-radius:8px; font-size:11px;
    }
    .pos-chip.active .count { background:rgba(255,255,255,.25); }

    /* ============================== Product tiles ============================== */
    .pos-tile-grid {
        display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr));
        gap:12px; max-height:calc(100vh - 280px); overflow-y:auto; padding:4px;
    }
    .pos-tile {
        background:#fff; border:1px solid #e5e7eb; border-radius:10px;
        padding:10px; cursor:pointer; transition:.15s; position:relative;
        display:flex; flex-direction:column; text-align:left;
        box-shadow:0 1px 2px rgba(0,0,0,.04);
    }
    .pos-tile:hover {
        transform:translateY(-2px);
        box-shadow:0 6px 16px rgba(29,78,216,.15);
        border-color:#1d4ed8;
    }
    .pos-tile:active { transform:translateY(0); }
    .pos-tile.out-of-stock { opacity:.55; cursor:not-allowed; }
    .pos-tile.out-of-stock:hover { transform:none; box-shadow:0 1px 2px rgba(0,0,0,.04); border-color:#e5e7eb; }

    .pos-tile-img {
        width:100%; aspect-ratio:1/1; background:#f9fafb; border-radius:8px;
        display:flex; align-items:center; justify-content:center; overflow:hidden;
        margin-bottom:8px;
    }
    .pos-tile-img img { width:100%; height:100%; object-fit:cover; }
    .pos-tile-img .placeholder { font-size:36px; color:#d1d5db; }
    .pos-tile-name { font-weight:600; font-size:13px; color:#111827; line-height:1.3; margin-bottom:2px;
                     display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
                     overflow:hidden; min-height:34px; }
    .pos-tile-sku { font-family:monospace; font-size:10px; color:#9ca3af; margin-bottom:6px; }
    .pos-tile-bottom { display:flex; justify-content:space-between; align-items:flex-end; margin-top:auto; }
    .pos-tile-price { font-weight:700; font-size:15px; color:#0d3b66; }
    .pos-stock-badge {
        font-size:10px; padding:2px 6px; border-radius:8px; font-weight:600;
    }
    .stock-ok    { background:#dcfce7; color:#15803d; }
    .stock-low   { background:#fef3c7; color:#a16207; }
    .stock-out   { background:#fee2e2; color:#b91c1c; }

    .pos-empty {
        background:#fff; border-radius:10px; padding:40px;
        text-align:center; color:#9ca3af;
    }

    /* ============================== Cart panel ============================== */
    .pos-cart {
        background:#fff; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,.06);
        display:flex; flex-direction:column; max-height:calc(100vh - 130px);
    }
    .pos-cart-header {
        padding:14px 16px; border-bottom:1px solid #f3f4f6;
        display:flex; justify-content:space-between; align-items:center;
    }
    .pos-cart-header h4 { margin:0; font-weight:700; }
    .pos-cart-count {
        background:#eff6ff; color:#1d4ed8; padding:2px 10px;
        border-radius:12px; font-size:12px; font-weight:600;
    }

    .pos-cart-items { padding:8px 16px; flex:1; overflow-y:auto; min-height:120px; }
    .pos-cart-item {
        padding:10px 0; border-bottom:1px dashed #f3f4f6;
    }
    .pos-cart-item:last-child { border-bottom:none; }
    .pos-cart-item .top-row { display:flex; justify-content:space-between; align-items:center; gap:8px; }
    .pos-cart-item .name { flex:1; font-size:13px; }
    .pos-cart-item .sku { font-family:monospace; font-size:11px; color:#9ca3af; }
    .pos-cart-item .price { font-size:11px; color:#6b7280; }
    .qty-stepper {
        display:flex; align-items:center; gap:4px;
        background:#f3f4f6; border-radius:6px; padding:2px;
    }
    .qty-stepper button {
        background:#fff; border:1px solid #e5e7eb; border-radius:4px;
        width:24px; height:24px; cursor:pointer; font-size:14px; font-weight:600;
        color:#374151;
    }
    .qty-stepper button:hover { background:#eff6ff; border-color:#1d4ed8; color:#1d4ed8; }
    .qty-stepper .qty { min-width:24px; text-align:center; font-weight:700; font-size:13px; }
    .pos-cart-item .remove-btn {
        background:transparent; border:none; color:#dc2626;
        cursor:pointer; padding:0 4px; font-size:14px;
    }
    .pos-cart-item .line-discount {
        display:flex; align-items:center; gap:6px; margin-top:4px; font-size:11px;
    }
    .pos-cart-item .line-discount input {
        width:70px; padding:2px 6px; font-size:11px; border:1px solid #e5e7eb;
        border-radius:4px;
    }
    .pos-cart-item .line-total { margin-left:auto; font-weight:700; font-size:13px; color:#0d3b66; }

    .pos-cart-totals { padding:12px 16px; background:#f9fafb; border-top:1px solid #f3f4f6; font-size:13px; }
    .pos-cart-totals .row { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
    .pos-cart-totals .row.discount-row { color:#a16207; }
    .pos-cart-totals .row.credit-row   { color:#15803d; }
    .pos-cart-totals .row.loyalty-row  { color:#a16207; }
    .pos-cart-totals input[type=number] {
        width:100px; padding:3px 8px; font-size:12px;
        border:1px solid #e5e7eb; border-radius:4px; text-align:right;
    }
    .pos-due {
        font-size:22px; font-weight:800; color:#0d3b66; padding:12px 16px;
        background:#eff6ff; display:flex; justify-content:space-between; align-items:baseline;
    }
    .pos-payment { padding:14px 16px; }
    .pos-payment label { display:block; font-size:12px; color:#374151; margin-bottom:4px; font-weight:500; }
    .pos-change { margin-top:6px; padding:6px 10px; background:#dcfce7; color:#15803d;
                  border-radius:6px; font-size:13px; font-weight:600;
                  display:flex; justify-content:space-between; }
    .pos-short  { margin-top:6px; padding:6px 10px; background:#fee2e2; color:#b91c1c;
                  border-radius:6px; font-size:12px; }
    .btn-checkout {
        background:linear-gradient(135deg,#16a34a 0%, #15803d 100%);
        color:#fff; border:none; padding:14px; border-radius:8px; width:100%;
        font-size:15px; font-weight:700; cursor:pointer; margin-top:12px;
        transition:.15s; letter-spacing:.5px;
        box-shadow:0 2px 6px rgba(21,128,61,.25);
    }
    .btn-checkout:hover:not(:disabled) { transform:translateY(-1px); box-shadow:0 6px 14px rgba(21,128,61,.32); }
    .btn-checkout:disabled { opacity:.4; cursor:not-allowed; }
    .btn-clear {
        background:#fff; color:#dc2626; border:1px solid #fecaca; padding:8px;
        border-radius:6px; width:100%; font-size:13px; cursor:pointer; margin-top:6px;
    }
    .btn-clear:hover { background:#fef2f2; }

    .pos-receipt-box {
        margin:14px 16px; padding:14px;
        background:#f0fdf4; border:1px solid #86efac; border-radius:10px;
    }
    .pos-receipt-box .ok-label { font-weight:700; color:#15803d; font-size:14px; margin-bottom:8px; display:flex; align-items:center; gap:6px; }

    /* ============================== Favorites strip ============================== */
    .pos-favs-row {
        background:linear-gradient(135deg,#fffbeb 0%, #fef3c7 100%);
        border:1px solid #fcd34d; border-radius:10px; padding:10px 12px;
        display:flex; align-items:center; gap:10px;
    }
    .pos-favs-row .label {
        font-weight:700; color:#a16207; font-size:13px; white-space:nowrap;
        display:flex; align-items:center; gap:4px;
    }
    .pos-favs-scroll { display:flex; gap:8px; overflow-x:auto; flex:1; padding:2px; }
    .pos-favs-scroll::-webkit-scrollbar { height:6px; }
    .pos-fav-mini {
        background:#fff; border:1px solid #fcd34d; border-radius:8px;
        padding:6px 10px; cursor:pointer; transition:.15s; min-width:110px;
        text-align:left; flex-shrink:0;
    }
    .pos-fav-mini:hover { transform:translateY(-1px); box-shadow:0 4px 10px rgba(251,191,36,.3); }
    .pos-fav-mini .nm { font-size:12px; font-weight:600; color:#111827;
                       display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical;
                       overflow:hidden; }
    .pos-fav-mini .pr { font-size:13px; font-weight:700; color:#0d3b66; margin-top:2px; }
    .pos-fav-empty { color:#a16207; font-size:12px; font-style:italic; }

    .pos-tile .pin-btn {
        position:absolute; top:6px; right:6px;
        background:rgba(255,255,255,.9); border:none; border-radius:50%;
        width:24px; height:24px; cursor:pointer;
        font-size:12px; padding:0; line-height:1;
        box-shadow:0 1px 3px rgba(0,0,0,.1); opacity:0; transition:.15s;
    }
    .pos-tile:hover .pin-btn { opacity:1; }
    .pos-tile .pin-btn.pinned { opacity:1; background:#fef3c7; color:#a16207; }

    /* ============================== Keypad ============================== */
    .pos-keypad { padding:0 16px 14px; }
    .pos-keypad-quicks {
        display:grid; grid-template-columns:repeat(4, 1fr); gap:5px; margin-bottom:6px;
    }
    .pos-keypad-quicks button {
        background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; border-radius:6px;
        padding:8px 4px; font-size:12px; font-weight:600; cursor:pointer; transition:.1s;
    }
    .pos-keypad-quicks button:hover { background:#dbeafe; }
    .pos-keypad-quicks .exact { background:#dcfce7; color:#15803d; border-color:#86efac; }
    .pos-keypad-quicks .exact:hover { background:#bbf7d0; }
    .pos-keypad-grid {
        display:grid; grid-template-columns:repeat(3, 1fr); gap:5px;
    }
    .pos-keypad-grid button {
        background:#fff; border:1px solid #e5e7eb; border-radius:8px;
        padding:14px 0; font-size:18px; font-weight:700; cursor:pointer;
        color:#111827; transition:.1s;
    }
    .pos-keypad-grid button:hover  { background:#eff6ff; border-color:#1d4ed8; color:#1d4ed8; }
    .pos-keypad-grid button:active { transform:scale(.96); }
    .pos-keypad-grid .back { background:#fef2f2; color:#b91c1c; border-color:#fecaca; }
    .pos-keypad-grid .back:hover { background:#fee2e2; }
    .pos-keypad-grid .clear { background:#f3f4f6; color:#374151; font-size:13px; }
    .pos-keypad-grid .clear:hover { background:#e5e7eb; }
</style>

<!-- Hidden barcode-scanner input -->
<input id="barcodeInput"
       style="position:absolute;left:-9999px;top:-9999px;opacity:0;width:1px;"
       @onkeydown="OnBarcodeKeyDown"
       @bind="_barcodeBuffer"
       @bind:event="oninput"
       autocomplete="off" />

<div class="pos-shell">

    <!-- ============================== TOP BAR ============================== -->
    <div class="pos-topbar">
        <h3>🛒 Point of Sale</h3>

        <button class="icon-btn" @onclick="() => _showLocationPicker = true"
                title="Change selling location">
            🏪 @(_locationName ?? "Pick location")
        </button>

        @if (_customer != null)
        {
            <span class="pos-customer-pill">
                <span>👤 @_customer.FullName</span>
                @if (_customer.StoreCredit > 0 || _customer.LoyaltyPoints > 0)
                {
                    <span class="perks">
                        💳 Rs @_customer.StoreCredit.ToString("N0") · ⭐ @_customer.LoyaltyPoints pts
                    </span>
                }
                <button class="x-btn" @onclick="DetachCustomer" title="Detach">✕</button>
            </span>
        }
        else
        {
            <button class="icon-btn" @onclick="() => _showCustomerLookup = true">+ Attach customer</button>
        }

        <button class="icon-btn" @onclick="HoldSale" disabled="@(!_cart.Any() || _checking)">⏸ Hold</button>
        <button class="icon-btn" @onclick="ShowHeldDrawerAsync">
            📋 Held
            @if (_heldCount > 0) { <span class="badge">@_heldCount</span> }
        </button>
        <button class="icon-btn" @onclick="() => _showReturnLookup = true">↩ Return</button>
        <button class="icon-btn" @onclick="() => _showCashCountModal = true">📊 EOD</button>

        <!-- Separator dot so admin / logout sit visually apart from the sale-flow actions -->
        <span style="opacity:.4;font-size:18px;">·</span>

        <a class="icon-btn" href="/" title="Back to admin">⬅ Admin</a>
        <button class="icon-btn" @onclick="LogoutAsync" title="Sign out"
                style="background:rgba(248,113,113,.18);border-color:rgba(248,113,113,.35);">
            ⎋ Logout
        </button>
    </div>

    <!-- ============================== MAIN AREA ============================== -->
    <div class="pos-main">

        <!-- ============================== LEFT: PRODUCT PICKER ============================== -->
        <div class="pos-left">

            <!-- Search bar -->
            <div class="pos-search-row">
                <span class="search-icon">🔍</span>
                <input placeholder="Search SKU, barcode or product name..."
                       value="@_search"
                       @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />
                <span class="scan-hint">📷 Scanner active</span>
            </div>

            <!-- Favorites strip -->
            <div class="pos-favs-row">
                <span class="label">⭐ Favorites</span>
                <div class="pos-favs-scroll">
                    @if (!_favorites.Any())
                    {
                        <span class="pos-fav-empty">Hover a product and click ⭐ to pin it here for one-tap access.</span>
                    }
                    else
                    {
                        @foreach (var v in FavoriteVariants)
                        {
                            var oos = v.StockQuantity <= 0;
                            <div class="pos-fav-mini" @onclick="@(oos ? () => Toast.Show("Out of stock") : (Action)(() => AddToCart(v)))" title="@v.ProductName">
                                <div class="nm">@v.ProductName</div>
                                <div class="pr">Rs @v.Price.ToString("N0")</div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Category chips -->
            <div class="pos-cat-chips">
                <div class="pos-chip @(_selectedCategoryId == null ? "active" : "")"
                     @onclick="() => SelectCategory(null)">
                    All <span class="count">@_variants.Count</span>
                </div>
                @foreach (var cat in CategoryChips)
                {
                    <div class="pos-chip @(_selectedCategoryId == cat.Id ? "active" : "")"
                         @onclick="() => SelectCategory(cat.Id)">
                        @cat.Name <span class="count">@cat.Count</span>
                    </div>
                }
            </div>

            <!-- Product tile grid -->
            @if (!_variants.Any())
            {
                <div class="pos-empty">
                    <div style="font-size:32px;margin-bottom:8px;">📦</div>
                    <p>No products loaded.</p>
                </div>
            }
            else if (!FilteredVariants.Any())
            {
                <div class="pos-empty">
                    <div style="font-size:32px;margin-bottom:8px;">🔍</div>
                    <p>No products match your filter.</p>
                </div>
            }
            else
            {
                <div class="pos-tile-grid">
                    @foreach (var v in FilteredVariants.Take(120))
                    {
                        var oos = v.StockQuantity <= 0;
                        var stockClass = v.StockQuantity <= 0 ? "stock-out"
                                       : v.StockQuantity <= 5 ? "stock-low" : "stock-ok";
                        <div class="pos-tile @(oos ? "out-of-stock" : "")"
                             @onclick="@(oos ? () => Toast.Show("Out of stock") : (Action)(() => AddToCart(v)))">
                            <button class="pin-btn @(_favorites.Contains(v.Id) ? "pinned" : "")"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ToggleFavorite(v.Id)"
                                    title="@(_favorites.Contains(v.Id) ? "Unpin" : "Pin to favorites")">
                                @(_favorites.Contains(v.Id) ? "⭐" : "☆")
                            </button>
                            <div class="pos-tile-img">
                                @if (!string.IsNullOrEmpty(v.ImageUrl))
                                {
                                    <img src="@Api.Absolute(v.ImageUrl)" alt="@v.ProductName" />
                                }
                                else
                                {
                                    <span class="placeholder">📦</span>
                                }
                            </div>
                            <div class="pos-tile-name">@v.ProductName</div>
                            <div class="pos-tile-sku">@v.SKU</div>
                            <div class="pos-tile-bottom">
                                <span class="pos-tile-price">Rs @v.Price.ToString("N0")</span>
                                <span class="pos-stock-badge @stockClass">
                                    @(v.StockQuantity <= 0 ? "Out" : $"× {v.StockQuantity}")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ============================== RIGHT: CART ============================== -->
        <div class="pos-right">
            <div class="pos-cart">
                <div class="pos-cart-header">
                    <h4>🧾 Current Sale</h4>
                    <span class="pos-cart-count">@_cart.Sum(c => c.Quantity) items</span>
                </div>

                <div class="pos-cart-items">
                    @if (!_cart.Any())
                    {
                        <div style="padding:30px 10px;text-align:center;color:#9ca3af;">
                            <div style="font-size:32px;margin-bottom:8px;">🛒</div>
                            <p style="margin:0;font-size:13px;">Tap a product tile to add it.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in _cart)
                        {
                            <div class="pos-cart-item">
                                <div class="top-row">
                                    <div class="name">
                                        <div style="font-weight:600;">@item.SKU</div>
                                        <div class="price">Rs @item.UnitPrice.ToString("N2") each</div>
                                    </div>
                                    <div class="qty-stepper">
                                        <button @onclick="() => ChangeQty(item, -1)">−</button>
                                        <span class="qty">@item.Quantity</span>
                                        <button @onclick="() => ChangeQty(item, 1)">+</button>
                                    </div>
                                    <button class="remove-btn" @onclick="() => RemoveItem(item)" title="Remove">✕</button>
                                </div>
                                <div class="line-discount">
                                    <span style="color:#6b7785;">Disc Rs</span>
                                    <input type="number" min="0" step="1" @bind="item.LineDiscountAmount" />
                                    <span class="line-total">Rs @item.LineNet.ToString("N2")</span>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (_cart.Any())
                {
                    <div class="pos-cart-totals">
                        <div class="row">
                            <span>Subtotal</span>
                            <strong>Rs @ItemsSubtotal.ToString("N2")</strong>
                        </div>
                        @if (TaxTotal > 0)
                        {
                            <div class="row" style="color:#6b7785;">
                                <span>Sales tax</span>
                                <strong>Rs @TaxTotal.ToString("N2")</strong>
                            </div>
                        }
                        <div class="row discount-row">
                            <span>Order discount −</span>
                            <input type="number" min="0" step="1" @bind="_orderDiscount" />
                        </div>
                        @if (_customer != null && _customer.StoreCredit > 0)
                        {
                            <div class="row credit-row">
                                <span>Use store credit (max Rs @_customer.StoreCredit.ToString("N0"))</span>
                                <input type="number" min="0" max="@_customer.StoreCredit" step="1" @bind="_storeCreditRedeem" />
                            </div>
                        }
                        @if (_customer != null && _customer.LoyaltyPoints > 0)
                        {
                            <div class="row loyalty-row">
                                <span>Redeem ⭐ points (max @_customer.LoyaltyPoints)</span>
                                <input type="number" min="0" max="@_customer.LoyaltyPoints" step="1" @bind="_loyaltyRedeem" />
                            </div>
                        }
                    </div>

                    <div class="pos-due">
                        <span>AMOUNT DUE</span>
                        <span>Rs @AmountDue.ToString("N2")</span>
                    </div>

                    <div class="pos-payment">
                        <label>💵 Cash received</label>
                        <input class="input full" type="number" min="0" step="1"
                               placeholder="0" @bind="_paidAmount" @bind:event="oninput"
                               style="font-size:18px;font-weight:700;text-align:right;" />

                        @if (_paidAmount > 0 && _paidAmount >= AmountDue)
                        {
                            var change = _paidAmount - AmountDue;
                            <div class="pos-change">
                                <span>Change</span>
                                <strong>Rs @(change.ToString("N2"))</strong>
                            </div>

                            @* When there's change AND a real customer is attached,
                               ask whether the change was returned in cash or kept as credit. *@
                            @if (change > 0 && _customer != null)
                            {
                                <div style="margin-top:8px;padding:8px 10px;background:#f3f4f6;border-radius:6px;font-size:12px;">
                                    <div style="color:#374151;font-weight:600;margin-bottom:6px;">
                                        How was the Rs @change.ToString("N2") change handled?
                                    </div>
                                    <label style="display:flex;align-items:center;gap:6px;margin-bottom:4px;cursor:pointer;">
                                        <input type="radio" name="changeMode"
                                               checked="@(!_creditChangeAsCredit)"
                                               @onchange="() => _creditChangeAsCredit = false" />
                                        <span>💵 Returned in cash to customer</span>
                                    </label>
                                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
                                        <input type="radio" name="changeMode"
                                               checked="@_creditChangeAsCredit"
                                               @onchange="() => _creditChangeAsCredit = true" />
                                        <span>💳 Save as store credit (balance owed to customer)</span>
                                    </label>
                                </div>
                            }
                            else if (change > 0 && _customer == null)
                            {
                                <div style="margin-top:6px;font-size:11px;color:#6b7280;">
                                    Attach a customer to save change as store credit.
                                </div>
                            }
                        }
                        else if (_paidAmount > 0)
                        {
                            <div class="pos-short">
                                Short by Rs @((AmountDue - _paidAmount).ToString("N2"))
                            </div>
                        }

                        <button class="btn-checkout" @onclick="Checkout"
                                disabled="@(_checking || _paidAmount < AmountDue)">
                            @(_checking ? "Processing..." : "✓ Complete Sale")
                        </button>
                        <button class="btn-clear" @onclick="ClearCart">Clear cart</button>
                    </div>

                    <!-- ============================== Inline numeric keypad ============================== -->
                    <div class="pos-keypad">
                        <!-- Quick amounts -->
                        <div class="pos-keypad-quicks">
                            <button @onclick="() => AddQuickAmount(100)">+100</button>
                            <button @onclick="() => AddQuickAmount(500)">+500</button>
                            <button @onclick="() => AddQuickAmount(1000)">+1000</button>
                            <button class="exact" @onclick="SetExactCash">Exact</button>
                        </div>
                        <!-- 3x4 numpad -->
                        <div class="pos-keypad-grid">
                            <button @onclick="() => AppendDigit(7)">7</button>
                            <button @onclick="() => AppendDigit(8)">8</button>
                            <button @onclick="() => AppendDigit(9)">9</button>
                            <button @onclick="() => AppendDigit(4)">4</button>
                            <button @onclick="() => AppendDigit(5)">5</button>
                            <button @onclick="() => AppendDigit(6)">6</button>
                            <button @onclick="() => AppendDigit(1)">1</button>
                            <button @onclick="() => AppendDigit(2)">2</button>
                            <button @onclick="() => AppendDigit(3)">3</button>
                            <button class="clear" @onclick="ClearCash">Clear</button>
                            <button @onclick="() => AppendDigit(0)">0</button>
                            <button class="back" @onclick="BackspaceCash">⌫</button>
                        </div>
                    </div>
                }

                @if (_lastReceipt != null)
                {
                    <div class="pos-receipt-box">
                        <div class="ok-label">✅ Sale Complete</div>
                        <div id="receipt-printable">
                            <h3 style="text-align:center;margin:0 0 8px;">RetailSuite</h3>
                            <p style="text-align:center;margin:0 0 4px;font-size:12px;">@DateTime.Now.ToString("dd MMM yyyy HH:mm")</p>
                            <hr />
                            @foreach (var item in _lastReceipt.Items)
                            {
                                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:2px;">
                                    <span>@item.SKU × @item.Qty</span>
                                    <span>Rs @item.LineTotal.ToString("N2")</span>
                                </div>
                            }
                            <hr />
                            <div style="display:flex;justify-content:space-between;font-size:12px;">
                                <span>Subtotal</span><span>Rs @_lastReceipt.ItemsSubtotal.ToString("N2")</span>
                            </div>
                            @if (_lastReceipt.OrderDiscount > 0)
                            {
                                <div style="display:flex;justify-content:space-between;font-size:12px;color:#a16207;">
                                    <span>Discount</span><span>− Rs @_lastReceipt.OrderDiscount.ToString("N2")</span>
                                </div>
                            }
                            @if (_lastReceipt.StoreCreditUsed > 0)
                            {
                                <div style="display:flex;justify-content:space-between;font-size:12px;color:#15803d;">
                                    <span>Store credit</span><span>− Rs @_lastReceipt.StoreCreditUsed.ToString("N2")</span>
                                </div>
                            }
                            @if (_lastReceipt.LoyaltyUsed > 0)
                            {
                                <div style="display:flex;justify-content:space-between;font-size:12px;color:#15803d;">
                                    <span>Loyalty redeemed</span><span>− Rs @_lastReceipt.LoyaltyUsed.ToString("N2")</span>
                                </div>
                            }
                            @if (_lastReceipt.Tax > 0)
                            {
                                <div style="display:flex;justify-content:space-between;font-size:12px;">
                                    <span>Tax</span><span>Rs @_lastReceipt.Tax.ToString("N2")</span>
                                </div>
                            } 
                            <hr />
                            <div style="display:flex;justify-content:space-between;font-weight:700;">
                                <span>Total</span><span>Rs @_lastReceipt.Total.ToString("N2")</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;font-size:13px;">
                                <span>Paid</span><span>Rs @_lastReceipt.Paid.ToString("N2")</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;color:#15803d;font-weight:700;">
                                <span>Change</span><span>Rs @_lastReceipt.Change.ToString("N2")</span>
                            </div>
                            <hr />
                            <p style="text-align:center;font-size:11px;color:#6b7280;">Thank you for shopping!</p>
                        </div>
                        <div style="display:flex;gap:8px;margin-top:12px;">
                            <button class="btn btn-primary" style="flex:1;" @onclick="PrintReceipt">🖨 Print</button>
                            <button class="btn" style="flex:1;" @onclick="StartNewSale">New sale</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ========= Location-picker modal ========= -->
<Modal Visible="@_showLocationPicker" OnClose="() => _showLocationPicker = false">
    <h3 style="margin-bottom:10px;">Selling location</h3>
    <p style="color:#6b7280;font-size:13px;margin-top:0;">
        Pick which branch this terminal is selling from. Stored on this device only.
    </p>
    @if (_availableLocations == null)
    {
        <div class="spinner"></div>
    }
    else if (!_availableLocations.Any())
    {
        <p style="color:#b91c1c;">No active locations configured. Add one under Settings → Locations.</p>
    }
    else
    {
        @foreach (var loc in _availableLocations)
        {
            <label style="display:flex;align-items:center;gap:8px;padding:10px;
                          border:1px solid @(_locationId == loc.Id ? "#1d4ed8" : "#e5e7eb");
                          border-radius:8px;margin-bottom:6px;cursor:pointer;">
                <input type="radio" name="loc"
                       checked="@(_locationId == loc.Id)"
                       @onchange="() => PickLocation(loc)" />
                <div style="flex:1;">
                    <strong>@loc.Name</strong>
                    <span style="margin-left:8px;font-family:monospace;color:#6b7280;font-size:11px;">@loc.Code</span>
                    @if (loc.IsDefault) { <span style="margin-left:6px;font-size:10px;background:#dbeafe;color:#1d4ed8;padding:1px 5px;border-radius:3px;">DEFAULT</span> }
                </div>
            </label>
        }
    }
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:10px;">
        <button class="btn btn-primary" @onclick="() => _showLocationPicker = false">Done</button>
    </div>
</Modal>

<!-- ========= Customer-lookup / quick-add modal ========= -->
<Modal Visible="@_showCustomerLookup" OnClose="CloseCustomerLookup">
    <h3 style="margin-bottom:12px;">Attach customer</h3>
    <p style="color:#6b7785;font-size:13px;margin-top:0;">
        Search by phone or CNIC. If they're new, you can register them right here with just name + phone.
    </p>
    <input class="input full" placeholder="Phone or CNIC"
           @bind="_lookupQuery"
           @bind:event="oninput"
           style="margin-bottom:8px;" />
    <div style="display:flex;gap:8px;">
        <button class="btn btn-primary" @onclick="DoCustomerLookup">Lookup</button>
        <button class="btn" @onclick="CloseCustomerLookup">Cancel</button>
    </div>

    @if (_lookupNotFound)
    {
        <div style="margin-top:14px;padding:12px;background:#fef3c7;border:1px solid #fcd34d;border-radius:8px;">
            <p style="margin:0 0 8px;font-size:13px;color:#a16207;font-weight:600;">
                No customer matched — register a new one?
            </p>
            <label style="font-size:11px;color:#6b7280;">Customer name *</label>
            <input class="input full" placeholder="Full name" @bind="_quickName" style="margin-bottom:6px;" />
            <label style="font-size:11px;color:#6b7280;">Phone *</label>
            <input class="input full" placeholder="03xx-xxxxxxx" @bind="_quickPhone" style="margin-bottom:10px;" />
            <button class="btn btn-primary" disabled="@_quickAdding" @onclick="DoCustomerQuickAdd">
                @(_quickAdding ? "Adding..." : "+ Add & attach")
            </button>
        </div>
    }
    else if (_lookupError != null)
    {
        <div style="margin-top:10px;color:#b91c1c;font-size:13px;">@_lookupError</div>
    }
</Modal>

<!-- ========= Held sales drawer ========= -->
<Modal Visible="@_showHeldDrawer" OnClose="() => _showHeldDrawer = false">
    <h3 style="margin-bottom:12px;">Held sales</h3>
    @if (_heldSales == null || !_heldSales.Any())
    {
        <p style="color:#9ca3af;">No held sales.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Label</th><th>Phone</th><th>Held at</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var h in _heldSales)
                {
                    <tr>
                        <td>@h.Label</td>
                        <td>@(h.CustomerPhone ?? "—")</td>
                        <td>@h.CreatedAt.ToString("HH:mm")</td>
                        <td style="text-align:right;">
                            <button class="btn btn-primary" style="padding:4px 10px;font-size:12px;"
                                    @onclick="() => ResumeHeld(h.Id)">Resume</button>
                            <button class="btn btn-danger" style="padding:4px 10px;font-size:12px;"
                                    @onclick="() => DiscardHeld(h.Id)">Discard</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <div style="margin-top:12px;">
        <button class="btn" @onclick="() => _showHeldDrawer = false">Close</button>
    </div>
</Modal>

<!-- ========= Return lookup modal ========= -->
<Modal Visible="@_showReturnLookup" OnClose="() => _showReturnLookup = false">
    <h3 style="margin-bottom:12px;">Find sale to return</h3>
    <div style="display:flex;gap:6px;margin-bottom:10px;">
        <input class="input" style="flex:1;" placeholder="Order # or customer phone"
               @bind="_returnQuery" />
        <button class="btn btn-primary" @onclick="DoReturnLookup">Search</button>
    </div>
    @if (_returnResults != null && _returnResults.Any())
    {
        <table class="table" style="margin:0;">
            <thead><tr><th>Order #</th><th>Total</th><th>When</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in _returnResults)
                {
                    <tr>
                        <td style="font-family:monospace;">@r.OrderNumber</td>
                        <td>Rs @r.TotalAmount.ToString("N2")</td>
                        <td>@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td style="text-align:right;">
                            <button class="btn btn-danger" style="padding:4px 10px;font-size:12px;"
                                    @onclick="() => ProcessReturn(r)">Refund full</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (_returnResults != null)
    {
        <p style="color:#9ca3af;">No matches.</p>
    }
    <div style="margin-top:12px;">
        <button class="btn" @onclick="() => _showReturnLookup = false">Close</button>
    </div>
</Modal>

<!-- ========= End-of-day cash count modal (Z report) ========= -->
<Modal Visible="@_showCashCountModal" OnClose="() => _showCashCountModal = false">
    <h3 style="margin-bottom:12px;">End-of-day close</h3>
    <p style="color:#6b7785;font-size:13px;margin-top:0;">
        Count the cash physically in the drawer and enter it below.
        We'll compare it to today's expected cash from completed sales.
    </p>

    <label style="display:block;font-size:12px;color:#6b7785;margin-bottom:4px;">Opening float (Rs)</label>
    <input class="input full" type="number" min="0" step="1" @bind="_openingFloat" style="margin-bottom:8px;" />

    <label style="display:block;font-size:12px;color:#6b7785;margin-bottom:4px;">Counted cash (Rs)</label>
    <input class="input full" type="number" min="0" step="1" @bind="_countedCash" style="margin-bottom:12px;" />

    <div style="display:flex;gap:8px;">
        <button class="btn btn-primary" @onclick="RunZReport">Generate Z report</button>
        <button class="btn" @onclick="() => _showCashCountModal = false">Cancel</button>
    </div>

    @if (_zReport != null)
    {
        <div style="margin-top:14px;padding:12px;background:#f9fafb;border-radius:6px;font-size:13px;">
            <div style="display:flex;justify-content:space-between;"><span>Date</span><strong>@_zReport.Date</strong></div>
            <div style="display:flex;justify-content:space-between;"><span>Sales</span><strong>@_zReport.SalesCount</strong></div>
            <div style="display:flex;justify-content:space-between;"><span>Expected cash</span><strong>Rs @_zReport.ExpectedCash.ToString("N2")</strong></div>
            <div style="display:flex;justify-content:space-between;"><span>Counted cash</span><strong>Rs @_zReport.CountedCash.ToString("N2")</strong></div>
            <hr/>
            <div style="display:flex;justify-content:space-between;color:@(_zReport.Variance == 0 ? "#15803d" : _zReport.Variance > 0 ? "#a16207" : "#b91c1c");">
                <span>Variance (@_zReport.VarianceState)</span>
                <strong>Rs @_zReport.Variance.ToString("N2")</strong>
            </div>
        </div>
    }
</Modal>

@code {
    List<VariantDto> _variants = new();
    List<CartItem>   _cart     = new();
    string           _search   = string.Empty;
    Guid?            _selectedCategoryId;
    decimal          _paidAmount;
    bool             _creditChangeAsCredit;  // cashier kept the change as store credit
    decimal          _orderDiscount;
    decimal          _storeCreditRedeem;
    int              _loyaltyRedeem;
    bool             _checking;
    Receipt?         _lastReceipt;

    // Customer attach
    CustomerLookupDto? _customer;
    bool   _showCustomerLookup;
    string _lookupQuery = "";
    string? _lookupError;
    bool   _lookupNotFound;
    string _quickName = "";
    string _quickPhone = "";
    bool   _quickAdding;

    // Held sales
    bool _showHeldDrawer;
    List<HeldSummary>? _heldSales;
    int _heldCount;
    Guid? _resumedFromId;

    // Return lookup
    bool _showReturnLookup;
    string _returnQuery = "";
    List<ReturnOrderDto>? _returnResults;

    // EOD cash count / Z report
    bool _showCashCountModal;
    decimal _openingFloat;
    decimal _countedCash;
    ZReportDto? _zReport;

    // Barcode scanner debounce
    string _barcodeBuffer = "";
    System.Timers.Timer? _barcodeTimer;

    // Favorites — per-user via localStorage
    const string FAV_KEY = "pos_favorites";
    HashSet<Guid> _favorites = new();

    // Selling location — per-terminal via localStorage
    const string LOC_KEY = "pos_location_id";
    Guid? _locationId;
    string _locationName = "";
    List<LocationOption>? _availableLocations;
    bool _showLocationPicker;

    // -------------------------------------------------------------------
    // Computed
    // -------------------------------------------------------------------
    IEnumerable<VariantDto> FilteredVariants
    {
        get
        {
            IEnumerable<VariantDto> q = _variants;
            if (_selectedCategoryId.HasValue)
                q = q.Where(v => v.CategoryId == _selectedCategoryId.Value);
            if (!string.IsNullOrWhiteSpace(_search))
                q = q.Where(v =>
                    v.SKU.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || v.ProductName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || (v.Barcode != null && v.Barcode.Contains(_search, StringComparison.OrdinalIgnoreCase)));
            return q;
        }
    }

    /// <summary>Derive a chip list (id, name, count) from the loaded variants.</summary>
    IEnumerable<CategoryChip> CategoryChips =>
        _variants
            .Where(v => v.CategoryId.HasValue && !string.IsNullOrEmpty(v.CategoryName))
            .GroupBy(v => new { v.CategoryId, v.CategoryName })
            .Select(g => new CategoryChip
            {
                Id    = g.Key.CategoryId!.Value,
                Name  = g.Key.CategoryName!,
                Count = g.Count()
            })
            .OrderBy(c => c.Name);

    decimal ItemsSubtotal => _cart.Sum(c => c.LineNet);

    /// <summary>Sales tax per line — server-side Order.TotalAmount includes this, so the till must too.</summary>
    decimal TaxTotal => _cart.Sum(c => c.LineNet * c.TaxRate);

    decimal LoyaltyRupees =>
        _customer == null ? 0m : (decimal)_loyaltyRedeem * _customer.LoyaltyPointValue;

    /// <summary>
    /// What the cashier needs to collect in cash. Formula mirrors the server's
    /// <c>Order.AmountDueAfterRedemptions</c>:
    ///   (sum of LineNet + per-line tax) − order-discount − store-credit − loyalty-rupees
    /// </summary>
    decimal AmountDue
    {
        get
        {
            var subtotalWithTax    = ItemsSubtotal + TaxTotal;
            var afterOrderDiscount = Math.Max(0, subtotalWithTax - _orderDiscount);
            var afterCredit        = Math.Max(0, afterOrderDiscount - _storeCreditRedeem);
            var afterLoyalty       = Math.Max(0, afterCredit - LoyaltyRupees);
            return afterLoyalty;
        }
    }

    void SelectCategory(Guid? id) => _selectedCategoryId = id;

    /// <summary>The variants the user has pinned, in the original load order.</summary>
    IEnumerable<VariantDto> FavoriteVariants =>
        _variants.Where(v => _favorites.Contains(v.Id));

    // ---- Favorites: load / toggle / persist via localStorage --------------
    async Task LoadFavoritesAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", FAV_KEY);
            if (!string.IsNullOrEmpty(raw))
            {
                var ids = JsonSerializer.Deserialize<List<Guid>>(raw);
                if (ids != null) _favorites = new HashSet<Guid>(ids);
            }
        }
        catch { /* localStorage unavailable on first prerender — silent */ }
    }

    async Task SaveFavoritesAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(_favorites.ToList());
            await JS.InvokeVoidAsync("localStorage.setItem", FAV_KEY, json);
        }
        catch { }
    }

    async Task ToggleFavorite(Guid variantId)
    {
        if (!_favorites.Add(variantId)) _favorites.Remove(variantId);
        await SaveFavoritesAsync();
    }

    // ---- Numeric keypad helpers -------------------------------------------
    /// <summary>Append a digit to the cash-received amount (treats it as an integer rupee value).</summary>
    void AppendDigit(int digit)
    {
        // Shift existing value up by 10 and add the new digit — simple and predictable.
        var current = (long)_paidAmount;
        var next    = current * 10 + digit;
        if (next > 99_999_999) return;  // sanity cap
        _paidAmount = next;
    }

    void BackspaceCash() => _paidAmount = (long)_paidAmount / 10;
    void ClearCash() => _paidAmount = 0;
    void AddQuickAmount(decimal amt) => _paidAmount += amt;
    void SetExactCash() => _paidAmount = AmountDue;

    // -------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadLocationsAsync();
        await LoadVariants();
        await LoadHeldCount();
        await LoadFavoritesAsync();
        StateHasChanged();
        try { await JS.InvokeVoidAsync("focusBarcodeInput"); } catch { }
    }

    /// <summary>Load the tenant's locations and restore the per-terminal pick from localStorage.</summary>
    async Task LoadLocationsAsync()
    {
        try
        {
            var json = await Http.GetStringAsync("api/locations?active=true");
            using var doc = JsonDocument.Parse(json);
            _availableLocations = new();
            if (doc.RootElement.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Array)
            {
                foreach (var e in d.EnumerateArray())
                {
                    _availableLocations.Add(new LocationOption
                    {
                        Id        = e.GetProperty("id").GetGuid(),
                        Code      = e.GetProperty("code").GetString() ?? "",
                        Name      = e.GetProperty("name").GetString() ?? "",
                        IsDefault = e.GetProperty("isDefault").GetBoolean()
                    });
                }
            }

            // Restore previously-picked location for this terminal, or fall back to default.
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", LOC_KEY);
                if (!string.IsNullOrEmpty(stored) && Guid.TryParse(stored, out var lid))
                {
                    var match = _availableLocations.FirstOrDefault(l => l.Id == lid);
                    if (match != null) { _locationId = match.Id; _locationName = match.Name; }
                }
            }
            catch { /* localStorage unavailable on prerender */ }

            if (!_locationId.HasValue)
            {
                var def = _availableLocations.FirstOrDefault(l => l.IsDefault) ?? _availableLocations.FirstOrDefault();
                if (def != null) { _locationId = def.Id; _locationName = def.Name; }
            }
        }
        catch { /* non-fatal */ }
    }

    async Task PickLocation(LocationOption loc)
    {
        _locationId   = loc.Id;
        _locationName = loc.Name;
        try { await JS.InvokeVoidAsync("localStorage.setItem", LOC_KEY, loc.Id.ToString()); } catch { }
        // Reload products so the picker shows the new branch's stock badges.
        await LoadVariants();
    }

    public void Dispose() => _barcodeTimer?.Dispose();

    // -------------------------------------------------------------------
    // Products
    // -------------------------------------------------------------------
    async Task LoadVariants()
    {
        try
        {
            // We still hit /products/variants for catalogue data (image, category, taxRate);
            // stock per the selected location is overlaid after via /inventory/all?locationId=.
            var json = await Http.GetStringAsync("api/products/variants");
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            var dataEl = root.TryGetProperty("data", out var d) ? d : root;
            _variants.Clear();
            if (dataEl.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in dataEl.EnumerateArray())
                {
                    _variants.Add(new VariantDto
                    {
                        Id            = item.TryGetProperty("id",            out var id)  ? id.GetGuid()      : Guid.Empty,
                        SKU           = item.TryGetProperty("sku",           out var sk)  ? sk.GetString()!   : "—",
                        Barcode       = item.TryGetProperty("barcode",       out var bc)  ? bc.GetString()    : null,
                        Price         = item.TryGetProperty("price",         out var pr)  ? pr.GetDecimal()   : 0,
                        TaxRate       = item.TryGetProperty("taxRate",       out var tr)  ? tr.GetDecimal()   : 0,
                        StockQuantity = item.TryGetProperty("stockQuantity", out var sq)  ? sq.GetInt32()     : 0,
                        ProductName   = item.TryGetProperty("productName",   out var pn)  ? pn.GetString()!   : "",
                        ImageUrl      = item.TryGetProperty("imageUrl",      out var iu) && iu.ValueKind == JsonValueKind.String ? iu.GetString() : null,
                        CategoryId    = item.TryGetProperty("categoryId",    out var ci) && ci.ValueKind == JsonValueKind.String ? ci.GetGuid()    : (Guid?)null,
                        CategoryName  = item.TryGetProperty("categoryName",  out var cn) && cn.ValueKind == JsonValueKind.String ? cn.GetString() : null
                    });
                }
            }
        }
        catch (Exception ex) { Toast.Show($"Could not load products: {ex.Message}"); }

        // Overlay per-location stock if a location is selected — the variants endpoint
        // returns the rollup; the picker tiles should reflect the active branch.
        if (_locationId.HasValue && _variants.Any())
        {
            try
            {
                var url = $"api/inventory/all?page=1&pageSize=500&locationId={_locationId}";
                var json = await Http.GetStringAsync(url);
                using var doc = JsonDocument.Parse(json);
                if (doc.RootElement.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array)
                {
                    var byId = _variants.ToDictionary(v => v.Id);
                    foreach (var i in items.EnumerateArray())
                    {
                        var id = i.GetProperty("id").GetGuid();
                        if (byId.TryGetValue(id, out var v))
                            v.StockQuantity = i.GetProperty("currentStock").GetInt32();
                    }
                }
            }
            catch { /* non-fatal — fall back to rollup numbers */ }
        }

        StateHasChanged();
    }

    // -------------------------------------------------------------------
    // Cart
    // -------------------------------------------------------------------
    void AddToCart(VariantDto v)
    {
        var existing = _cart.FirstOrDefault(c => c.VariantId == v.Id);
        if (existing != null) existing.Quantity++;
        else _cart.Add(new CartItem
        {
            VariantId = v.Id, SKU = v.SKU,
            UnitPrice = v.Price, Quantity = 1,
            TaxRate = v.TaxRate
        });
    }

    void ChangeQty(CartItem item, int delta)
    {
        item.Quantity += delta;
        if (item.Quantity <= 0) _cart.Remove(item);
    }

    void RemoveItem(CartItem item) => _cart.Remove(item);

    void ClearCart()
    {
        _cart.Clear();
        _orderDiscount = 0;
        _storeCreditRedeem = 0;
        _loyaltyRedeem = 0;
        _paidAmount = 0;
        _creditChangeAsCredit = false;
        _resumedFromId = null;
    }

    void StartNewSale()
    {
        _lastReceipt = null;
        ClearCart();
        DetachCustomer();
    }

    // -------------------------------------------------------------------
    // Customer attach
    // -------------------------------------------------------------------
    async Task DoCustomerLookup()
    {
        _lookupError = null;
        _lookupNotFound = false;
        if (string.IsNullOrWhiteSpace(_lookupQuery))
        {
            _lookupError = "Enter a phone or CNIC.";
            return;
        }

        // Try phone first, then CNIC.
        var url = $"api/sales/customer-lookup?phone={Uri.EscapeDataString(_lookupQuery)}";
        var resp = await Http.GetAsync(url);
        if (!resp.IsSuccessStatusCode)
        {
            _lookupError = "Lookup failed.";
            return;
        }

        var json = await resp.Content.ReadAsStringAsync();
        using var doc = JsonDocument.Parse(json);
        if (!doc.RootElement.TryGetProperty("data", out var d) || d.ValueKind != JsonValueKind.Object)
        {
            // Try CNIC.
            url = $"api/sales/customer-lookup?cnic={Uri.EscapeDataString(_lookupQuery)}";
            resp = await Http.GetAsync(url);
            json = await resp.Content.ReadAsStringAsync();
            using var doc2 = JsonDocument.Parse(json);
            if (!doc2.RootElement.TryGetProperty("data", out d) || d.ValueKind != JsonValueKind.Object)
            {
                // Surface the quick-add panel with the lookup value pre-filled in the phone field
                // (most likely a phone, since CNIC paths are rarely typed at the till).
                _lookupNotFound = true;
                _quickName  = "";
                _quickPhone = _lookupQuery.Trim();
                return;
            }
        }

        _customer = new CustomerLookupDto
        {
            Id            = d.GetProperty("id").GetGuid(),
            FullName      = d.GetProperty("fullName").GetString() ?? "",
            Email         = d.TryGetProperty("email", out var e) ? e.GetString() : null,
            Phone         = d.TryGetProperty("phone", out var p) ? p.GetString() : null,
            StoreCredit   = d.GetProperty("storeCredit").GetDecimal(),
            LoyaltyPoints = d.GetProperty("loyaltyPoints").GetInt32(),
            LoyaltyPointValue = d.GetProperty("loyaltyRupeesValue").GetInt32() == 0
                ? 1m
                : d.GetProperty("loyaltyRupeesValue").GetDecimal() / Math.Max(1, d.GetProperty("loyaltyPoints").GetInt32())
        };

        _showCustomerLookup = false;
        _lookupQuery = "";
        _lookupNotFound = false;
        Toast.Show($"Attached: {_customer.FullName}");
    }

    async Task DoCustomerQuickAdd()
    {
        if (string.IsNullOrWhiteSpace(_quickName) || string.IsNullOrWhiteSpace(_quickPhone))
        {
            Toast.Show("Name and phone are required.");
            return;
        }

        _quickAdding = true;
        try
        {
            var body = new { name = _quickName.Trim(), phone = _quickPhone.Trim() };
            var resp = await Http.PostAsJsonAsync("api/sales/customer-quick-add", body);
            if (!resp.IsSuccessStatusCode)
            {
                Toast.Show($"Add failed: {await resp.Content.ReadAsStringAsync()}");
                return;
            }

            var json = await resp.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(json);
            var d = doc.RootElement.GetProperty("data");

            _customer = new CustomerLookupDto
            {
                Id                = d.GetProperty("id").GetGuid(),
                FullName          = d.GetProperty("fullName").GetString() ?? "",
                Email             = d.TryGetProperty("email", out var e) ? e.GetString() : null,
                Phone             = d.TryGetProperty("phone", out var p) ? p.GetString() : null,
                StoreCredit       = 0m,
                LoyaltyPoints     = 0,
                LoyaltyPointValue = 1m
            };

            CloseCustomerLookup();
            Toast.Show($"Attached: {_customer.FullName}");
        }
        finally { _quickAdding = false; }
    }

    void CloseCustomerLookup()
    {
        _showCustomerLookup = false;
        _lookupQuery   = "";
        _lookupError   = null;
        _lookupNotFound = false;
        _quickName     = "";
        _quickPhone    = "";
    }

    void DetachCustomer()
    {
        _customer = null;
        _storeCreditRedeem = 0;
        _loyaltyRedeem = 0;
    }

    // -------------------------------------------------------------------
    // Hold sale
    // -------------------------------------------------------------------
    async Task HoldSale()
    {
        if (!_cart.Any()) return;

        var body = new
        {
            label = "POS hold",
            customerId = _customer?.Id,
            customerPhone = _customer?.Phone,
            orderDiscountAmount = _orderDiscount,
            items = _cart.Select(c => new
            {
                productVariantId   = c.VariantId,
                sku                = c.SKU,
                quantity           = c.Quantity,
                unitPrice          = c.UnitPrice,
                lineDiscountAmount = c.LineDiscountAmount,
                taxRate            = c.TaxRate
            }).ToList()
        };

        var resp = await Http.PostAsJsonAsync("api/sales/hold", body);
        if (resp.IsSuccessStatusCode)
        {
            Toast.Show("Sale held.");
            ClearCart();
            await LoadHeldCount();
        }
        else Toast.Show("Hold failed.");
    }

    async Task LoadHeldCount()
    {
        try
        {
            var json = await Http.GetStringAsync("api/sales/held");
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Array)
                _heldCount = d.GetArrayLength();
        }
        catch { _heldCount = 0; }
    }

    async Task LoadHeldSales()
    {
        _heldSales = new();
        try
        {
            var json = await Http.GetStringAsync("api/sales/held");
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Array)
            {
                foreach (var e in d.EnumerateArray())
                {
                    _heldSales.Add(new HeldSummary
                    {
                        Id            = e.GetProperty("id").GetGuid(),
                        Label         = e.GetProperty("label").GetString() ?? "",
                        CustomerPhone = e.TryGetProperty("customerPhone", out var ph) ? ph.GetString() : null,
                        CreatedAt     = e.GetProperty("createdAt").GetDateTime()
                    });
                }
            }
        }
        catch { }
    }

    async Task ResumeHeld(Guid id)
    {
        var json = await Http.GetStringAsync($"api/sales/held/{id}");
        using var doc = JsonDocument.Parse(json);
        var d = doc.RootElement.GetProperty("data");

        ClearCart();
        _resumedFromId = id;
        _orderDiscount = d.GetProperty("orderDiscountAmount").GetDecimal();

        if (d.TryGetProperty("items", out var items))
        {
            foreach (var it in items.EnumerateArray())
            {
                _cart.Add(new CartItem
                {
                    VariantId          = it.GetProperty("variantId").GetGuid(),
                    SKU                = it.GetProperty("sku").GetString() ?? "",
                    UnitPrice          = it.GetProperty("unitPrice").GetDecimal(),
                    Quantity           = it.GetProperty("quantity").GetInt32(),
                    LineDiscountAmount = it.GetProperty("lineDiscountAmount").GetDecimal(),
                    TaxRate            = it.GetProperty("taxRate").GetDecimal()
                });
            }
        }

        _showHeldDrawer = false;
        Toast.Show("Resumed sale.");
        StateHasChanged();
    }

    async Task DiscardHeld(Guid id)
    {
        var resp = await Http.DeleteAsync($"api/sales/held/{id}");
        if (resp.IsSuccessStatusCode)
        {
            Toast.Show("Discarded.");
            await LoadHeldSales();
            await LoadHeldCount();
        }
    }

    // -------------------------------------------------------------------
    // Return lookup
    // -------------------------------------------------------------------
    async Task DoReturnLookup()
    {
        _returnResults = new();
        if (string.IsNullOrWhiteSpace(_returnQuery)) return;

        var url = $"api/sales/return-lookup?orderNumber={Uri.EscapeDataString(_returnQuery)}&phone={Uri.EscapeDataString(_returnQuery)}";
        var json = await Http.GetStringAsync(url);
        using var doc = JsonDocument.Parse(json);
        if (doc.RootElement.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Array)
        {
            foreach (var e in d.EnumerateArray())
            {
                _returnResults.Add(new ReturnOrderDto
                {
                    Id          = e.GetProperty("id").GetGuid(),
                    OrderNumber = e.GetProperty("orderNumber").GetString() ?? "",
                    TotalAmount = e.GetProperty("totalAmount").GetDecimal(),
                    CreatedAt   = e.GetProperty("createdAt").GetDateTime()
                });
            }
        }
    }

    async Task ProcessReturn(ReturnOrderDto r)
    {
        var body = new { items = new object[0] };  // empty = refund full order
        var resp = await Http.PostAsJsonAsync($"api/orders/{r.Id}/return", body);
        if (resp.IsSuccessStatusCode)
        {
            Toast.Show($"Refund processed for {r.OrderNumber}.");
            _showReturnLookup = false;
        }
        else Toast.Show("Refund failed.");
    }

    // -------------------------------------------------------------------
    // EOD / Z report
    // -------------------------------------------------------------------
    async Task RunZReport()
    {
        var body = new
        {
            cashierId = (Guid?)null,
            date = (DateTime?)null,
            openingFloat = _openingFloat,
            countedCash = _countedCash
        };
        var resp = await Http.PostAsJsonAsync("api/reports/cashier-z", body);
        if (!resp.IsSuccessStatusCode) { Toast.Show("Z-report failed."); return; }

        var json = await resp.Content.ReadAsStringAsync();
        using var doc = JsonDocument.Parse(json);
        var d = doc.RootElement.GetProperty("data");
        _zReport = new ZReportDto
        {
            Date          = d.GetProperty("date").GetString() ?? "",
            SalesCount    = d.GetProperty("salesCount").GetInt32(),
            ExpectedCash  = d.GetProperty("expectedCash").GetDecimal(),
            CountedCash   = d.GetProperty("countedCash").GetDecimal(),
            Variance      = d.GetProperty("variance").GetDecimal(),
            VarianceState = d.GetProperty("varianceState").GetString() ?? ""
        };
    }

    // -------------------------------------------------------------------
    // Checkout
    // -------------------------------------------------------------------
    async Task Checkout()
    {
        if (!_cart.Any()) return;
        if (_paidAmount < AmountDue) { Toast.Show("Insufficient cash."); return; }

        _checking = true;
        StateHasChanged();

        var body = new
        {
            customerId            = _customer?.Id,
            paidAmount            = AmountDue,
            orderDiscountAmount   = _orderDiscount,
            storeCreditRedeem     = _storeCreditRedeem,
            loyaltyPointsRedeem   = _loyaltyRedeem,
            resumedFromHeldSaleId = _resumedFromId,
            locationId            = _locationId,
            creditChangeAsStoreCredit = _creditChangeAsCredit,
            items = _cart.Select(c => new
            {
                productVariantId   = c.VariantId,
                quantity           = c.Quantity,
                lineDiscountAmount = c.LineDiscountAmount
            }).ToList()
        };

        try
        {
            var resp = await Http.PostAsJsonAsync("api/sales/checkout", body);
            if (!resp.IsSuccessStatusCode)
            {
                var msg = await resp.Content.ReadAsStringAsync();
                Toast.Show($"Checkout failed: {msg}");
                return;
            }

            _lastReceipt = new Receipt
            {
                Items           = _cart.Select(c => new ReceiptItem { SKU = c.SKU, Qty = c.Quantity, LineTotal = c.LineNet }).ToList(),
                ItemsSubtotal   = ItemsSubtotal,
                OrderDiscount   = _orderDiscount,
                StoreCreditUsed = _storeCreditRedeem,
                LoyaltyUsed     = LoyaltyRupees,
                Tax             = _cart.Sum(c => c.LineNet * c.TaxRate),
                Total           = AmountDue,
                Paid            = _paidAmount,
                Change          = _paidAmount - AmountDue
            };

            ClearCart();
            await LoadVariants();   // refresh stock after sale
            await LoadHeldCount();
            Toast.Show("Sale complete!");
        }
        catch (Exception ex) { Toast.Show($"Error: {ex.Message}"); }
        finally { _checking = false; StateHasChanged(); }
    }

    async Task PrintReceipt()
    {
        try { await JS.InvokeVoidAsync("printReceipt"); } catch { }
    }

    // -------------------------------------------------------------------
    // Barcode scanner
    // -------------------------------------------------------------------
    void OnBarcodeKeyDown(KeyboardEventArgs e)
    {
        _barcodeTimer?.Dispose();
        _barcodeTimer = new System.Timers.Timer(300);
        _barcodeTimer.Elapsed += (_, _) =>
        {
            _barcodeTimer?.Dispose();
            _barcodeTimer = null;
            if (_barcodeBuffer.Length > 2)
            {
                var code = _barcodeBuffer.Trim();
                var match = _variants.FirstOrDefault(v =>
                    v.SKU.Equals(code, StringComparison.OrdinalIgnoreCase)
                 || (v.Barcode != null && v.Barcode.Equals(code, StringComparison.OrdinalIgnoreCase)));
                if (match != null) InvokeAsync(() => { AddToCart(match); StateHasChanged(); });
            }
            _barcodeBuffer = "";
        };
        _barcodeTimer.AutoReset = false;
        _barcodeTimer.Start();
    }

    async Task ShowHeldDrawerAsync()
    {
        await LoadHeldSales();
        _showHeldDrawer = true;
    }

    async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    // -------------------------------------------------------------------
    // DTOs
    // -------------------------------------------------------------------
    class VariantDto
    {
        public Guid    Id { get; set; }
        public string  SKU { get; set; } = "";
        public string? Barcode { get; set; }
        public decimal Price { get; set; }
        public decimal TaxRate { get; set; }
        public int     StockQuantity { get; set; }
        public string  ProductName { get; set; } = "";
        public string? ImageUrl { get; set; }
        public Guid?   CategoryId { get; set; }
        public string? CategoryName { get; set; }
    }

    class CategoryChip
    {
        public Guid   Id    { get; set; }
        public string Name  { get; set; } = "";
        public int    Count { get; set; }
    }

    class LocationOption
    {
        public Guid    Id { get; set; }
        public string  Code { get; set; } = "";
        public string  Name { get; set; } = "";
        public bool    IsDefault { get; set; }
    }

    class CartItem
    {
        public Guid    VariantId { get; set; }
        public string  SKU { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public int     Quantity { get; set; }
        public decimal TaxRate { get; set; }
        public decimal LineDiscountAmount { get; set; }
        public decimal LineGross => UnitPrice * Quantity;
        public decimal LineNet   => Math.Max(0, LineGross - LineDiscountAmount);
    }

    class CustomerLookupDto
    {
        public Guid     Id { get; set; }
        public string   FullName { get; set; } = "";
        public string?  Email { get; set; }
        public string?  Phone { get; set; }
        public decimal  StoreCredit { get; set; }
        public int      LoyaltyPoints { get; set; }
        public decimal  LoyaltyPointValue { get; set; } = 1m;
    }

    class HeldSummary
    {
        public Guid     Id { get; set; }
        public string   Label { get; set; } = "";
        public string?  CustomerPhone { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    class ReturnOrderDto
    {
        public Guid     Id { get; set; }
        public string   OrderNumber { get; set; } = "";
        public decimal  TotalAmount { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    class ZReportDto
    {
        public string  Date { get; set; } = "";
        public int     SalesCount { get; set; }
        public decimal ExpectedCash { get; set; }
        public decimal CountedCash { get; set; }
        public decimal Variance { get; set; }
        public string  VarianceState { get; set; } = "";
    }

    class Receipt
    {
        public List<ReceiptItem> Items { get; set; } = new();
        public decimal ItemsSubtotal { get; set; }
        public decimal OrderDiscount { get; set; }
        public decimal StoreCreditUsed { get; set; }
        public decimal LoyaltyUsed { get; set; }
        public decimal Tax { get; set; }
        public decimal Total { get; set; }
        public decimal Paid { get; set; }
        public decimal Change { get; set; }
    }

    class ReceiptItem
    {
        public string SKU { get; set; } = "";
        public int    Qty { get; set; }
        public decimal LineTotal { get; set; }
    }
}

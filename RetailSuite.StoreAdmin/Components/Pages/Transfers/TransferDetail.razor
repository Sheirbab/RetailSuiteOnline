@page "/{TenantSlug}/admin/inventory/transfers/{Id:guid}"
@inherits AdminPageBase
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json

<PermissionGuard Code="INVENTORY_TRANSFER" />

@if (_loading)
{
    <div class="spinner"></div>
}
else if (_t == null)
{
    <div class="card">
        <p style="color:#b91c1c;">Transfer not found.</p>
        <a class="btn" href="@($"/{TenantSlug}/admin/inventory/transfers")">← Back</a>
    </div>
}
else
{
    <!-- Header -->
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;">
        <div>
            <a class="btn" style="font-size:12px;padding:3px 10px;margin-bottom:8px;"
               href="@($"/{TenantSlug}/admin/inventory/transfers")">← All transfers</a>
            <h3 style="margin:0;">
                @_t.TransferNumber
                <span style="font-size:12px;padding:3px 10px;border-radius:6px;background:@StatusBg(_t.Status);color:@StatusFg(_t.Status);margin-left:8px;">
                    @_t.Status
                </span>
            </h3>
            <p style="margin:4px 0 0;color:#6b7280;font-size:13px;">
                <strong>@_t.SourceName</strong>
                <span style="color:#9ca3af;"> → </span>
                <strong>@_t.DestinationName</strong>
                · Created @_t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
            </p>
        </div>
        <div style="display:flex;gap:6px;">
            @if (_t.Status == "Draft")
            {
                <button class="btn btn-primary" disabled="@_busy" @onclick="Submit">Submit (deduct from source)</button>
                <button class="btn btn-danger"  disabled="@_busy" @onclick="Cancel">Cancel</button>
            }
            @if (_t.Status == "InTransit")
            {
                <button class="btn btn-primary" disabled="@_busy" @onclick="Receive">✓ Receive at destination</button>
                <button class="btn btn-danger"  disabled="@_busy" @onclick="Cancel">Cancel (restore source)</button>
            }
        </div>
    </div>

    <!-- Items -->
    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
            <h4 style="margin:0;">Items</h4>
            @if (_t.Status == "Draft")
            {
                <button class="btn btn-primary" @onclick="OpenAddLine">+ Add line</button>
            }
        </div>

        @if (!_t.Items.Any())
        {
            <p style="color:#9ca3af;">No lines yet.</p>
        }
        else
        {
            <table class="table" style="margin:0;">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Qty</th>
                        <th>Unit cost</th>
                        <th>Line total</th>
                        <th>Notes</th>
                        @if (_t.Status == "Draft") { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in _t.Items)
                    {
                        <tr>
                            <td style="font-family:monospace;">@i.Sku</td>
                            <td>@i.Quantity</td>
                            <td>Rs @i.UnitCost.ToString("N2")</td>
                            <td>Rs @i.LineTotal.ToString("N2")</td>
                            <td style="color:#6b7280;font-size:12px;">@(i.Notes ?? "—")</td>
                            @if (_t.Status == "Draft")
                            {
                                <td style="text-align:right;">
                                    <button class="btn btn-danger" style="padding:3px 8px;font-size:11px;"
                                            @onclick="() => RemoveLine(i.Id)">✕</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background:#f9fafb;font-weight:700;">
                        <td colspan="3" style="text-align:right;">TOTAL VALUE</td>
                        <td colspan="3">Rs @_t.TotalValue.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>

    @if (!string.IsNullOrEmpty(_t.Notes))
    {
        <div class="card" style="margin-top:14px;background:#f9fafb;">
            <strong>Notes</strong>
            <p style="margin:6px 0 0;color:#374151;font-size:13px;white-space:pre-wrap;">@_t.Notes</p>
        </div>
    }
}

<!-- ============================ Add-line modal ============================ -->
<Modal Visible="@_showAddLine" OnClose="() => _showAddLine = false">
    <h3 style="margin-bottom:12px;">Add transfer line</h3>

    <label style="font-size:12px;color:#6b7280;">Search SKU or product *</label>
    <input class="input full" placeholder="Type SKU or name..."
           value="@_variantSearch"
           @oninput="OnVariantSearch" style="margin-bottom:4px;" />
    @if (!string.IsNullOrEmpty(_variantSearch) && _variantMatches.Any())
    {
        <div style="max-height:160px;overflow-y:auto;border:1px solid #e5e7eb;border-radius:6px;margin-bottom:8px;">
            @foreach (var v in _variantMatches.Take(20))
            {
                <div style="padding:6px 10px;cursor:pointer;border-bottom:1px solid #f3f4f6;
                            background:@(_selectedVariantId == v.Id ? "#dbeafe" : "transparent");"
                     @onclick="() => SelectVariant(v)">
                    <strong>@v.Sku</strong>
                    <span style="color:#6b7280;margin-left:6px;">@v.ProductName</span>
                    <span style="float:right;color:#374151;font-size:12px;">@v.StockQuantity in total</span>
                </div>
            }
        </div>
    }
    @if (_selectedVariantId.HasValue)
    {
        <div style="background:#dbeafe;padding:6px 10px;border-radius:6px;margin-bottom:10px;font-size:13px;">
            Selected: <strong>@_selectedVariantSku</strong>
        </div>
    }

    <label style="font-size:12px;color:#6b7280;">Quantity *</label>
    <input class="input full" type="number" min="1" @bind="_lineQty" style="margin-bottom:8px;" />

    <label style="font-size:12px;color:#6b7280;">Notes (optional)</label>
    <input class="input full" @bind="_lineNotes"
           placeholder="e.g. 'fragile'" style="margin-bottom:12px;" />

    <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button class="btn" @onclick="() => _showAddLine = false">Cancel</button>
        <button class="btn btn-primary" disabled="@_busy" @onclick="AddLine">Add line</button>
    </div>
</Modal>

@code {
    [Parameter] public Guid Id { get; set; }

    bool _loading = true;
    bool _busy;
    TransferDto? _t;

    // Add-line modal
    bool _showAddLine;
    string _variantSearch = "";
    List<VariantDto> _variantMatches = new();
    List<VariantDto>? _allVariants;
    Guid? _selectedVariantId;
    string _selectedVariantSku = "";
    int _lineQty = 1;
    string _lineNotes = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadVariants();
            await Load();
        }
    }

    async Task Load()
    {
        _loading = true; StateHasChanged();
        try
        {
            var json = await Http.GetStringAsync($"api/inventory-transfers/{Id}");
            using var doc = JsonDocument.Parse(json);
            var d = doc.RootElement.GetProperty("data");
            _t = new TransferDto
            {
                Id              = d.GetProperty("id").GetGuid(),
                TransferNumber  = d.GetProperty("transferNumber").GetString() ?? "",
                SourceName      = d.TryGetProperty("sourceName", out var sn) ? (sn.GetString() ?? "—") : "—",
                DestinationName = d.TryGetProperty("destinationName", out var dn) ? (dn.GetString() ?? "—") : "—",
                Status          = d.GetProperty("status").GetString() ?? "",
                Notes           = d.TryGetProperty("notes", out var n) && n.ValueKind == JsonValueKind.String ? n.GetString() : null,
                TotalValue      = d.GetProperty("totalValue").GetDecimal(),
                CreatedAt       = d.GetProperty("createdAt").GetDateTime(),
                Items           = new()
            };
            foreach (var i in d.GetProperty("items").EnumerateArray())
            {
                _t.Items.Add(new LineDto
                {
                    Id        = i.GetProperty("id").GetGuid(),
                    Sku       = i.GetProperty("sku").GetString() ?? "",
                    Quantity  = i.GetProperty("quantity").GetInt32(),
                    UnitCost  = i.GetProperty("unitCost").GetDecimal(),
                    LineTotal = i.GetProperty("lineTotal").GetDecimal(),
                    Notes     = i.TryGetProperty("notes", out var ln) && ln.ValueKind == JsonValueKind.String ? ln.GetString() : null
                });
            }
        }
        catch (Exception ex) { Toast.Show($"Load failed: {ex.Message}"); }
        finally { _loading = false; StateHasChanged(); }
    }

    async Task LoadVariants()
    {
        try
        {
            var json = await Http.GetStringAsync("api/products/variants");
            using var doc = JsonDocument.Parse(json);
            _allVariants = new();
            var data = doc.RootElement.TryGetProperty("data", out var d) ? d : doc.RootElement;
            if (data.ValueKind == JsonValueKind.Array)
            {
                foreach (var v in data.EnumerateArray())
                {
                    _allVariants.Add(new VariantDto
                    {
                        Id            = v.GetProperty("id").GetGuid(),
                        Sku           = v.GetProperty("sku").GetString() ?? "",
                        ProductName   = v.TryGetProperty("productName", out var pn) ? pn.GetString() ?? "" : "",
                        StockQuantity = v.TryGetProperty("stockQuantity", out var sq) ? sq.GetInt32() : 0
                    });
                }
            }
        }
        catch { }
    }

    void OnVariantSearch(ChangeEventArgs e)
    {
        _variantSearch = e.Value?.ToString() ?? "";
        if (_allVariants == null) return;
        _variantMatches = string.IsNullOrWhiteSpace(_variantSearch)
            ? new()
            : _allVariants.Where(v =>
                v.Sku.Contains(_variantSearch, StringComparison.OrdinalIgnoreCase)
             || v.ProductName.Contains(_variantSearch, StringComparison.OrdinalIgnoreCase))
              .Take(20).ToList();
    }

    void SelectVariant(VariantDto v)
    {
        _selectedVariantId  = v.Id;
        _selectedVariantSku = v.Sku;
        _variantMatches.Clear();
        _variantSearch = $"{v.Sku} — {v.ProductName}";
    }

    void OpenAddLine()
    {
        _selectedVariantId = null; _selectedVariantSku = "";
        _variantSearch = ""; _variantMatches.Clear();
        _lineQty = 1; _lineNotes = "";
        _showAddLine = true;
    }

    async Task AddLine()
    {
        if (!_selectedVariantId.HasValue) { Toast.Show("Pick a product."); return; }
        if (_lineQty <= 0) { Toast.Show("Quantity must be positive."); return; }

        _busy = true;
        try
        {
            var body = new
            {
                productVariantId = _selectedVariantId.Value,
                quantity         = _lineQty,
                notes            = string.IsNullOrWhiteSpace(_lineNotes) ? null : _lineNotes
            };
            var resp = await Http.PostAsJsonAsync($"api/inventory-transfers/{Id}/items", body);
            if (!resp.IsSuccessStatusCode)
            {
                Toast.Show($"Add line failed: {await resp.Content.ReadAsStringAsync()}");
                return;
            }
            _showAddLine = false;
            await Load();
        }
        finally { _busy = false; }
    }

    async Task RemoveLine(Guid lineId)
    {
        var resp = await Http.DeleteAsync($"api/inventory-transfers/{Id}/items/{lineId}");
        if (resp.IsSuccessStatusCode) await Load();
        else Toast.Show("Remove failed.");
    }

    async Task Submit()  => await Action("submit",  "Submitted. Stock deducted from source.");
    async Task Receive() => await Action("receive", "Received. Stock added at destination.");
    async Task Cancel()  => await Action("cancel",  "Cancelled.");

    async Task Action(string verb, string okMessage)
    {
        _busy = true;
        try
        {
            var resp = await Http.PostAsync($"api/inventory-transfers/{Id}/{verb}", null);
            if (!resp.IsSuccessStatusCode)
            {
                Toast.Show($"{verb} failed: {await resp.Content.ReadAsStringAsync()}");
                return;
            }
            Toast.Show(okMessage);
            await Load();
        }
        finally { _busy = false; }
    }

    static string StatusBg(string s) => s switch
    {
        "Draft"     => "#f3f4f6",
        "InTransit" => "#fef3c7",
        "Received"  => "#dcfce7",
        "Cancelled" => "#fee2e2",
        _ => "#f3f4f6"
    };
    static string StatusFg(string s) => s switch
    {
        "Draft"     => "#374151",
        "InTransit" => "#a16207",
        "Received"  => "#15803d",
        "Cancelled" => "#b91c1c",
        _ => "#374151"
    };

    class TransferDto
    {
        public Guid          Id              { get; set; }
        public string        TransferNumber  { get; set; } = "";
        public string        SourceName      { get; set; } = "";
        public string        DestinationName { get; set; } = "";
        public string        Status          { get; set; } = "";
        public string?       Notes           { get; set; }
        public decimal       TotalValue      { get; set; }
        public DateTime      CreatedAt       { get; set; }
        public List<LineDto> Items           { get; set; } = new();
    }
    class LineDto
    {
        public Guid    Id        { get; set; }
        public string  Sku       { get; set; } = "";
        public int     Quantity  { get; set; }
        public decimal UnitCost  { get; set; }
        public decimal LineTotal { get; set; }
        public string? Notes     { get; set; }
    }
    class VariantDto
    {
        public Guid   Id { get; set; }
        public string Sku { get; set; } = "";
        public string ProductName { get; set; } = "";
        public int    StockQuantity { get; set; }
    }
}

@page "/{TenantSlug}/admin/accounting/trial-balance"
@inherits AdminPageBase
@inject HttpClient Http
@inject ToastService Toast
@using System.Text.Json

<PermissionGuard Code="ACCOUNTING" />

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
    <div>
        <h3 style="margin:0;">Trial Balance</h3>
        <p style="margin:4px 0 0;color:#6b7280;font-size:13px;">
            Debit and credit balance of every account as of the chosen date. Totals must match.
        </p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        <label style="font-size:12px;color:#6b7280;">As of</label>
        <input type="date" @bind="AsOf" @bind:event="onchange"
               style="padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;" />
        <button class="btn btn-primary" @onclick="Load" style="padding:6px 14px;">Refresh</button>
    </div>
</div>

@if (_data == null)
{
    <div class="spinner"></div>
}
else
{
    <div class="card" style="margin-bottom:14px;">
        <div class="kpi-grid">
            <div class="kpi @(_data.InBalance ? "kpi-good" : "kpi-bad")">
                <div class="kpi-label">Status</div>
                <div class="kpi-value">@(_data.InBalance ? "✓ In balance" : "✗ Out of balance")</div>
            </div>
            <div class="kpi">
                <div class="kpi-label">Total debit</div>
                <div class="kpi-value">Rs @_data.TotalDebit.ToString("N2")</div>
            </div>
            <div class="kpi">
                <div class="kpi-label">Total credit</div>
                <div class="kpi-value">Rs @_data.TotalCredit.ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="card">
        <table class="table tb-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Account</th>
                    <th>Type</th>
                    <th class="num">Debit</th>
                    <th class="num">Credit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _data.Rows)
                {
                    <tr>
                        <td style="font-family:monospace;">@r.Code</td>
                        <td>
                            <a href="@($"/{TenantSlug}/admin/accounting/account/{r.AccountId}")">@r.Name</a>
                        </td>
                        <td>
                            <span class="type-chip type-@(r.AccountType.ToLower())">@r.AccountType</span>
                        </td>
                        <td class="num">@(r.DebitBalance == 0 ? "—" : "Rs " + r.DebitBalance.ToString("N2"))</td>
                        <td class="num">@(r.CreditBalance == 0 ? "—" : "Rs " + r.CreditBalance.ToString("N2"))</td>
                    </tr>
                }
                <tr style="border-top:2px solid #0f172a;font-weight:700;">
                    <td colspan="3" style="text-align:right;">Totals:</td>
                    <td class="num">Rs @_data.TotalDebit.ToString("N2")</td>
                    <td class="num">Rs @_data.TotalCredit.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>
}

<style>
    .kpi-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; }
    .kpi { background:#f9fafb; border:1px solid #e5e7eb; border-radius:10px; padding:14px 16px; }
    .kpi-label { font-size:12px; color:#6b7280; text-transform:uppercase; letter-spacing:.04em; }
    .kpi-value { font-size:22px; font-weight:700; color:#0f172a; margin-top:4px; }
    .kpi-good  { background:#dcfce7; }
    .kpi-good  .kpi-value { color:#15803d; }
    .kpi-bad   { background:#fee2e2; }
    .kpi-bad   .kpi-value { color:#b91c1c; }

    .tb-table .num { text-align:right; font-variant-numeric:tabular-nums; }
    .type-chip { font-size:11px; padding:2px 8px; border-radius:999px; font-weight:600; }
    .type-asset     { background:#dbeafe; color:#1d4ed8; }
    .type-liability { background:#fee2e2; color:#b91c1c; }
    .type-equity    { background:#e0e7ff; color:#4338ca; }
    .type-revenue   { background:#dcfce7; color:#15803d; }
    .type-expense   { background:#fef3c7; color:#a16207; }
</style>

@code {
    DateTime AsOf { get; set; } = DateTime.Today;
    TbData? _data;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Load();
    }

    async Task Load()
    {
        try
        {
            var url = $"api/gl/trial-balance?asOf={AsOf:yyyy-MM-dd}";
            var json = await Http.GetStringAsync(url);
            using var doc = JsonDocument.Parse(json);
            var d = doc.RootElement.GetProperty("data");
            _data = new TbData
            {
                AsOf        = d.GetProperty("asOf").GetString() ?? "",
                TotalDebit  = d.GetProperty("totalDebit").GetDecimal(),
                TotalCredit = d.GetProperty("totalCredit").GetDecimal(),
                InBalance   = d.GetProperty("inBalance").GetBoolean(),
                Rows        = new()
            };
            foreach (var r in d.GetProperty("rows").EnumerateArray())
            {
                _data.Rows.Add(new TbRow
                {
                    AccountId     = r.GetProperty("accountId").GetGuid(),
                    Code          = r.GetProperty("code").GetString() ?? "",
                    Name          = r.GetProperty("name").GetString() ?? "",
                    AccountType   = r.GetProperty("accountType").GetString() ?? "",
                    DebitBalance  = r.GetProperty("debitBalance").GetDecimal(),
                    CreditBalance = r.GetProperty("creditBalance").GetDecimal()
                });
            }
            StateHasChanged();
        }
        catch (Exception ex) { Toast.Show($"Load failed: {ex.Message}"); }
    }

    class TbData
    {
        public string  AsOf { get; set; } = "";
        public decimal TotalDebit { get; set; }
        public decimal TotalCredit { get; set; }
        public bool    InBalance { get; set; }
        public List<TbRow> Rows { get; set; } = new();
    }
    class TbRow
    {
        public Guid   AccountId { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string AccountType { get; set; } = "";
        public decimal DebitBalance { get; set; }
        public decimal CreditBalance { get; set; }
    }
}

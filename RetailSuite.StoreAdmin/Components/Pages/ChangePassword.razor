@page "/change-password"
@layout LoginLayout
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json
@using RetailSuite.StoreAdmin.Shared

<div class="login-card" style="max-width:380px;">
    <h2 style="margin-bottom:6px;">Change your password</h2>
    <p class="subtitle">
        Your admin set a temporary password for you. Pick a new one to continue.
    </p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:6px;padding:10px;margin-bottom:10px;color:#b91c1c;font-size:13px;">
            @_error
        </div>
    }

    <label style="font-size:12px;color:#6b7280;">Current (temporary) password</label>
    <input class="input full" type="password" @bind="_current" placeholder="••••••••" />

    <label style="font-size:12px;color:#6b7280;">New password (min 8 characters)</label>
    <input class="input full" type="password" @bind="_new1" placeholder="••••••••" />

    <label style="font-size:12px;color:#6b7280;">Repeat new password</label>
    <input class="input full" type="password" @bind="_new2" placeholder="••••••••" />

    <button class="btn btn-primary full" style="margin-top:6px;"
            disabled="@_busy" @onclick="Submit">
        @(_busy ? "Updating..." : "Change password")
    </button>
</div>

@code {
    string _current = "";
    string _new1 = "";
    string _new2 = "";
    bool _busy;
    string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Auth.InitializeAsync();
        if (!Auth.IsAuthenticated)
            Nav.NavigateTo("/login", replace: true);
    }

    async Task Submit()
    {
        _error = null;
        if (_new1.Length < 8) { _error = "New password must be at least 8 characters."; return; }
        if (_new1 != _new2)   { _error = "Passwords don't match.";                       return; }

        _busy = true;
        try
        {
            var body = new { currentPassword = _current, newPassword = _new1 };
            var resp = await Http.PostAsJsonAsync("api/me/change-password", body);
            if (!resp.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
                _error = doc.RootElement.TryGetProperty("message", out var m) ? m.GetString() : "Change failed.";
                return;
            }

            Toast.Show("Password changed. Welcome!");
            await Auth.LoadPermissionsAsync();   // refresh MustChangePassword=false
            Nav.NavigateTo("/", replace: true);
        }
        finally { _busy = false; }
    }
}

@page "/"
@inject HttpClient Http
@using System.Text.Json

<h3 style="margin-bottom:24px;">Dashboard</h3>

@if (_loading)
{
    <div class="spinner"></div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:28px;">

        <div class="card stat-card">
            <div class="stat-label">Products</div>
            <div class="stat-value">@_totalProducts</div>
        </div>

        <div class="card stat-card">
            <div class="stat-label">Inventory Value</div>
            <div class="stat-value">Rs @_inventoryValue.ToString("N0")</div>
        </div>

        <div class="card stat-card">
            <div class="stat-label">Today's Sales</div>
            <div class="stat-value">@_todaySales</div>
            <div class="stat-sub">Rs @_todayRevenue.ToString("N0") revenue</div>
        </div>

        <div class="card stat-card @(_lowStockCount > 0 ? "stat-warning" : "")">
            <div class="stat-label">Low Stock Alerts</div>
            <div class="stat-value">@_lowStockCount</div>
            @if (_lowStockCount > 0)
            {
                <div class="stat-sub"><a href="/inventory">View inventory →</a></div>
            }
        </div>

    </div>

    @if (_lowStockItems.Any())
    {
        <div class="card" style="margin-bottom:24px;">
            <h4 style="margin-bottom:12px;">⚠️ Low Stock Items</h4>
            <table class="table">
                <thead>
                    <tr><th>Product</th><th>SKU</th><th>Stock</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in _lowStockItems)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td style="font-family:monospace;">@item.SKU</td>
                            <td style="color:#dc2626;font-weight:600;">@item.Stock</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="card" style="color:#b91c1c;margin-bottom:16px;">⚠️ @_error</div>
    }

    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a href="/pos"       class="btn btn-primary">Open POS Terminal</a>
        <a href="/products"  class="btn">Manage Products</a>
        <a href="/inventory" class="btn">Inventory</a>
        <a href="/orders"    class="btn">Orders</a>
        <a href="/customers" class="btn">Customers</a>
    </div>
}

@code {
    bool    _loading        = true;
    string? _error;
    int     _totalProducts  = 0;
    decimal _inventoryValue = 0;
    int     _todaySales     = 0;
    decimal _todayRevenue   = 0;
    int     _lowStockCount  = 0;

    record LowStockItem(string ProductName, string SKU, int Stock);
    List<LowStockItem> _lowStockItems = new();

    // -----------------------------------------------------------------------
    // OnAfterRenderAsync — JS / HttpClient Bearer token are available here.
    // MainLayout calls Auth.InitializeAsync() in its own OnAfterRenderAsync
    // before this fires, so the token is already set on the HttpClient.
    // -----------------------------------------------------------------------
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Load();
    }

    async Task Load()
    {
        _loading = true;
        _error   = null;

        try
        {
            // Run all three API calls in parallel
            var productsTask  = LoadProducts();
            var inventoryTask = LoadInventoryStats();
            var salesTask     = LoadTodaySales();

            await Task.WhenAll(productsTask, inventoryTask, salesTask);
        }
        catch (Exception ex)
        {
            _error = $"Dashboard load error: {ex.Message}";
        }

        _loading = false;
        StateHasChanged();
    }

    // GET /api/products?page=1&pageSize=1  → ApiResponse<{ Total, Items }>
    async Task LoadProducts()
    {
        var json = await Http.GetStringAsync("api/products?page=1&pageSize=1");
        using var doc = JsonDocument.Parse(json);
        var root   = doc.RootElement;
        var dataEl = root.TryGetProperty("data", out var d) ? d : root;
        if (dataEl.TryGetProperty("total", out var total))
            _totalProducts = total.GetInt32();
    }

    // GET /api/reports/inventory  → { totalStockValue, lowStockCount, items: [...] }
    async Task LoadInventoryStats()
    {
        var json = await Http.GetStringAsync("api/reports/inventory");
        using var doc  = JsonDocument.Parse(json);
        var root   = doc.RootElement;
        var dataEl = root.TryGetProperty("data", out var d) ? d : root;

        if (dataEl.TryGetProperty("totalStockValue", out var tv))
            _inventoryValue = tv.GetDecimal();

        if (dataEl.TryGetProperty("lowStockCount", out var lsc))
            _lowStockCount = lsc.GetInt32();

        _lowStockItems.Clear();
        if (dataEl.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in items.EnumerateArray())
            {
                var stock = item.TryGetProperty("currentStock", out var cs) ? cs.GetInt32() : 0;
                var threshold = item.TryGetProperty("lowStockThreshold", out var thr) ? thr.GetInt32() : 5;
                if (stock <= threshold)
                {
                    _lowStockItems.Add(new LowStockItem(
                        item.TryGetProperty("productName", out var pn) ? pn.GetString() ?? "—" : "—",
                        item.TryGetProperty("sku",         out var sk) ? sk.GetString() ?? "—" : "—",
                        stock
                    ));
                }
            }
        }
    }

    // GET /api/reports/sales?from=today&to=today  → { totalOrders, totalRevenue }
    async Task LoadTodaySales()
    {
        var today = DateTime.UtcNow.ToString("yyyy-MM-dd");
        var json  = await Http.GetStringAsync($"api/reports/sales?from={today}&to={today}");
        using var doc  = JsonDocument.Parse(json);
        var root   = doc.RootElement;
        var dataEl = root.TryGetProperty("data", out var d) ? d : root;

        if (dataEl.TryGetProperty("totalOrders",  out var to)) _todaySales   = to.GetInt32();
        if (dataEl.TryGetProperty("totalRevenue", out var tr)) _todayRevenue = tr.GetDecimal();
    }
}

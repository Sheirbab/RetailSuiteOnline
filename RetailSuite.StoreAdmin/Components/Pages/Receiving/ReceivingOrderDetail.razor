@page "/{TenantSlug}/admin/receiving-orders/{Id:guid}"
@inherits AdminPageBase
@inject HttpClient Http
@inject ToastService Toast
@inject NavigationManager Nav
@using System.Text.Json

<PermissionGuard Code="RECEIVING_ORDERS" />

<div style="display:flex;align-items:center;gap:16px;margin-bottom:14px;">
    <h3 style="margin:0;">@(order?.OrderNumber ?? "Receiving order")</h3>
    <a class="btn" href="@($"/{TenantSlug}/admin/receiving-orders")">&larr; Back</a>
</div>

@if (isLoading)
{
    <div class="spinner"></div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="card" style="color:#b91c1c;">⚠️ @_error</div>
}
else if (order != null)
{
    <div class="card" style="margin-bottom:16px;">
        <div style="display:flex;gap:24px;flex-wrap:wrap;">
            <div><strong>Status:</strong> @StatusBadge(order.Status)</div>
            <div><strong>Expected total:</strong> Rs @order.ExpectedTotal.ToString("N2")</div>
            <div><strong>Received total:</strong> Rs @order.ReceivedTotal.ToString("N2")</div>
            @if (_appliedCredit > 0)
            {
                <div style="color:#15803d;">
                    <strong>Credit applied:</strong> − Rs @_appliedCredit.ToString("N2")
                </div>
                <div>
                    <strong>Net payable:</strong> Rs @(Math.Max(0, order.ReceivedTotal - _appliedCredit).ToString("N2"))
                </div>
            }
            @if (!string.IsNullOrEmpty(order.SupplierReference))
            {
                <div><strong>Supplier ref:</strong> @order.SupplierReference</div>
            }
        </div>

        <!-- Lifecycle actions -->
        <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;">
            @if (order.Status == "Draft")
            {
                <button class="btn btn-primary" @onclick="SubmitAsync"
                        disabled="@(order.Items.Count == 0)">Submit (lock for receiving)</button>
                <button class="btn btn-danger" @onclick="CancelAsync">Cancel</button>
            }
            else if (order.Status == "Open" || order.Status == "PartiallyReceived")
            {
                <button class="btn btn-danger" @onclick="CancelAsync">Cancel</button>
                <button class="btn" @onclick="CloseAsync">Force close (short)</button>
            }
        </div>
    </div>

    <!-- Lines table -->
    <div class="card" style="margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
            <h4 style="margin:0;">Line items</h4>
            @if (CanReceive)
            {
                <button class="btn btn-primary"
                        disabled="@(selectedLineIds.Count == 0)"
                        @onclick="ReceiveSelectedAsync">
                    Receive selected (@selectedLineIds.Count)
                </button>
            }
        </div>

        @if (order.Items.Count == 0)
        {
            <p style="color:#9ca3af;">No items yet. Add some below.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        @if (CanReceive)
                        {
                            <th style="width:32px;">
                                <input type="checkbox"
                                       checked="@AllOutstandingSelected"
                                       @onchange="e => ToggleAllOutstanding((bool)e.Value!)" />
                            </th>
                        }
                        <th>SKU</th>
                        <th>Expected</th>
                        <th>Received</th>
                        <th>Outstanding</th>
                        @if (CanReceive)
                        {
                            <th>Receive qty</th>
                        }
                        <th>Unit cost</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ln in order.Items)
                    {
                        <tr>
                            @if (CanReceive)
                            {
                                <td>
                                    @if (ln.OutstandingQuantity > 0)
                                    {
                                        <input type="checkbox"
                                               checked="@selectedLineIds.Contains(ln.Id)"
                                               @onchange="e => ToggleLine(ln.Id, (bool)e.Value!)" />
                                    }
                                </td>
                            }
                            <td style="font-family:monospace;">@ln.Sku</td>
                            <td>@ln.ExpectedQuantity</td>
                            <td><strong>@ln.ReceivedQuantity</strong></td>
                            <td>@ln.OutstandingQuantity</td>
                            @if (CanReceive)
                            {
                                <td>
                                    @if (ln.OutstandingQuantity > 0)
                                    {
                                        <input class="input" type="number"
                                               min="1" max="@ln.OutstandingQuantity"
                                               style="width:90px;"
                                               @bind="lineQtyInputs[ln.Id]" />
                                    }
                                </td>
                            }
                            <td>Rs @ln.UnitCost.ToString("N2")</td>
                            <td>@ln.Status</td>
                            <td style="text-align:right;">
                                @if (order.Status == "Draft")
                                {
                                    <button class="btn btn-danger" style="padding:4px 10px;font-size:12px;"
                                            @onclick="() => RemoveLineAsync(ln.Id)">Remove</button>
                                }
                                else if (CanReceive && ln.OutstandingQuantity > 0)
                                {
                                    <button class="btn btn-primary" style="padding:4px 10px;font-size:12px;"
                                            @onclick="() => OpenReceiveModal(ln)">Receive…</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- ============================================================
         Per-line receive modal — opens from the "Receive…" button
         on a row. Shows Expected / Already received / Outstanding,
         lets the user enter a partial qty, warns on short receipts,
         and captures notes (line.SetNotes server-side).
         ============================================================ -->
    <Modal Visible="@receiveModalOpen" OnClose="CloseReceiveModal">
        @if (modalLine != null)
        {
            <h3 style="margin-bottom:6px;">Receive line</h3>
            <p style="color:#6b7785;font-size:13px;margin-top:0;">
                <strong style="font-family:monospace;">@modalLine.Sku</strong>
                · unit cost Rs @modalLine.UnitCost.ToString("N2")
            </p>

            <div style="display:flex;gap:20px;flex-wrap:wrap;margin-bottom:14px;padding:10px;background:#f9fafb;border-radius:6px;">
                <div><span style="color:#6b7785;font-size:12px;">Expected</span><br/><strong>@modalLine.ExpectedQuantity</strong></div>
                <div><span style="color:#6b7785;font-size:12px;">Already received</span><br/><strong>@modalLine.ReceivedQuantity</strong></div>
                <div><span style="color:#6b7785;font-size:12px;">Outstanding</span><br/><strong style="color:#a16207;">@modalLine.OutstandingQuantity</strong></div>
            </div>

            <label style="display:block;font-size:12px;color:#6b7785;margin-bottom:4px;">Receive quantity</label>
            <input class="input full" type="number"
                   min="1" max="@modalLine.OutstandingQuantity"
                   @bind="modalQty" style="margin-bottom:8px;" />

            @if (modalQty > 0 && modalQty < modalLine.OutstandingQuantity)
            {
                <div style="color:#a16207;font-size:12px;margin-bottom:10px;">
                    ⚠️ This is a partial receipt. Remaining outstanding will be @(modalLine.OutstandingQuantity - modalQty).
                </div>
            }
            else if (modalQty > modalLine.OutstandingQuantity)
            {
                <div style="color:#b91c1c;font-size:12px;margin-bottom:10px;">
                    ⛔ Cannot receive more than the outstanding quantity (@modalLine.OutstandingQuantity).
                </div>
            }

            <label style="display:block;font-size:12px;color:#6b7785;margin-bottom:4px;">Notes (optional)</label>
            <textarea class="input full" rows="3"
                      @bind="modalNotes"
                      placeholder="Damaged packaging, short delivery, etc." style="margin-bottom:12px;"></textarea>

            <div style="display:flex;gap:8px;">
                <button class="btn btn-primary"
                        disabled="@(modalQty <= 0 || modalQty > modalLine.OutstandingQuantity)"
                        @onclick="ConfirmReceiveModalAsync">
                    Record receipt
                </button>
                <button class="btn" @onclick="CloseReceiveModal">Cancel</button>
            </div>
        }
    </Modal>

    <!-- ============================================================
         Supplier credit panel — shows any unused credit from prior
         supplier-returns and lets the user apply it against this PO.
         ============================================================ -->
    @if (order.Status != "Cancelled" && order.Status != "Draft" && order.SupplierId.HasValue)
    {
        <div class="card" style="margin-bottom:16px;background:#f0fdf4;border:1px solid #86efac;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <h4 style="margin:0;color:#15803d;">💳 Supplier credit</h4>
                    <p style="margin:4px 0 0;color:#374151;font-size:13px;">
                        Available: <strong>Rs @_availableCredit.ToString("N2")</strong>
                        @if (_appliedCredit > 0)
                        {
                            <span> · Applied to this PO: <strong>Rs @_appliedCredit.ToString("N2")</strong></span>
                        }
                    </p>
                </div>
                @if (_availableCredit > 0)
                {
                    <button class="btn btn-primary" @onclick="OpenApplyCredit">Apply credit</button>
                }
            </div>
            @if (_appliedHistory.Any())
            {
                <table class="table" style="margin-top:10px;font-size:12px;">
                    <thead>
                        <tr><th>Credit note</th><th>Amount</th><th>When</th><th>Notes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _appliedHistory)
                        {
                            <tr>
                                <td style="font-family:monospace;">@a.CreditNoteNumber</td>
                                <td>Rs @a.Amount.ToString("N2")</td>
                                <td>@a.AppliedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                <td style="color:#6b7280;">@(a.Notes ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

<!-- ============================ Apply-credit modal ============================ -->
<Modal Visible="@_showApplyCredit" OnClose="() => _showApplyCredit = false">
    <h3 style="margin-bottom:10px;">Apply supplier credit</h3>
    <p style="color:#6b7280;font-size:13px;margin-top:0;">
        Pick a credit note (oldest shown first) and the amount to apply against this receiving order.
    </p>

    @if (_availableNotes == null || !_availableNotes.Any())
    {
        <p style="color:#9ca3af;">No credit notes available for this supplier.</p>
    }
    else
    {
        <table class="table" style="font-size:13px;">
            <thead>
                <tr><th></th><th>Credit note</th><th>Remaining</th><th>Issued</th></tr>
            </thead>
            <tbody>
                @foreach (var n in _availableNotes)
                {
                    <tr>
                        <td>
                            <input type="radio" name="creditPick"
                                   checked="@(_pickedCreditNoteId == n.Id)"
                                   @onchange="() => PickCredit(n)" />
                        </td>
                        <td style="font-family:monospace;">@n.CreditNoteNumber</td>
                        <td><strong>Rs @n.Remaining.ToString("N2")</strong> / Rs @n.Amount.ToString("N2")</td>
                        <td>@n.IssuedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="display:flex;gap:8px;margin-top:8px;">
            <div style="flex:1;">
                <label style="font-size:12px;color:#6b7280;">Amount to apply (Rs)</label>
                <input class="input full" type="number" min="0" step="0.01"
                       @bind="_applyAmount" />
                @if (_pickedCreditMax > 0)
                {
                    <p style="font-size:11px;color:#6b7280;margin:2px 0;">
                        Max usable: Rs @_pickedCreditMax.ToString("N2")
                        (capped at PO outstanding)
                    </p>
                }
            </div>
        </div>

        <label style="font-size:12px;color:#6b7280;margin-top:6px;display:block;">Notes (optional)</label>
        <input class="input full" @bind="_applyNotes"
               placeholder="e.g. 'Offset against this batch invoice'" style="margin-bottom:12px;" />

        <div style="display:flex;gap:8px;justify-content:flex-end;">
            <button class="btn" @onclick="() => _showApplyCredit = false">Cancel</button>
            <button class="btn btn-primary" disabled="@(_applyAmount <= 0 || !_pickedCreditNoteId.HasValue || _busyApply)"
                    @onclick="ConfirmApply">
                @(_busyApply ? "Applying..." : "Apply")
            </button>
        </div>
    }
</Modal>

    @if (order.Status == "Draft")
    {
        <div class="card">
            <h4 style="margin-top:0;">Add line</h4>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;">
                <div style="flex:2;min-width:240px;">
                    <label style="display:block;font-size:12px;color:#6b7785;margin-bottom:4px;">Variant (SKU)</label>
                    <input class="input full" @bind="lineSearch" @bind:event="oninput"
                           placeholder="Type SKU or product name…" />
                    @if (!string.IsNullOrWhiteSpace(lineSearch) && variants != null)
                    {
                        <div style="border:1px solid #e5e7eb;border-radius:6px;max-height:160px;overflow-y:auto;margin-top:4px;background:#fff;">
                            @foreach (var v in FilteredVariants.Take(15))
                            {
                                <div style="padding:6px 10px;cursor:pointer;border-bottom:1px solid #f3f4f6;"
                                     @onclick="() => PickVariant(v)">
                                    <strong>@v.Sku</strong> <span style="color:#6b7785;">@v.ProductName</span>
                                </div>
                            }
                            @if (!FilteredVariants.Any())
                            {
                                <div style="padding:8px;color:#9ca3af;">No matches.</div>
                            }
                        </div>
                    }
                    @if (newLine.ProductVariantId != Guid.Empty)
                    {
                        <div style="margin-top:4px;font-size:12px;color:#15803d;">
                            ✓ Selected: <strong>@newLine.PickedSku</strong>
                        </div>
                    }
                </div>

                <div>
                    <label style="display:block;font-size:12px;color:#6b7785;margin-bottom:4px;">Expected qty</label>
                    <input class="input" type="number" min="1" style="width:120px;" @bind="newLine.ExpectedQuantity" />
                </div>
                <div>
                    <label style="display:block;font-size:12px;color:#6b7785;margin-bottom:4px;">Unit cost</label>
                    <input class="input" type="number" min="0" step="0.01" style="width:140px;" @bind="newLine.UnitCost" />
                </div>
                <button class="btn btn-primary" @onclick="AddLineAsync">Add line</button>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    OrderDto? order;
    bool isLoading = true;
    string? _error;

    Dictionary<Guid, int> lineQtyInputs = new();

    // ---- Credit panel state ----
    decimal _availableCredit;
    decimal _appliedCredit;
    List<CreditApplicationDto> _appliedHistory = new();
    List<CreditNoteDto>? _availableNotes;

    bool _showApplyCredit;
    bool _busyApply;
    Guid? _pickedCreditNoteId;
    decimal _pickedCreditMax;
    decimal _applyAmount;
    string? _applyNotes;

    // Batch-receive state.
    HashSet<Guid> selectedLineIds = new();

    bool CanReceive => order?.Status == "Open" || order?.Status == "PartiallyReceived";

    bool AllOutstandingSelected
    {
        get
        {
            if (order == null) return false;
            var outstanding = order.Items.Where(i => i.OutstandingQuantity > 0).Select(i => i.Id).ToList();
            return outstanding.Count > 0 && outstanding.All(id => selectedLineIds.Contains(id));
        }
    }

    void ToggleLine(Guid lineId, bool on)
    {
        if (on) selectedLineIds.Add(lineId);
        else selectedLineIds.Remove(lineId);
    }

    void ToggleAllOutstanding(bool on)
    {
        if (order == null) return;
        var outstanding = order.Items.Where(i => i.OutstandingQuantity > 0).Select(i => i.Id);
        if (on)
            foreach (var id in outstanding) selectedLineIds.Add(id);
        else
            foreach (var id in outstanding) selectedLineIds.Remove(id);
    }

    // Per-line receive modal state.
    bool receiveModalOpen = false;
    LineDto? modalLine;
    int modalQty;
    string? modalNotes;

    void OpenReceiveModal(LineDto line)
    {
        modalLine        = line;
        modalQty         = line.OutstandingQuantity;
        modalNotes       = null;
        receiveModalOpen = true;
    }

    void CloseReceiveModal()
    {
        receiveModalOpen = false;
        modalLine        = null;
        modalQty         = 0;
        modalNotes       = null;
    }

    async Task ConfirmReceiveModalAsync()
    {
        if (modalLine == null) return;
        if (modalQty <= 0 || modalQty > modalLine.OutstandingQuantity) return;

        var body = new { receivedQuantity = modalQty, notes = modalNotes };
        var resp = await Http.PostAsJsonAsync(
            $"api/receiving-orders/{Id}/lines/{modalLine.Id}/receive", body);

        if (resp.IsSuccessStatusCode)
        {
            Toast.Show($"Received {modalQty} units. Stock updated.");
            CloseReceiveModal();
            await LoadAsync();
        }
        else
        {
            var msg = await resp.Content.ReadAsStringAsync();
            Toast.Show($"Receive failed: {msg}");
        }
    }

    async Task ReceiveSelectedAsync()
    {
        if (selectedLineIds.Count == 0) return;

        // Build the batch from selected lines using the qty inputs (clamped to outstanding).
        var items = new List<object>();
        foreach (var id in selectedLineIds)
        {
            var line = order?.Items.FirstOrDefault(i => i.Id == id);
            if (line == null || line.OutstandingQuantity <= 0) continue;

            var qty = lineQtyInputs.TryGetValue(id, out var q) ? q : line.OutstandingQuantity;
            qty = Math.Clamp(qty, 1, line.OutstandingQuantity);
            items.Add(new { lineId = id, quantity = qty });
        }

        if (items.Count == 0)
        {
            Toast.Show("No valid lines selected.");
            return;
        }

        var resp = await Http.PostAsJsonAsync(
            $"api/receiving-orders/{Id}/receive-batch", new { items });

        if (resp.IsSuccessStatusCode)
        {
            Toast.Show($"Received {items.Count} line(s). Stock updated.");
            selectedLineIds.Clear();
            await LoadAsync();
        }
        else
        {
            var msg = await resp.Content.ReadAsStringAsync();
            Toast.Show($"Batch receive failed: {msg}");
        }
    }

    // Variant picker for adding lines.
    List<VariantRow>? variants;
    string lineSearch = "";
    NewLine newLine = new();

    IEnumerable<VariantRow> FilteredVariants
        => string.IsNullOrWhiteSpace(lineSearch)
           ? Enumerable.Empty<VariantRow>()
           : (variants ?? new()).Where(v =>
                v.Sku.Contains(lineSearch, StringComparison.OrdinalIgnoreCase)
             || v.ProductName.Contains(lineSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadVariantsAsync();
            await LoadAsync();
        }
    }

    async Task LoadAsync()
    {
        isLoading = true;
        _error = null;
        try
        {
            var json = await Http.GetStringAsync($"api/receiving-orders/{Id}");
            order = ParseOrder(json);

            // Refresh qty input map so we always have an entry for each line.
            lineQtyInputs.Clear();
            if (order != null)
                foreach (var ln in order.Items)
                    lineQtyInputs[ln.Id] = ln.OutstandingQuantity;

            await LoadCreditPanelAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load: {ex.Message}";
        }
        isLoading = false;
        StateHasChanged();
    }

    /// <summary>Load supplier credit available + amounts already applied to this PO.</summary>
    async Task LoadCreditPanelAsync()
    {
        _availableCredit = 0m;
        _appliedCredit   = 0m;
        _appliedHistory  = new();
        _availableNotes  = null;

        if (order == null || !order.SupplierId.HasValue) return;

        // What's already been applied to THIS PO?
        try
        {
            var json = await Http.GetStringAsync(
                $"api/supplier-returns/credit-notes/applications?receivingOrderId={Id}");
            using var doc = JsonDocument.Parse(json);
            var d = doc.RootElement.GetProperty("data");
            _appliedCredit = d.GetProperty("totalApplied").GetDecimal();
            if (d.TryGetProperty("applications", out var apps) && apps.ValueKind == JsonValueKind.Array)
            {
                foreach (var a in apps.EnumerateArray())
                {
                    _appliedHistory.Add(new CreditApplicationDto
                    {
                        Id               = a.GetProperty("id").GetGuid(),
                        CreditNoteNumber = a.TryGetProperty("creditNoteNumber", out var cn) ? (cn.GetString() ?? "") : "",
                        Amount           = a.GetProperty("amount").GetDecimal(),
                        AppliedAt        = a.GetProperty("appliedAt").GetDateTime(),
                        Notes            = a.TryGetProperty("notes", out var nt) && nt.ValueKind == JsonValueKind.String ? nt.GetString() : null
                    });
                }
            }
        }
        catch { /* non-fatal */ }

        // What credit is available across all notes for this supplier (post-application)?
        try
        {
            var json = await Http.GetStringAsync(
                $"api/supplier-returns/credit-notes/available?supplierId={order.SupplierId}");
            using var doc = JsonDocument.Parse(json);
            var d = doc.RootElement.GetProperty("data");
            _availableCredit = d.GetProperty("totalRemaining").GetDecimal();
            _availableNotes = new();
            if (d.TryGetProperty("notes", out var notes) && notes.ValueKind == JsonValueKind.Array)
            {
                foreach (var n in notes.EnumerateArray())
                {
                    _availableNotes.Add(new CreditNoteDto
                    {
                        Id               = n.GetProperty("id").GetGuid(),
                        CreditNoteNumber = n.GetProperty("creditNoteNumber").GetString() ?? "",
                        Amount           = n.GetProperty("amount").GetDecimal(),
                        AppliedAmount    = n.GetProperty("appliedAmount").GetDecimal(),
                        Remaining        = n.GetProperty("remaining").GetDecimal(),
                        IssuedAt         = n.GetProperty("issuedAt").GetDateTime()
                    });
                }
            }
        }
        catch { /* non-fatal */ }
    }

    void OpenApplyCredit()
    {
        _pickedCreditNoteId = null;
        _pickedCreditMax    = 0;
        _applyAmount        = 0;
        _applyNotes         = null;
        _showApplyCredit    = true;
    }

    void PickCredit(CreditNoteDto n)
    {
        _pickedCreditNoteId = n.Id;
        // Cap at the smaller of (credit remaining, PO net payable).
        var poPayable = Math.Max(0m, (order?.ReceivedTotal ?? 0m) - _appliedCredit);
        _pickedCreditMax = Math.Min(n.Remaining, poPayable);
        _applyAmount     = _pickedCreditMax;
    }

    async Task ConfirmApply()
    {
        if (!_pickedCreditNoteId.HasValue || _applyAmount <= 0) return;
        if (_pickedCreditMax > 0 && _applyAmount > _pickedCreditMax)
        {
            Toast.Show($"Amount exceeds max usable (Rs {_pickedCreditMax:N2}).");
            return;
        }

        _busyApply = true;
        try
        {
            var body = new
            {
                receivingOrderId = Id,
                amount           = _applyAmount,
                notes            = string.IsNullOrWhiteSpace(_applyNotes) ? null : _applyNotes
            };
            var resp = await Http.PostAsJsonAsync(
                $"api/supplier-returns/credit-notes/{_pickedCreditNoteId}/apply", body);
            if (!resp.IsSuccessStatusCode)
            {
                Toast.Show($"Apply failed: {await resp.Content.ReadAsStringAsync()}");
                return;
            }
            Toast.Show($"Applied Rs {_applyAmount:N2} of credit.");
            _showApplyCredit = false;
            await LoadCreditPanelAsync();
        }
        finally { _busyApply = false; }
    }

    async Task LoadVariantsAsync()
    {
        try
        {
            var json = await Http.GetStringAsync("api/receiving-orders/variants");
            variants = new List<VariantRow>();
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("items", out var items)
                && items.ValueKind == JsonValueKind.Array)
            {
                foreach (var e in items.EnumerateArray())
                {
                    variants.Add(new VariantRow
                    {
                        Id          = e.TryGetProperty("id",          out var id) ? id.GetGuid()       : Guid.Empty,
                        ProductName = e.TryGetProperty("productName", out var pn) ? (pn.GetString() ?? "") : "",
                        Sku         = e.TryGetProperty("sku",         out var sk) ? (sk.GetString() ?? "") : "",
                        AverageCost = e.TryGetProperty("averageCost", out var ac) ? ac.GetDecimal() : 0m
                    });
                }
            }
        }
        catch (Exception ex)
        {
            variants = new();
            Toast.Show($"Could not load variants: {ex.Message}");
        }
    }

    void PickVariant(VariantRow v)
    {
        newLine.ProductVariantId = v.Id;
        newLine.PickedSku        = v.Sku;
        if (newLine.UnitCost <= 0 && v.AverageCost > 0)
            newLine.UnitCost = v.AverageCost;
        lineSearch = "";
    }

    async Task AddLineAsync()
    {
        if (newLine.ProductVariantId == Guid.Empty)
        {
            Toast.Show("Pick a variant first.");
            return;
        }
        if (newLine.ExpectedQuantity <= 0)
        {
            Toast.Show("Expected quantity must be > 0.");
            return;
        }

        var body = new
        {
            productVariantId = newLine.ProductVariantId,
            expectedQuantity = newLine.ExpectedQuantity,
            unitCost         = newLine.UnitCost
        };
        var resp = await Http.PostAsJsonAsync($"api/receiving-orders/{Id}/lines", body);
        if (resp.IsSuccessStatusCode)
        {
            Toast.Show("Line added.");
            newLine = new NewLine();
            await LoadAsync();
        }
        else
        {
            Toast.Show($"Failed to add line: {await ReadApiMessageAsync(resp)}");
        }
    }

    async Task RemoveLineAsync(Guid lineId)
    {
        var resp = await Http.DeleteAsync($"api/receiving-orders/{Id}/lines/{lineId}");
        if (resp.IsSuccessStatusCode)
        {
            Toast.Show("Line removed.");
            await LoadAsync();
        }
        else
        {
            Toast.Show("Failed to remove line.");
        }
    }

    async Task SubmitAsync()
    {
        var resp = await Http.PostAsync($"api/receiving-orders/{Id}/submit", null);
        if (resp.IsSuccessStatusCode) { Toast.Show("Submitted. Now record receipts as goods arrive."); await LoadAsync(); }
        else Toast.Show("Submit failed.");
    }

    async Task CancelAsync()
    {
        var resp = await Http.PostAsync($"api/receiving-orders/{Id}/cancel", null);
        if (resp.IsSuccessStatusCode) { Toast.Show("Cancelled."); await LoadAsync(); }
        else Toast.Show("Cancel failed.");
    }

    async Task CloseAsync()
    {
        var resp = await Http.PostAsync($"api/receiving-orders/{Id}/close", null);
        if (resp.IsSuccessStatusCode) { Toast.Show("Closed."); await LoadAsync(); }
        else Toast.Show("Close failed.");
    }

    async Task ReceiveLineAsync(Guid lineId)
    {
        var qty = lineQtyInputs.TryGetValue(lineId, out var q) ? q : 0;
        if (qty <= 0)
        {
            Toast.Show("Quantity must be > 0.");
            return;
        }

        var body = new { receivedQuantity = qty };
        var resp = await Http.PostAsJsonAsync(
            $"api/receiving-orders/{Id}/lines/{lineId}/receive", body);
        if (resp.IsSuccessStatusCode)
        {
            Toast.Show($"Received {qty} units. Stock updated.");
            await LoadAsync();
        }
        else
        {
            var body2 = await resp.Content.ReadAsStringAsync();
            Toast.Show($"Receive failed: {body2}");
        }
    }

    static string StatusBadge(string status)
    {
        var (bg, fg) = status switch
        {
            "Draft"             => ("#e5e7eb", "#374151"),
            "Open"              => ("#dbeafe", "#1d4ed8"),
            "PartiallyReceived" => ("#fef3c7", "#a16207"),
            "Closed"            => ("#dcfce7", "#15803d"),
            "Cancelled"         => ("#fee2e2", "#b91c1c"),
            _                   => ("#e5e7eb", "#374151")
        };
        return $"<span style=\"background:{bg};color:{fg};font-size:11px;padding:2px 8px;border-radius:4px;font-weight:600;\">{status}</span>";
    }

    static async Task<string> ReadApiMessageAsync(HttpResponseMessage response)
    {
        var raw = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(raw))
            return $"{(int)response.StatusCode} {response.ReasonPhrase}";

        try
        {
            using var doc = JsonDocument.Parse(raw);
            var root = doc.RootElement;
            if (root.TryGetProperty("message", out var message)
                && message.ValueKind == JsonValueKind.String
                && !string.IsNullOrWhiteSpace(message.GetString()))
            {
                return message.GetString()!;
            }
            if (root.TryGetProperty("error", out var error)
                && error.ValueKind == JsonValueKind.String
                && !string.IsNullOrWhiteSpace(error.GetString()))
            {
                return error.GetString()!;
            }
        }
        catch { /* Response was not JSON; fall back to raw body. */ }

        return raw;
    }

    static OrderDto? ParseOrder(string json)
    {
        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;
        var data = root.TryGetProperty("data", out var d) ? d : root;
        if (data.ValueKind != JsonValueKind.Object) return null;

        var o = new OrderDto
        {
            Id                = data.TryGetProperty("id",                out var id) ? id.GetGuid()       : Guid.Empty,
            OrderNumber       = data.TryGetProperty("orderNumber",       out var on) ? (on.GetString() ?? "") : "",
            Status            = data.TryGetProperty("status",            out var st) ? (st.GetString() ?? "") : "",
            SupplierId        = data.TryGetProperty("supplierId",        out var sid) && sid.ValueKind == JsonValueKind.String ? sid.GetGuid() : (Guid?)null,
            SupplierReference = data.TryGetProperty("supplierReference", out var sr) ? sr.GetString()   : null,
            ExpectedTotal     = data.TryGetProperty("expectedTotal",     out var et) ? et.GetDecimal() : 0m,
            ReceivedTotal     = data.TryGetProperty("receivedTotal",     out var rt) ? rt.GetDecimal() : 0m
        };

        if (data.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array)
        {
            foreach (var ln in items.EnumerateArray())
            {
                o.Items.Add(new LineDto
                {
                    Id                  = ln.TryGetProperty("id",                  out var lid) ? lid.GetGuid()      : Guid.Empty,
                    Sku                 = ln.TryGetProperty("sku",                 out var sk)  ? (sk.GetString() ?? "") : "",
                    ExpectedQuantity    = ln.TryGetProperty("expectedQuantity",    out var eq)  ? eq.GetInt32()  : 0,
                    ReceivedQuantity    = ln.TryGetProperty("receivedQuantity",    out var rq)  ? rq.GetInt32()  : 0,
                    OutstandingQuantity = ln.TryGetProperty("outstandingQuantity", out var oq)  ? oq.GetInt32()  : 0,
                    UnitCost            = ln.TryGetProperty("unitCost",            out var uc)  ? uc.GetDecimal(): 0m,
                    Status              = ln.TryGetProperty("status",              out var lst) ? (lst.GetString() ?? "") : ""
                });
            }
        }
        return o;
    }


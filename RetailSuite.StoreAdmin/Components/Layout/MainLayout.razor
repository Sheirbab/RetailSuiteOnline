@inherits LayoutComponentBase

@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<Toast />

@if (!_checked)
{
    <!-- Still reading localStorage — show nothing to avoid flash -->
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#f9fafb;">
        <div class="spinner"></div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <!-- Will redirect immediately in OnAfterRenderAsync -->
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#f9fafb;">
        <p style="color:#9ca3af;">Redirecting to login...</p>
    </div>
}
else
{
    <div class="layout">

        <!-- Mobile sidebar backdrop -->
        <div class="sidebar-backdrop @( _sidebarOpen ? "open" : "")" @onclick="() => _sidebarOpen = false"></div>

        <!-- Sidebar -->
        <div class="sidebar @( _sidebarOpen ? "open" : "")" @onclick="OnSidebarClick">
            <h2>RetailSuite</h2>

            @if (Auth.IsSuperAdmin)
            {
                <span style="font-size:11px;text-transform:uppercase;color:#9ca3af;letter-spacing:.05em;margin:8px 0 4px;display:block;">Platform</span>
                <NavLink href="/admin/tenants" style="color:#fbbf24;">🏢 Tenant Management</NavLink>
                <hr style="border:none;border-top:1px solid #374151;margin:12px 0;" />
            }
            else
            {
                <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>

                @if (Auth.Can("POS"))             { <NavLink href="/pos">POS Terminal</NavLink> }
                @if (Auth.Can("PRODUCTS"))        { <NavLink href="/products">Products</NavLink> }
                @if (Auth.Can("INVENTORY_VIEW"))  { <NavLink href="/inventory">Inventory</NavLink> }
                @if (Auth.Can("INVENTORY_TRANSFER")) { <NavLink href="/inventory/transfers">Stock transfers</NavLink> }
                @if (Auth.Can("ORDERS_VIEW"))     { <NavLink href="/orders">Orders</NavLink> }
                @if (Auth.Can("CUSTOMERS"))       { <NavLink href="/customers">Customers</NavLink> }

                @if (Auth.Can("SUPPLIERS") || Auth.Can("RECEIVING_ORDERS")
                  || Auth.Can("BULK_RECEIVE") || Auth.Can("SUPPLIER_RETURNS"))
                {
                    <span style="font-size:11px;text-transform:uppercase;color:#9ca3af;letter-spacing:.05em;margin:12px 0 4px;display:block;">Procurement</span>
                    @if (Auth.Can("SUPPLIERS"))        { <NavLink href="/suppliers">Suppliers</NavLink> }
                    @if (Auth.Can("RECEIVING_ORDERS")) { <NavLink href="/receiving-orders">Receiving orders</NavLink> }
                    @if (Auth.Can("BULK_RECEIVE"))     { <NavLink href="/inventory/bulk-receive">Bulk receive</NavLink> }
                    @if (Auth.Can("SUPPLIER_RETURNS")) { <NavLink href="/supplier-returns">Supplier returns</NavLink> }
                }

                @if (Auth.Can("BARCODES"))
                {
                    <span style="font-size:11px;text-transform:uppercase;color:#9ca3af;letter-spacing:.05em;margin:12px 0 4px;display:block;">Labels</span>
                    <NavLink href="/barcodes/print">Print barcodes</NavLink>
                }

                @if (Auth.Can("REPORTS"))
                {
                    <span style="font-size:11px;text-transform:uppercase;color:#9ca3af;letter-spacing:.05em;margin:12px 0 4px;display:block;">Reports</span>
                    <NavLink href="/reports">Sales &amp; inventory reports</NavLink>
                }

                @if (Auth.Can("LOCATIONS") || Auth.Can("SHIPPING") || Auth.Can("TAX_SETTINGS")
                  || Auth.Can("SUBSCRIPTION") || Auth.Can("CATEGORIES") || Auth.Can("BRANDS")
                  || Auth.Can("ATTRIBUTES") || Auth.IsAdmin)
                {
                    <span style="font-size:11px;text-transform:uppercase;color:#9ca3af;letter-spacing:.05em;margin:12px 0 4px;display:block;">Settings</span>
                    @if (Auth.Can("CATEGORIES"))   { <NavLink href="/settings/categories">Categories</NavLink> }
                    @if (Auth.Can("BRANDS"))       { <NavLink href="/settings/brands">Brands</NavLink> }
                    @if (Auth.Can("ATTRIBUTES"))   { <NavLink href="/settings/attributes">Attributes</NavLink> }
                    @if (Auth.Can("LOCATIONS"))    { <NavLink href="/locations">Locations</NavLink> }
                    @if (Auth.Can("SHIPPING"))     { <NavLink href="/settings/shipping-methods">Shipping methods</NavLink> }
                    @if (Auth.Can("TAX_SETTINGS")) { <NavLink href="/settings/tax">Tax & FBR</NavLink> }
                    @if (Auth.Can("SUBSCRIPTION")) { <NavLink href="/settings/subscription">Subscription</NavLink> }
                    @if (Auth.IsAdmin)             { <NavLink href="/settings/users">Users & permissions</NavLink> }
                }

                <hr style="border:none;border-top:1px solid #374151;margin:12px 0;" />
                <NavLink href="/shop" style="color:#6ee7b7;">🛍 Storefront</NavLink>
            }
        </div>

        <!-- Main -->
        <div class="main">

            <!-- Header -->
            <div class="header">
                <button class="header-burger" @onclick="() => _sidebarOpen = !_sidebarOpen" title="Menu">
                    ☰
                </button>

                @if (Auth.IsSuperAdmin)
                {
                    <span style="font-weight:600;color:#d97706;flex:1;">⭐ Super Admin Portal</span>
                }
                else
                {
                    <span style="font-weight:500;color:#374151;flex:1;">Admin Panel</span>
                }

                <button class="btn btn-danger" @onclick="LogoutAsync">
                    Logout
                </button>
            </div>

            <!-- Content -->
            <div class="content">
                @Body
            </div>

            <!-- Footer -->
            <div class="footer">
                © 2026 RetailSuite
            </div>

        </div>
    </div>
}

@code {
    private bool _checked;
    private bool _sidebarOpen;  // mobile drawer state

    /// <summary>
    /// On mobile, tapping a NavLink inside the open sidebar should close the drawer.
    /// We can't easily intercept individual NavLink clicks, so the easiest is to close
    /// whenever any click bubbles up from the sidebar — except the sidebar itself is
    /// only "open" on mobile, so on desktop this is a no-op.
    /// </summary>
    private void OnSidebarClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Best-effort: close on click for the mobile-open state.
        if (_sidebarOpen) _sidebarOpen = false;
    }

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Restore token from localStorage — JS is available at this point
        await Auth.InitializeAsync();

        _checked = true;

        if (!Auth.IsAuthenticated)
            Nav.NavigateTo("/login", replace: true);

        StateHasChanged();
    }

    async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }
}

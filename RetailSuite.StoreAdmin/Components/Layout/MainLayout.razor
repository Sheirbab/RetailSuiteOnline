@inherits LayoutComponentBase

@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<Toast />

@if (!_checked)
{
    <!-- Still reading localStorage — show nothing to avoid flash -->
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#f9fafb;">
        <div class="spinner"></div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <!-- Will redirect immediately in OnAfterRenderAsync -->
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#f9fafb;">
        <p style="color:#9ca3af;">Redirecting to login...</p>
    </div>
}
else
{
    <div class="layout">

        <!-- Sidebar -->
        <div class="sidebar">
            <h2>RetailSuite</h2>

            @if (Auth.IsSuperAdmin)
            {
                <span style="font-size:11px;text-transform:uppercase;color:#9ca3af;letter-spacing:.05em;margin:8px 0 4px;display:block;">Platform</span>
                <NavLink href="/admin/tenants" style="color:#fbbf24;">🏢 Tenant Management</NavLink>
                <hr style="border:none;border-top:1px solid #374151;margin:12px 0;" />
            }
            else
            {
                <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink href="/pos">POS Terminal</NavLink>
                <NavLink href="/products">Products</NavLink>
                <NavLink href="/inventory">Inventory</NavLink>
                <NavLink href="/orders">Orders</NavLink>
                <NavLink href="/customers">Customers</NavLink>
                <hr style="border:none;border-top:1px solid #374151;margin:12px 0;" />
                <NavLink href="/shop" style="color:#6ee7b7;">🛍 Storefront</NavLink>
            }
        </div>

        <!-- Main -->
        <div class="main">

            <!-- Header -->
            <div class="header">
                @if (Auth.IsSuperAdmin)
                {
                    <span style="font-weight:600;color:#d97706;">⭐ Super Admin Portal</span>
                }
                else
                {
                    <span style="font-weight:500;color:#374151;">Admin Panel</span>
                }

                <button class="btn btn-danger" @onclick="LogoutAsync">
                    Logout
                </button>
            </div>

            <!-- Content -->
            <div class="content">
                @Body
            </div>

            <!-- Footer -->
            <div class="footer">
                © 2026 RetailSuite
            </div>

        </div>
    </div>
}

@code {
    private bool _checked;

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Restore token from localStorage — JS is available at this point
        await Auth.InitializeAsync();

        _checked = true;

        if (!Auth.IsAuthenticated)
            Nav.NavigateTo("/login", replace: true);

        StateHasChanged();
    }

    async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }
}

@inherits LayoutComponentBase

@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<Toast />

@if (!_checked)
{
    <p>Loading...</p>
}
else if (!Auth.IsAuthenticated)
{
    <p>Redirecting...</p>
}
else
{
    <div class="layout">

        <!-- Sidebar -->
        <div class="sidebar">
            <h2>RetailSuite</h2>

            <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/products">
                <i class="lucide lucide-box"></i>Products
            </NavLink>
            <NavLink href="/inventory">
                <i class="lucide lucide-box"></i>Inventory
            </NavLink>
            <NavLink href="/orders">
                <i class="lucide lucide-box"></i>Orders
            </NavLink>
            <NavLink href="/customers">
                <i class="lucide lucide-box"></i>Customers
            </NavLink>
            <NavLink href="/payments">
                <i class="lucide lucide-box"></i>Payments
            </NavLink>
            <NavLink href="/pos">
                <i class="lucide lucide-box"></i>POS
            </NavLink>
        </div>

        <!-- Main -->
        <div class="main">

            <!-- Header -->
            <div class="header">
                <span>Admin Panel</span>

                <button class="btn btn-danger" @onclick="Logout">
                    <i class="lucide lucide-log-out"></i> Logout
                </button>
            </div>

            <!-- Content -->
            <div class="content">
                @Body
            </div>

            <!-- Footer -->
            <div class="footer">
                © 2026 RetailSuite
            </div>

        </div>
    </div>
}


@code {
    private bool _checked;

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _checked = true;

            if (!Auth.IsAuthenticated)
            {
                Nav.NavigateTo("/login", true);
            }

            StateHasChanged();
        }
    }

    void Logout()
    {
        Auth.Logout();
        Nav.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }
}
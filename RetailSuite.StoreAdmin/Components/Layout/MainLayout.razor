@inherits LayoutComponentBase

@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<Toast />

@if (!_checked)
{
    <p style="padding:20px;color:#9ca3af;">Loading...</p>
}
else if (!Auth.IsAuthenticated)
{
    <p style="padding:20px;color:#9ca3af;">Redirecting to login...</p>
}
else
{
    <div class="layout">

        <!-- Sidebar -->
        <div class="sidebar">
            <h2>RetailSuite</h2>

            <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/pos">POS Terminal</NavLink>
            <NavLink href="/products">Products</NavLink>
            <NavLink href="/inventory">Inventory</NavLink>
            <NavLink href="/orders">Orders</NavLink>
            <NavLink href="/customers">Customers</NavLink>
        </div>

        <!-- Main -->
        <div class="main">

            <!-- Header -->
            <div class="header">
                <span style="font-weight:500;color:#374151;">Admin Panel</span>

                <button class="btn btn-danger" @onclick="Logout">
                    Logout
                </button>
            </div>

            <!-- Content -->
            <div class="content">
                @Body
            </div>

            <!-- Footer -->
            <div class="footer">
                © 2026 RetailSuite
            </div>

        </div>
    </div>
}

@code {
    private bool _checked;

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _checked = true;

            if (!Auth.IsAuthenticated)
                Nav.NavigateTo("/login", true);

            StateHasChanged();
        }
    }

    void Logout()
    {
        Auth.Logout();
        Nav.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }
}

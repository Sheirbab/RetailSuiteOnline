@inherits LayoutComponentBase
@inject CartService Cart
@inject StorefrontContext Store
@inject NavigationManager Nav
@inject AuthService Auth
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Text.Json
@using System.Net.Http.Headers
@implements IDisposable

<div class="shop-layout">
    <header class="shop-header">
        <div class="shop-header-inner">
            <a href="@StorePath("")" class="shop-brand">
                <span class="shop-brand-mark">@BrandInitial</span>
                <span>@(_storeName ?? "RetailSuite Store")</span>
            </a>
            <nav class="shop-nav">
                <a class="@ActiveClass("")" href="@StorePath("")">Shop</a>
                <a class="@ActiveClass("track")" href="@StorePath("track")">Track order</a>
                <a href="@StorePath("wallet")" class="wallet-link">
                    Wallet
                    @if (_walletBalance.HasValue && _walletBalance.Value > 0)
                    {
                        <span class="wallet-balance">Rs @_walletBalance.Value.ToString("N0")</span>
                    }
                </a>
                <a href="@StorePath("cart")" class="cart-link">
                    Cart
                    @if (Cart.TotalCount > 0)
                    {
                        <span class="cart-badge">@Cart.TotalCount</span>
                    }
                </a>
            </nav>
        </div>

        <!-- Mobile-only icon header: hamburger opens the nav drawer below,
             search jumps to the shop's search box, account goes to Wallet
             (the closest thing to a customer account page). -->
        <div class="shop-header-mobile">
            <button type="button" class="shop-icon-btn" aria-label="Menu" @onclick="() => _drawerOpen = true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
            </button>
            <a class="shop-icon-btn" aria-label="Search" href="@StorePath("")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            </a>
            <a href="@StorePath("")" class="shop-brand-mobile">
                <span>@(_storeName ?? "RetailSuite Store")</span>
            </a>
            <a class="shop-icon-btn" aria-label="Account" href="@StorePath("wallet")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 3.5-7 8-7s8 3 8 7" /></svg>
            </a>
            <a class="shop-icon-btn cart-icon-btn" aria-label="Cart" href="@StorePath("cart")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8V6a6 6 0 0112 0v2" /><rect x="3" y="8" width="18" height="13" rx="2" /></svg>
                @if (Cart.TotalCount > 0)
                {
                    <span class="cart-badge-dot">@Cart.TotalCount</span>
                }
            </a>
        </div>
    </header>

    <div class="shop-drawer-backdrop @(_drawerOpen ? "open" : "")" @onclick="() => _drawerOpen = false"></div>
    <nav class="shop-drawer @(_drawerOpen ? "open" : "")">
        <div class="shop-drawer-head">
            <span>Menu</span>
            <button type="button" class="shop-icon-btn" aria-label="Close menu" @onclick="() => _drawerOpen = false">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>
        <a class="@ActiveClass("")" href="@StorePath("")" @onclick="() => _drawerOpen = false">Shop</a>
        <a class="@ActiveClass("track")" href="@StorePath("track")" @onclick="() => _drawerOpen = false">Track order</a>
        <a class="@ActiveClass("wallet")" href="@StorePath("wallet")" @onclick="() => _drawerOpen = false">
            Wallet
            @if (_walletBalance.HasValue && _walletBalance.Value > 0)
            {
                <span class="wallet-balance">Rs @_walletBalance.Value.ToString("N0")</span>
            }
        </a>
        <a class="@ActiveClass("cart")" href="@StorePath("cart")" @onclick="() => _drawerOpen = false">
            Cart
            @if (Cart.TotalCount > 0)
            {
                <span class="cart-badge">@Cart.TotalCount</span>
            }
        </a>
    </nav>

    <main class="shop-main">
        @Body
    </main>

    <nav class="shop-bottom-nav">
        <a class="@ActiveClass("")" href="@StorePath("")">
            <span>Shop</span>
        </a>
        <a class="@ActiveClass("track")" href="@StorePath("track")">
            <span>Track</span>
        </a>
        <a class="@ActiveClass("wallet")" href="@StorePath("wallet")">
            <span>Wallet</span>
        </a>
        <a class="@ActiveClass("cart")" href="@StorePath("cart")">
            <span>Cart</span>
            @if (Cart.TotalCount > 0)
            {
                <strong>@Cart.TotalCount</strong>
            }
        </a>
    </nav>

    <footer class="shop-footer">
        © @DateTime.Now.Year RetailSuite
    </footer>
</div>

@code {
    const string WALLET_TOKEN_KEY = "wallet_token";
    decimal? _walletBalance;
    bool _drawerOpen;
    string? _storeName;
    string? _storeNameLoadedForSlug;

    string BrandInitial => string.IsNullOrEmpty(_storeName) ? "R" : _storeName.Trim()[0].ToString().ToUpperInvariant();

    string StorePath(string relative) =>
        string.IsNullOrEmpty(relative) ? $"/store/{Store.TenantSlug}" : $"/store/{Store.TenantSlug}/{relative}";

    string ActiveClass(string relative)
    {
        var target = Nav.ToAbsoluteUri(StorePath(relative)).AbsolutePath.TrimEnd('/');
        var current = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return string.Equals(target, current, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    protected override void OnInitialized()
    {
        Cart.OnChange += StateHasChanged;
        Store.OnChange += OnStoreChanged;
    }

    void OnStoreChanged()
    {
        StateHasChanged();
        _ = TryLoadStoreNameAsync();
    }

    // Restore the Bearer token from localStorage so shop-page API calls succeed.
    // Child pages use OnAfterRenderAsync(firstRender) so this fires first.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Auth.InitializeAsync();
        await TryLoadWalletBalanceAsync();
        await TryLoadStoreNameAsync();
    }

    async Task TryLoadStoreNameAsync()
    {
        var slug = Store.TenantSlug;
        if (string.IsNullOrWhiteSpace(slug) || slug == _storeNameLoadedForSlug) return;
        try
        {
            var json = await Http.GetStringAsync($"api/shop/{slug}/store-info");
            using var doc = JsonDocument.Parse(json);
            _storeName = doc.RootElement.GetProperty("data").GetProperty("name").GetString();
            _storeNameLoadedForSlug = slug;
            StateHasChanged();
        }
        catch { /* best-effort — falls back to the generic brand text */ }
    }

    async Task TryLoadWalletBalanceAsync()
    {
        try
        {
            var t = await JS.InvokeAsync<string?>("localStorage.getItem", WALLET_TOKEN_KEY);
            if (string.IsNullOrEmpty(t)) return;

            using var req = new HttpRequestMessage(HttpMethod.Get, "api/wallet/me");
            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", t);
            var resp = await Http.SendAsync(req);
            if (!resp.IsSuccessStatusCode) return;

            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            _walletBalance = doc.RootElement.GetProperty("data")
                .GetProperty("balances").GetProperty("storeCredit").GetDecimal();
            StateHasChanged();
        }
        catch { /* best-effort — chip just doesn't render */ }
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
        Store.OnChange -= OnStoreChanged;
    }
}

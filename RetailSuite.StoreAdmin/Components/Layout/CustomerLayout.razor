@inherits LayoutComponentBase
@inject CartService Cart
@inject NavigationManager Nav
@inject AuthService Auth
@implements IDisposable

<div class="shop-layout">
    <header class="shop-header">
        <div class="shop-header-inner">
            <a href="/shop" class="shop-brand">🛍 RetailSuite Store</a>
            <nav class="shop-nav">
                <a href="/shop">Shop</a>
                <a href="/shop/track">Track order</a>
                <a href="/cart" class="cart-link">
                    🛒 Cart
                    @if (Cart.TotalCount > 0)
                    {
                        <span class="cart-badge">@Cart.TotalCount</span>
                    }
                </a>
            </nav>
        </div>
    </header>

    <main class="shop-main">
        @Body
    </main>

    <footer class="footer" style="margin-top:40px;">
        <span>© @DateTime.Now.Year RetailSuite</span>
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        Cart.OnChange += StateHasChanged;
    }

    // Restore the Bearer token from localStorage so shop-page API calls succeed.
    // Child pages use OnAfterRenderAsync(firstRender) so this fires first.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Auth.InitializeAsync();
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
    }
}
